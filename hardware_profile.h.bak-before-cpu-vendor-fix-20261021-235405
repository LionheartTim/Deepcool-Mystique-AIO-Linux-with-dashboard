#pragma once
// MYSTIQUE STEP 5A - Hardware ID only. Does NOT read telemetry and never sends USB.
// Vendor readers will be attached in independent later steps. Do not cache hwmonN.
#include <QDir>
#include <QFile>
#include <QSettings>
#include <QString>
#include <QStringList>
#include <QDebug>
#include <algorithm>

namespace MystiqueMetrics {

struct HardwareProfile {
    QString cpuVendor;      // amd, intel, unknown
    QString cpuModel;
    QString gpuVendor;      // amd, nvidia, intel, mixed, unknown
    QStringList pciGpus;
    bool cached = false;
};

inline QString readIdentityFile(const QString& path) {
    QFile file(path);
    if (!file.open(QIODevice::ReadOnly | QIODevice::Text)) return {};
    return QString::fromUtf8(file.readAll()).trimmed();
}

inline QString cpuIdentifier(const QString& field) {
    QFile file(QStringLiteral("/proc/cpuinfo"));
    if (!file.open(QIODevice::ReadOnly | QIODevice::Text)) return {};
    while (!file.atEnd()) {
        const QByteArray line = file.readLine();
        const int colon = line.indexOf(':');
        if (colon < 0) continue;
        if (QString::fromUtf8(line.left(colon)).trimmed() == field)
            return QString::fromUtf8(line.mid(colon + 1)).trimmed();
    }
    return {};
}

inline QString cpuType(const QString& vendorId) {
    if (vendorId == QStringLiteral("AuthenticAMD")) return QStringLiteral("amd");
    if (vendorId == QStringLiteral("GenuineIntel")) return QStringLiteral("intel");
    return QStringLiteral("unknown");
}

inline QString gpuType(const QString& vendorId) {
    const QString id = vendorId.toLower();
    if (id == QStringLiteral("0x1002")) return QStringLiteral("amd");
    if (id == QStringLiteral("0x10de")) return QStringLiteral("nvidia");
    if (id == QStringLiteral("0x8086")) return QStringLiteral("intel");
    return QStringLiteral("unknown");
}

// This cheap PCI identity check can validate a cached vendor decision even if
// /sys/class/drm/cardN numbering changes. No nvidia-smi or sensor scanning here.
inline HardwareProfile loadHardwareProfile() {
    HardwareProfile profile;
    const QString vendorId = cpuIdentifier(QStringLiteral("vendor_id"));
    const QString model = cpuIdentifier(QStringLiteral("model name"));
    profile.cpuVendor = cpuType(vendorId);
    profile.cpuModel = model;

    QStringList deviceIdentities;
    QStringList vendorTypes;
    for (int i = 0; i < 32; ++i) {
        const QString base = QStringLiteral("/sys/class/drm/card%1/device/").arg(i);
        const QString vendor = readIdentityFile(base + QStringLiteral("vendor"));
        const QString device = readIdentityFile(base + QStringLiteral("device"));
        if (vendor.isEmpty() || device.isEmpty()) continue;
        // Exclude duplicate device records, but do not choose a specific GPU
        // when a machine has a mixture of different GPU vendors.
        const QString id = vendor.toLower() + QStringLiteral(":") + device.toLower();
        deviceIdentities.append(id);
        vendorTypes.append(gpuType(vendor));
    }
    std::sort(deviceIdentities.begin(), deviceIdentities.end());
    deviceIdentities.removeDuplicates();
    vendorTypes.removeDuplicates();
    profile.pciGpus = deviceIdentities;
    profile.gpuVendor = vendorTypes.isEmpty() ? QStringLiteral("unknown") :
        (vendorTypes.size() == 1 ? vendorTypes.first() : QStringLiteral("mixed"));

    // VERSIONED storage; never cache volatile /sys/class/hwmon/hwmonN paths.
    const QString identity = vendorId + QLatin1Char('|') + model +
        QLatin1Char('|') + deviceIdentities.join(QLatin1Char(';'));
    QSettings settings(QStringLiteral("LionheartTim"), QStringLiteral("DeepCoolDigitalGui"));
    constexpr int schema = 1;
    const bool valid = settings.value(QStringLiteral("metricsProfile/schema"), 0).toInt() == schema &&
        settings.value(QStringLiteral("metricsProfile/hardwareIdentity")).toString() == identity &&
        settings.contains(QStringLiteral("metricsProfile/cpuVendor")) &&
        settings.contains(QStringLiteral("metricsProfile/gpuVendor"));
    if (valid) {
        profile.cpuVendor = settings.value(QStringLiteral("metricsProfile/cpuVendor")).toString();
        profile.gpuVendor = settings.value(QStringLiteral("metricsProfile/gpuVendor")).toString();
        profile.cached = true;
    } else {
        settings.setValue(QStringLiteral("metricsProfile/schema"), schema);
        settings.setValue(QStringLiteral("metricsProfile/hardwareIdentity"), identity);
        settings.setValue(QStringLiteral("metricsProfile/cpuVendor"), profile.cpuVendor);
        settings.setValue(QStringLiteral("metricsProfile/gpuVendor"), profile.gpuVendor);
        settings.setValue(QStringLiteral("metricsProfile/cpuModel"), profile.cpuModel);
        settings.setValue(QStringLiteral("metricsProfile/pciGpus"), profile.pciGpus);
        settings.sync();
        if (settings.status() != QSettings::NoError)
            qWarning() << "[METRICS-PROFILE] Cannot save hardware profile";
    }
    return profile;
}

} // namespace MystiqueMetrics
