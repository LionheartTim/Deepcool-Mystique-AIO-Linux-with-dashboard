struct GifSlot {
    QString path;
    bool isSelected = false;
    bool uploadedToHardware = false;
    int hardwareListIndex = -1;
    int currentFrame = 0;
    int totalFrames = 0;
    double frameTimer = 0.0;
    float zoom = 1.0f;
    float offsetX = 0.0f;
    float offsetY = 0.0f;
    QImage preview;

    // 🆕 Frame-cache — alleen geladen als de GIF daadwerkelijk getoond wordt
    QVector<QImage> cachedFrames;
    bool framesLoaded = false;
    int previewBaseRotation = -1;
};

static std::array<GifSlot, GIF_SLOT_COUNT> gifSlots;

// GUI-only rotation: never modify stored JPEG or USB data.
static QImage gifFrameForPreview(int slot, const QImage& frame)
{
    if (slot < 0 || slot >= GIF_SLOT_COUNT || frame.isNull())
        return frame;

    const int savedRotation = gifSlots[slot].previewBaseRotation;

    if (savedRotation < 0 || savedRotation > 3)
        return frame;

    const int steps =
        (currentRotationIndex - savedRotation + 4) % 4;

    if (steps == 0)
        return frame;

    const int degrees = steps == 3 ? -90 : steps * 90;

    return frame.transformed(
        QTransform().rotate(degrees),
        Qt::SmoothTransformation
    );
}

static QString homeDir()
{
    return QDir::homePath();
}

static QString slotDir(int slot)
{
    return homeDir() + "/.local/share/LionheartTim/DeepCoolDigitalGui/dc_slot_" + QString::number(slot) + "/gif_source";
}

static QString rawGifPath(int slot) { return slotDir(slot) + "/raw_source.gif"; }
static QString uploadFlagPath(int slot) { return slotDir(slot) + "/upload_complete.flag"; }
static QString cropFlagPath(int slot) { return slotDir(slot) + "/crop_complete.flag"; }

static QString uploadUncertainFlagPath(int slot)
{
    return slotDir(slot) + "/upload_state_unknown.flag";
}

static QString deleteUncertainFlagPath(int slot)
{
    return slotDir(slot) + "/delete_state_unknown.flag";
}



static bool uploadedGifMetadataMatches(
    int slot,
    int hardwareIndex,
    bool preparingUpload = false
)
{
    // STEP 4C-9B
    // Existing uploads require a valid hardware index.
    // A newly prepared upload must have index -1.

    if (slot < 0 || slot >= GIF_SLOT_COUNT ||
        (preparingUpload
        ? hardwareIndex != -1
        : (hardwareIndex < 0 ||
        hardwareIndex >= GIF_SLOT_COUNT))) {
        return false;
        }


        QFile file(slotDir(slot) + "/metadata.json");

    if (!file.open(QIODevice::ReadOnly)) {
        return false;
    }

    const QJsonDocument document =
    QJsonDocument::fromJson(file.readAll());

    file.close();

    if (!document.isObject()) {
        return false;
    }

    const QJsonObject metadata = document.object();

    const QString gifId =
    metadata.value("gifId").toString();

    if (gifId.size() != 32) {
        return false;
    }

    for (const QChar character : gifId) {
        const ushort value = character.unicode();

        if (!((value >= '0' && value <= '9') ||
            (value >= 'a' && value <= 'f'))) {
            return false;
            }
    }

    const int pages =
    metadata.value("pages").toInt(-1);

    return
    pages >= 1 &&
    pages <= 255 &&
    metadata.value("fps").toInt(-1) == 25 &&
    metadata.value("frameTimeMs").toInt(-1) == 40 &&
    metadata.value("duration").toInt(-1) == pages * 40 &&
    metadata.value("localSlot").toInt(-1) == slot &&
    metadata.value("hardwareListIndex").toInt(-1) ==
    hardwareIndex;
}


static int frameCount(int slot)
{
    if (slot < 0 || slot >= GIF_SLOT_COUNT) return 0;

    QDir dir(slotDir(slot));
    return dir.entryList(
        QStringList() << "frame_*.jpg",
                         QDir::Files
    ).size();
}


// GIF delete transaction (Qt6, VID:PID 3633:0009).
// One journal outside all five slot directories; no SD readback is assumed.
// A committed USB ACK only permits the agreed timed local cleanup.

static QString gifDeleteDataRoot()
{
    // Path calculation must also work before dc_slot_0 is created.
    return QDir::cleanPath(
        QFileInfo(slotDir(0)).dir().filePath(".."));
}

static QString gifDeleteJournalPath()
{
    const QString root = gifDeleteDataRoot();
    return root.isEmpty() ? QString() :
        QDir(root).filePath("gif_delete_transaction.flag");
}

static bool gifDeleteJournalPending()
{
    const QString path = gifDeleteJournalPath();
    if (path.isEmpty()) return true;  // Fail closed.
    const QFileInfo info(path);
    return info.exists() || info.isSymLink();
}

static bool gifDeleteValidUuid(const QString& id)
{
    if (id.size() != 32) return false;
    for (const QChar c : id) {
        const ushort n = c.unicode();
        if (!((n >= '0' && n <= '9') ||
              (n >= 'a' && n <= 'f'))) return false;
    }
    return true;
}

static bool gifDeleteDirectoryUuid(
    const QString& directory, QString& uuid, QString& error)
{
    uuid.clear();
    const QFileInfo dirInfo(directory);
    if (!dirInfo.isDir() || dirInfo.isSymLink()) {
        error = "GIF directory missing or symbolic link: " + directory;
        return false;
    }
    const QString metadataPath = QDir(directory).filePath("metadata.json");
    const QFileInfo metadataInfo(metadataPath);
    if (!metadataInfo.isFile() || metadataInfo.isSymLink()) {
        error = "GIF metadata missing or symbolic link: " + metadataPath;
        return false;
    }
    QFile file(metadataPath);
    if (!file.open(QIODevice::ReadOnly)) {
        error = file.errorString();
        return false;
    }
    QJsonParseError parseError;
    const auto doc = QJsonDocument::fromJson(file.readAll(), &parseError);
    if (parseError.error != QJsonParseError::NoError || !doc.isObject()) {
        error = "Invalid metadata JSON: " + metadataPath;
        return false;
    }
    uuid = doc.object().value("gifId").toString();
    if (!gifDeleteValidUuid(uuid)) {
        error = "Invalid metadata GIF UUID: " + metadataPath;
        return false;
    }
    return true;
}

struct GifDeleteTransaction
{
    int removedSlot = -1;
    int remainingCount = -1;
    int waitMilliseconds = 0;
    QString removedUuid;
    QString phase;
    QString recoveryPath;
    std::array<QString, GIF_SLOT_COUNT> destinationUuid{};
};

static bool prepareGifDeleteTransaction(
    int removedSlot, GifDeleteTransaction& transaction, QString& error)
{
    transaction = GifDeleteTransaction{};
    error.clear();
    if (removedSlot < 0 || removedSlot >= GIF_SLOT_COUNT ||
        gifDeleteJournalPending()) {
        error = "Invalid slot or unresolved delete transaction.";
        return false;
    }
    const QString root = gifDeleteDataRoot();
    if (root.isEmpty() || QFileInfo(root).isSymLink()) {
        error = "Unsafe application data directory.";
        return false;
    }
    std::array<QString, GIF_SLOT_COUNT> originals{};
    int count = 0;
    bool foundGap = false;
    for (int slot = 0; slot < GIF_SLOT_COUNT; ++slot) {
        const bool recorded = gifSlots[slot].uploadedToHardware ||
            gifSlots[slot].hardwareListIndex >= 0 ||
            QFile::exists(uploadFlagPath(slot));
        const QFileInfo dirInfo(slotDir(slot));
        if (dirInfo.isSymLink()) {
            error = QString("Symlink in GIF slot %1.").arg(slot);
            return false;
        }
        if (!recorded) {
            foundGap = true;
            // Empty GUI slots may already have an empty gif_source directory.
            if (!gifSlots[slot].path.isEmpty() ||
                QFile::exists(rawGifPath(slot)) ||
                QFile::exists(cropFlagPath(slot)) ||
                QFile::exists(uploadUncertainFlagPath(slot)) ||
                QFile::exists(deleteUncertainFlagPath(slot)) ||
                (dirInfo.isDir() && !QDir(slotDir(slot)).entryList(
                    QDir::AllEntries | QDir::NoDotAndDotDot |
                    QDir::Hidden | QDir::System).isEmpty())) {
                error = QString("Slot %1 contains unregistered GIF data.").arg(slot);
                return false;
            }
            continue;
        }
        if (foundGap || gifSlots[slot].hardwareListIndex != slot ||
            !gifSlots[slot].uploadedToHardware ||
            !QFile::exists(rawGifPath(slot)) ||
            !QFile::exists(cropFlagPath(slot)) ||
            !QFile::exists(uploadFlagPath(slot)) ||
            QFile::exists(uploadUncertainFlagPath(slot)) ||
            QFile::exists(deleteUncertainFlagPath(slot)) ||
            !uploadedGifMetadataMatches(slot, slot)) {
            error = QString("Inconsistent uploaded GIF at slot %1.").arg(slot);
            return false;
        }
        QSettings settings("LionheartTim", "DeepCoolDigitalGui");
        bool indexValid = false;
        const int savedIndex = settings.value(
            QString("gifHardwareIndex/%1").arg(slot)).toInt(&indexValid);
        if (!indexValid || savedIndex != slot) {
            error = QString("Stored hardware index mismatch in slot %1.").arg(slot);
            return false;
        }
        if (!gifDeleteDirectoryUuid(slotDir(slot), originals[slot], error))
            return false;
        for (int previous = 0; previous < slot; ++previous) {
            if (originals[previous] == originals[slot]) {
                error = "Duplicate GIF UUIDs in local slots.";
                return false;
            }
        }
        ++count;
    }
    if (removedSlot >= count) {
        error = "Requested GIF is not a registered hardware upload.";
        return false;
    }
    const int frames = frameCount(removedSlot);
    if (frames < 1 || frames > 255) {
        error = "Deleted GIF frame count must be between 1 and 255.";
        return false;
    }
    QFile metadataFile(slotDir(removedSlot) + "/metadata.json");
    if (!metadataFile.open(QIODevice::ReadOnly)) {
        error = "Cannot read source frame metadata.";
        return false;
    }
    const int pages = QJsonDocument::fromJson(metadataFile.readAll())
        .object().value("pages").toInt(-1);
    if (pages != frames) {
        error = "JPEG frame count and GIF metadata disagree.";
        return false;
    }
    transaction.removedSlot = removedSlot;
    transaction.remainingCount = count - 1;
    transaction.waitMilliseconds = 10000 + qMax(0, frames - 20) * 100;
    transaction.removedUuid = originals[removedSlot];
    transaction.phase = "prepared";
    transaction.recoveryPath = QDir(root).filePath(
        "gif_delete_recovery/" + transaction.removedUuid);
    const QFileInfo recoveryRoot(QFileInfo(transaction.recoveryPath).absolutePath());
    const QFileInfo recoveryDestination(transaction.recoveryPath);
    if (recoveryRoot.isSymLink() ||
        (recoveryRoot.exists() && !recoveryRoot.isDir()) ||
        recoveryDestination.exists() || recoveryDestination.isSymLink()) {
        error = "Recovery destination is unsafe or already occupied.";
        return false;
    }
    for (int destination = 0; destination < count - 1; ++destination) {
        const int source = destination < removedSlot ?
            destination : destination + 1;
        transaction.destinationUuid[destination] = originals[source];
    }
    return true;
}

static bool writeGifDeleteTransaction(
    const GifDeleteTransaction& transaction, QString& error)
{
    error.clear();
    const QString path = gifDeleteJournalPath();
    if (path.isEmpty() || QFileInfo(path).isSymLink()) {
        error = "Unsafe GIF delete journal path.";
        return false;
    }
    QJsonObject obj;
    obj["schema"] = 1;
    obj["phase"] = transaction.phase;
    obj["removedSlot"] = transaction.removedSlot;
    obj["remainingCount"] = transaction.remainingCount;
    obj["waitMilliseconds"] = transaction.waitMilliseconds;
    obj["removedUuid"] = transaction.removedUuid;
    obj["recoveryPath"] = transaction.recoveryPath;
    QJsonArray ids;
    for (const auto& uuid : transaction.destinationUuid) ids.append(uuid);
    obj["destinationUuid"] = ids;
    const QByteArray bytes = QJsonDocument(obj).toJson(QJsonDocument::Indented);
    QSaveFile file(path);
    if (!file.open(QIODevice::WriteOnly) ||
        file.write(bytes) != bytes.size() || !file.commit()) {
        error = "Cannot atomically save GIF delete journal: " + file.errorString();
        return false;
    }
    return true;
}

static bool readGifDeleteTransaction(
    GifDeleteTransaction& transaction, QString& error)
{
    transaction = GifDeleteTransaction{};
    error.clear();
    const QString path = gifDeleteJournalPath();
    if (path.isEmpty() || QFileInfo(path).isSymLink()) {
        error = "Unsafe GIF delete journal path.";
        return false;
    }
    QFile file(path);
    if (!file.open(QIODevice::ReadOnly)) {
        error = "Cannot read GIF delete journal: " + file.errorString();
        return false;
    }
    QJsonParseError parseError;
    const QJsonDocument doc = QJsonDocument::fromJson(file.readAll(), &parseError);
    if (parseError.error != QJsonParseError::NoError || !doc.isObject()) {
        error = "Invalid GIF delete journal JSON.";
        return false;
    }
    const QJsonObject obj = doc.object();
    if (obj.value("schema").toInt(-1) != 1) {
        error = "Unsupported GIF delete journal format.";
        return false;
    }
    transaction.removedSlot = obj.value("removedSlot").toInt(-1);
    transaction.remainingCount = obj.value("remainingCount").toInt(-1);
    transaction.waitMilliseconds = obj.value("waitMilliseconds").toInt(-1);
    transaction.removedUuid = obj.value("removedUuid").toString();
    transaction.phase = obj.value("phase").toString();
    transaction.recoveryPath = obj.value("recoveryPath").toString();
    const QJsonArray ids = obj.value("destinationUuid").toArray();
    if (transaction.removedSlot < 0 ||
        transaction.removedSlot >= GIF_SLOT_COUNT ||
        transaction.remainingCount < 0 ||
        transaction.remainingCount >= GIF_SLOT_COUNT ||
        transaction.removedSlot > transaction.remainingCount ||
        transaction.waitMilliseconds < 10000 ||
        transaction.waitMilliseconds > 33500 ||
        !gifDeleteValidUuid(transaction.removedUuid) ||
        (transaction.phase != "prepared" &&
         transaction.phase != "acknowledged") ||
        ids.size() != GIF_SLOT_COUNT) {
        error = "Invalid GIF delete journal fields.";
        return false;
    }
    const QString expectedRecovery = QDir(gifDeleteDataRoot()).filePath(
        "gif_delete_recovery/" + transaction.removedUuid);
    if (expectedRecovery != transaction.recoveryPath) {
        error = "Recovery path does not match the recorded UUID.";
        return false;
    }
    for (int i = 0; i < GIF_SLOT_COUNT; ++i) {
        const QString id = ids.at(i).toString();
        if (i < transaction.remainingCount) {
            if (!gifDeleteValidUuid(id) || id == transaction.removedUuid) {
                error = "Invalid surviving GIF UUID in journal.";
                return false;
            }
            for (int j = 0; j < i; ++j) {
                if (transaction.destinationUuid[j] == id) {
                    error = "Duplicate surviving GIF UUID in journal.";
                    return false;
                }
            }
        } else if (!id.isEmpty()) {
            error = "Unexpected GIF UUID in an empty destination slot.";
            return false;
        }
        transaction.destinationUuid[i] = id;
    }
    return true;
}

// STEP 4C-14E-2
// Non-cancelable GIF delete waiting window.
// Progress represents elapsed waiting time, NOT SD completion.

class GifDeleteWaitingDialog final : public QDialog
{
public:
    explicit GifDeleteWaitingDialog(QWidget* parent)
        : QDialog(parent)
    {
        setWindowTitle("Deleting GIF");
        setWindowModality(Qt::ApplicationModal);
        setModal(true);
        setMinimumSize(520, 185);
        resize(560, 195);
    }

    void finishWaiting()
    {
        m_finished = true;
        accept();
    }

    void reject() override
    {
        if (m_finished) {
            QDialog::reject();
        }
    }

protected:
    void closeEvent(QCloseEvent* event) override
    {
        if (m_finished) {
            QDialog::closeEvent(event);
        } else {
            event->ignore();
        }
    }

private:
    bool m_finished = false;
};

[[maybe_unused]] static void showGifDeleteProgress(
    QWidget* parent,
    int waitMilliseconds)
{
    if (waitMilliseconds <= 0) {
        return;
    }

    GifDeleteWaitingDialog dialog(parent);
    dialog.setWindowTitle("Deleting GIF");
    dialog.setWindowFlag(Qt::WindowCloseButtonHint, false);
    dialog.setMinimumWidth(420);
    dialog.setModal(true);

    auto* layout = new QVBoxLayout(&dialog);

    auto* description = new QLabel(
        "Please wait while your GIF is being removed "
        "from your DeepCool MYSTIQUE.",
        &dialog
    );
    description->setWordWrap(true);

    auto* progress = new QProgressBar(&dialog);
    progress->setRange(0, 100);
    progress->setValue(0);
    progress->setFormat("%p%");

    auto* remaining = new QLabel(&dialog);
    remaining->setText(
        QString("%1 seconds remaining")
            .arg((waitMilliseconds + 999) / 1000)
    );

    auto* information = new QLabel(
        "This window will close automatically.",
        &dialog
    );

    layout->addWidget(description);
    layout->addWidget(progress);
    layout->addWidget(remaining);
    layout->addWidget(information);

    QElapsedTimer elapsed;
    QTimer timer(&dialog);

    QObject::connect(
        &timer,
        &QTimer::timeout,
        &dialog,
        [&]() {
            const qint64 elapsedMs = qMin<qint64>(
                elapsed.elapsed(),
                waitMilliseconds
            );

            const int percentage = static_cast<int>(
                elapsedMs * 100 / waitMilliseconds
            );

            const qint64 remainingMs =
                waitMilliseconds - elapsedMs;

            progress->setValue(percentage);

            remaining->setText(
                QString("%1 seconds remaining")
                    .arg((remainingMs + 999) / 1000)
            );

            if (remainingMs == 0) {
                timer.stop();
                dialog.finishWaiting();
            }
        }
    );

    elapsed.start();
    timer.start(50);

    dialog.exec();
}

static void clearDirectory(const QString& path)
{
    QDir dir(path);
    if (!dir.exists()) return;
    const auto entries = dir.entryInfoList(QDir::NoDotAndDotDot | QDir::AllEntries);
    for (const QFileInfo& info : entries) {
        if (info.isDir()) QDir(info.absoluteFilePath()).removeRecursively();
        else QFile::remove(info.absoluteFilePath());
    }
}

// ============================================================
// Check of een shell-commando bestaat
// ============================================================
static bool commandExists(const char* command)
{
    const QString check = QString("command -v %1 >/dev/null 2>&1").arg(command);
    return std::system(check.toLocal8Bit().constData()) == 0;
}

// VRAM-gebruik uitlezen.
static float readVramUsagePercent()
{
    if (hasNvidiaGpu) {
        FILE* pipe = popen(
            "nvidia-smi --query-gpu=memory.used,memory.total "
            "--format=csv,noheader,nounits 2>/dev/null",
            "r"
        );

        if (!pipe)
            return -1.0f;

        unsigned long long usedMiB = 0;
        unsigned long long totalMiB = 0;

        const int result = fscanf(
            pipe, "%llu, %llu", &usedMiB, &totalMiB
        );

        pclose(pipe);

        if (result == 2 && totalMiB > 0) {
            return static_cast<float>(
                100.0 * usedMiB / totalMiB
            );
        }

        return -1.0f;
    }

    QStringList gpuDirs;

    if (!globalGpuLoadPath.empty()) {
        const size_t slash = globalGpuLoadPath.rfind('/');

        if (slash != std::string::npos) {
            gpuDirs.append(QString::fromStdString(
                globalGpuLoadPath.substr(0, slash)
            ));
        }
    }

    for (int i = 0; i < 32; ++i) {
        const QString path =
        QString("/sys/class/drm/card%1/device").arg(i);

        if (!gpuDirs.contains(path))
            gpuDirs.append(path);
    }

    for (const QString& gpuDir : gpuDirs) {
        std::ifstream usedFile(
            (gpuDir + "/mem_info_vram_used").toStdString()
        );

        std::ifstream totalFile(
            (gpuDir + "/mem_info_vram_total").toStdString()
        );

        unsigned long long usedBytes = 0;
        unsigned long long totalBytes = 0;

        if ((usedFile >> usedBytes) &&
            (totalFile >> totalBytes) &&
            totalBytes > 0) {

            const float percentage = static_cast<float>(
                100.0 * usedBytes / totalBytes
            );

        qDebug() << "[VRAM] Bron:" << gpuDir
        << "Gebruik:" << percentage << "%";

        return percentage;
            }
    }

    qDebug() << "[VRAM] Geen bruikbare VRAM-bron gevonden.";
    return -1.0f;
}

// ============================================================
// Debug logger — schrijft met tijdstempel naar de console
// ============================================================
static void logDebug(const QString& category, const QString& message)
{
    qDebug().noquote()
    << QDateTime::currentDateTime().toString("HH:mm:ss.zzz")
    << "[" << category << "]"
    << message;
}

// ============================================================
// Zoals runImageMagick(), maar vangt ook de output op
// voor foutopsporing. Geeft true terug bij succes.
// ============================================================
static bool runImageMagickWithOutput(
    const QString& source,
    const QString& destination,
    QString& output
)
{
    const QString executable =
    commandExists("magick") ? "magick" : "convert";

    QProcess process;
    process.setProgram(executable);
    process.setArguments({
        source,
        "-coalesce",
        "+matte",
        "-strip",
        destination
    });

    output.clear();
    process.start(QIODevice::ReadOnly);

    if (!process.waitForStarted(5000)) {
        output = process.errorString();
        return false;
    }

    QElapsedTimer timer;
    timer.start();

    bool timedOut = false;

    while (process.state() != QProcess::NotRunning) {
        process.waitForFinished(100);

        output += QString::fromLocal8Bit(
            process.readAllStandardOutput()
        );
        output += QString::fromLocal8Bit(
            process.readAllStandardError()
        );

        QApplication::processEvents();

        if (process.state() != QProcess::NotRunning &&
            timer.elapsed() > 120000) {

            timedOut = true;
        process.kill();
        process.waitForFinished();
        break;
            }
    }

    output += QString::fromLocal8Bit(
        process.readAllStandardOutput()
    );
    output += QString::fromLocal8Bit(
        process.readAllStandardError()
    );

    if (timedOut) {
        output += "\nImageMagick duurde langer dan 120 seconden.";
        return false;
    }

    if (process.exitStatus() != QProcess::NormalExit ||
        process.exitCode() != 0) {
        return false;
        }

        if (!QFile::exists(destination) ||
            QFileInfo(destination).size() <= 0) {

            output += "\nOutput-bestand ontbreekt of is leeg: "
            + destination;
        return false;
            }

            return true;
        }



class GifDropWidget : public QLabel {
public:
    explicit GifDropWidget(int slot, QWidget* parent = nullptr) : QLabel(parent), m_slot(slot)
    {
        setAcceptDrops(true);
        setMinimumSize(90, 110);
        setMaximumSize(130, 140);
        setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Fixed);
        setAlignment(Qt::AlignCenter);
        setFrameShape(QFrame::NoFrame);
        setStyleSheet(
            "border: 2px dashed #5a6069;"
            "border-radius: 8px;"
            "background: #1a1d21;"
            "color: #b0b6bf;"
        );
        setText("Drag\n&\nDrop");
        setProperty("gifSlot", true);
    }

    std::function<void(int,const QString&)> dropped;

protected:
    void dragEnterEvent(QDragEnterEvent* e) override
    {
        if (e->mimeData()->hasUrls()) {
            for (const QUrl& url : e->mimeData()->urls()) {
                if (url.isLocalFile() && url.toLocalFile().endsWith(".gif", Qt::CaseInsensitive)) {
                    e->acceptProposedAction(); return;
                }
            }
        }
        e->ignore();
    }

    void dropEvent(QDropEvent* e) override
    {
        qWarning().noquote()
        << "[DROP-DIAG] GifDropWidget bereikt; slot="
        << m_slot
        << "URL-count="
        << e->mimeData()->urls().size();

        for (const QUrl& url : e->mimeData()->urls()) {
            if (!url.isLocalFile()) {
                continue;
            }

            const QString path = url.toLocalFile();

            if (path.endsWith(".gif", Qt::CaseInsensitive)) {
                if (dropped) {
                    qWarning().noquote()
                    << "[DROP-DIAG] Callback voor slot"
                    << m_slot << path;

                    dropped(m_slot, path);
                } else {
                    qWarning()
                    << "[DROP-DIAG] Geen drop-callback ingesteld voor slot"
                    << m_slot;
                }

                e->acceptProposedAction();
                return;
            }
        }

        qWarning()
        << "[DROP-DIAG] Geen lokale GIF-URL gevonden.";

        e->ignore();
    }

private:
    int m_slot;
};

    class GifCropWidget : public QWidget {
    public:
        explicit GifCropWidget(QWidget* parent = nullptr) : QWidget(parent)
        {
            setMinimumSize(540, 540);
            setMouseTracking(true);
            m_zoom = 1.5;   // begin iets ingezoomd
        }

        void setImage(const QImage& image) { m_image = image; update(); }
        float zoom() const { return m_zoom; }
        QPointF offset() const { return m_offset; }
        void resetTransform() { m_zoom = 1.0; m_offset = {}; update(); }

        void setRotation(int rotation)
        {
            m_rotation = rotation;
            update();
        }

        QRect cropRectInImage() const
        {
            if (m_image.isNull() || m_zoom <= 0.0)
                return {};

            const bool portrait = (m_rotation == 0 || m_rotation == 2);
            const int selW = portrait ? 360 : 480;
            const int selH = portrait ? 480 : 360;

            const QRectF selector(
                (width() - selW) / 2.0,
                                  (height() - selH) / 2.0,
                                  selW,
                                  selH
            );

            const QImage scaled = m_image.scaled(
                QSize(480, 360),
                                                 Qt::KeepAspectRatio,
                                                 Qt::SmoothTransformation
            );

            if (scaled.isNull())
                return {};

            // Exact dezelfde positie- en zoomformule als paintEvent().
            const QPointF center(width() / 2.0, height() / 2.0);
            const QPointF imagePos =
            center - QPointF(
                scaled.width() * m_zoom / 2.0,
                             scaled.height() * m_zoom / 2.0
            ) + m_offset;

            // Van getekende pixels terugrekenen naar bronpixels.
            const double scaleX =
            static_cast<double>(m_image.width()) / scaled.width();
            const double scaleY =
            static_cast<double>(m_image.height()) / scaled.height();

            const double targetRatio =
            static_cast<double>(selW) / selH;

            double cropW = (selW / m_zoom) * scaleX;
            double cropH = (selH / m_zoom) * scaleY;

            // Zorg dat de uitsnede binnen de bronafbeelding past,
            // zonder de verhouding van het TFT te veranderen.
            const double maxCropW = std::min(
                static_cast<double>(m_image.width()),
                                             static_cast<double>(m_image.height()) * targetRatio
            );

            const double maxCropH = maxCropW / targetRatio;

            const double fitScale = std::min({
                1.0,
                maxCropW / cropW,
                maxCropH / cropH
            });

            cropW *= fitScale;
            cropH *= fitScale;

            const int cropWidth = std::clamp(
                qRound(cropW), 1, m_image.width()
            );
            const int cropHeight = std::clamp(
                qRound(cropH), 1, m_image.height()
            );

            const double sourceCenterX =
            ((selector.center().x() - imagePos.x()) / m_zoom)
            * scaleX;

            const double sourceCenterY =
            ((selector.center().y() - imagePos.y()) / m_zoom)
            * scaleY;

            const int cropX = std::clamp(
                qRound(sourceCenterX - cropWidth / 2.0),
                                         0,
                                         m_image.width() - cropWidth
            );

            const int cropY = std::clamp(
                qRound(sourceCenterY - cropHeight / 2.0),
                                         0,
                                         m_image.height() - cropHeight
            );

            return QRect(cropX, cropY, cropWidth, cropHeight);
        }

    protected:
        void paintEvent(QPaintEvent*) override
        {
            QPainter p(this);
            p.fillRect(rect(), QColor(22,24,28));
            if (m_image.isNull()) return;

            // ============================================================
            // SELECTOR AFMETINGEN op basis van rotatie
            // 0° / 180° -> staand (360 x 480)
            // 90° / 270° -> liggend (480 x 360)
            // ============================================================
            const bool portrait = (m_rotation == 0 || m_rotation == 2);
            const int selW = portrait ? 360 : 480;
            const int selH = portrait ? 480 : 360;

            // GIF wordt geschaald naar het canvas
            const QSize target(480, 360);
            QImage scaled = m_image.scaled(target, Qt::KeepAspectRatio, Qt::SmoothTransformation);

            const QPointF center(width()/2.0, height()/2.0);
            const QPointF pos = center - QPointF(scaled.width()*m_zoom/2.0,
                                                 scaled.height()*m_zoom/2.0) + m_offset;

                                                 p.save();
                                                 p.translate(pos);
                                                 p.scale(m_zoom, m_zoom);
                                                 p.drawImage(QPoint(0,0), scaled);
                                                 p.restore();

                                                 // ============================================================
                                                 // SELECTOR — gecentreerd, draait mee met rotatie
                                                 // ============================================================
                                                 const int selX = (width()  - selW) / 2;
                                                 const int selY = (height() - selH) / 2;

                                                 p.setPen(QPen(QColor(0, 171, 153), 4));
                                                 p.drawRect(selX, selY, selW, selH);
        }

        void wheelEvent(QWheelEvent* e) override
        {
            m_zoom = std::clamp(m_zoom + (e->angleDelta().y() > 0 ? 0.1 : -0.1), 0.1, 5.0);
            update();
        }

        void mousePressEvent(QMouseEvent* e) override
        {
            if (e->button() == Qt::LeftButton) { m_dragging = true; m_last = e->position(); }
        }

        void mouseMoveEvent(QMouseEvent* e) override
        {
            if (m_dragging) { m_offset += e->position() - m_last; m_last = e->position(); update(); }
        }

        void mouseReleaseEvent(QMouseEvent* e) override
        {
            if (e->button() == Qt::LeftButton) m_dragging = false;
        }

    private:
        QImage m_image;
        double m_zoom = 1.0;
        QPointF m_offset;
        QPointF m_last;
        bool m_dragging = false;
        int m_rotation = 3;   // 🆕 standaard 270° (horizontaal)
    };

// ============================================================
// METRIC CARD — titel + waarde + vloeiende lijngrafiek
// ============================================================
class MetricCard : public QWidget {
public:
    MetricCard(const QString& title,
               const QString& unit,
               float yMax,
               QColor color,
               const float* historyBuffer,
               int historySize,
               QWidget* parent = nullptr)
    : QWidget(parent)
    , m_title(title)
    , m_unit(unit)
    , m_yMax(yMax)
    , m_color(color)
    , m_history(historyBuffer)
    , m_historySize(historySize)
    {
        setMinimumHeight(140);
        setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Fixed);

        // Achtergrond transparant — QGroupBox-achtige uitstraling
        setAutoFillBackground(false);
    }

    void setValue(float value)
    {
        m_value = value;
        update();
    }

    void setValueText(const QString& text)
    {
        m_valueText = text;
        update();
    }

protected:
    void paintEvent(QPaintEvent*) override
    {
        QPainter p(this);
        p.setRenderHint(QPainter::Antialiasing);
        p.setRenderHint(QPainter::TextAntialiasing);

        // ============================================================
        // ACHTERGROND
        // ============================================================
        const QRectF cardRect = rect().adjusted(0, 0, -1, -1);

        p.setPen(QPen(QColor(61, 65, 72), 1));
        p.setBrush(QColor(28, 31, 36));
        p.drawRoundedRect(cardRect, 6, 6);

        // ============================================================
        // TITEL (linksboven)
        // ============================================================
        p.setPen(m_color);
        p.setFont(QFont("Sans", 10, QFont::Bold));
        p.drawText(QRectF(14, 10, width() - 28, 18),
                   Qt::AlignLeft | Qt::AlignVCenter, m_title);

        // ============================================================
        // WAARDE (groot, links, direct onder titel)
        // ============================================================
        p.setPen(m_color);
        p.setFont(QFont("Sans", 20, QFont::Bold));

        const QString displayText = m_valueText.isEmpty()
        ? QString::number(m_value, 'f', (m_yMax <= 10.0f ? 2 : 1)) + " " + m_unit
        : m_valueText;

        p.drawText(QRectF(14, 32, width() - 28, 30),
                   Qt::AlignLeft | Qt::AlignVCenter, displayText);

        // ============================================================
        // GRAFIEK (vult de rest van de kaart)
        // ============================================================
        const int graphTop = 70;
        const int graphBottom = height() - 12;
        const int graphLeft = 14;
        const int graphRight = width() - 14;

        const QRectF graphRect(graphLeft, graphTop,
                               graphRight - graphLeft,
                               graphBottom - graphTop);

        if (graphRect.height() <= 5) { return; }

        // Bouw een QPainterPath van de history buffer
        QPainterPath linePath;
        QPainterPath fillPath;

        const int n = m_historySize;
        if (n < 2 || !m_history) { return; }

        // Startpunt linksonder
        fillPath.moveTo(graphRect.left(), graphRect.bottom());

        for (int i = 0; i < n; ++i) {
            const float ratioX = static_cast<float>(i) / (n - 1);
            const float ratioY = qBound(0.0f, m_history[i] / m_yMax, 1.0f);

            const qreal x = graphRect.left() + ratioX * graphRect.width();
            const qreal y = graphRect.bottom() - ratioY * graphRect.height();

            if (i == 0) {
                linePath.moveTo(x, y);
            } else {
                linePath.lineTo(x, y);
            }
            fillPath.lineTo(x, y);
        }

        // Sluit fill path aan de onderkant
        fillPath.lineTo(graphRect.right(), graphRect.bottom());
        fillPath.closeSubpath();

        // Teken fill met gradient (kleur → transparant)
        QLinearGradient gradient(graphRect.topLeft(), graphRect.bottomLeft());
        QColor fillTop = m_color;
        fillTop.setAlpha(90);
        QColor fillBottom = m_color;
        fillBottom.setAlpha(10);

        gradient.setColorAt(0.0, fillTop);
        gradient.setColorAt(1.0, fillBottom);

        p.fillPath(fillPath, gradient);

        // Teken de lijn zelf
        p.setPen(QPen(m_color, 2.0));
        p.setBrush(Qt::NoBrush);
        p.drawPath(linePath);
    }

private:
    QString m_title;
    QString m_unit;
    float   m_yMax = 100.0f;
    QColor  m_color;

    const float* m_history = nullptr;
    int m_historySize = 0;

    float m_value = 0.0f;
    QString m_valueText;
};

// GUI STEP 4A - EXCLUSIVE RGB SWITCHES
// A visual switch, implemented using native QCheckBox functionality.
// QButtonGroup owns the exclusive selection policy; this class sends no USB.
class MysticRgbSwitch final : public QCheckBox
{
public:
    explicit MysticRgbSwitch(QWidget* parent = nullptr) : QCheckBox(parent)
    {
        setFixedSize(50, 28);
        setCursor(Qt::PointingHandCursor);
        setFocusPolicy(Qt::StrongFocus);
    }

protected:
    // GUI STEP 4A - RGB CLICK AND PERSISTENCE V2
    // Accept clicks anywhere on the visible 50 x 28 switch.
    bool hitButton(const QPoint& position) const override
    {
        return rect().contains(position);
    }

    void nextCheckState() override
    {
        // Clicking an active switch must not leave all modes switched off.
        setChecked(true);
    }

    void paintEvent(QPaintEvent*) override
    {
        QPainter painter(this);
        painter.setRenderHint(QPainter::Antialiasing);
        painter.setPen(Qt::NoPen);
        const QColor track = !isEnabled() ? QColor(65, 69, 73) :
            isChecked() ? QColor(0, 171, 153) : QColor(83, 88, 94);
        painter.setBrush(track);
        painter.drawRoundedRect(QRectF(1, 4, 48, 20), 10, 10);
        painter.setBrush(QColor(245, 248, 250));
        painter.drawEllipse(QRectF(isChecked() ? 29 : 5, 6, 16, 16));
        if (hasFocus()) {
            painter.setPen(QPen(QColor(150, 210, 205), 1));
            painter.setBrush(Qt::NoBrush);
            painter.drawRoundedRect(QRectF(0.5, 3.5, 49, 21), 10, 10);
        }
    }
};

// Visual-only TFT brightness shading; does not change USB, GIF data or RGB LEDs.
class MysticPreviewBrightnessShade final : public QWidget
{
public:
    explicit MysticPreviewBrightnessShade(QWidget* parent = nullptr)
        : QWidget(parent)
    {
        setAttribute(Qt::WA_TransparentForMouseEvents);
        setAttribute(Qt::WA_TranslucentBackground);
    }

    void setBrightness(int percent)
    {
        m_darkness = 255 * (100 - qBound(0, percent, 100)) / 100;
        update();
    }

protected:
    void paintEvent(QPaintEvent*) override
    {
        QPainter painter(this);
        painter.fillRect(rect(), QColor(0, 0, 0, m_darkness));
    }

private:
    int m_darkness = 0;
};

// MYSTIQUE FIRST LAUNCH HIDC 0x14 v1
// One destructive request for SD:GIF + SD:IMG, before standard device startup.
// This does NOT format the SD card. ACK is acceptance, not SD completion.
// Never retry automatically after ANY attempted USB send.
namespace MystiqueFirstLaunch {
static const char* const stateKey = "firstLaunchMediaCleanup/status";
static const char* const oldMarkerRelative =
    "/.local/state/deepcool-mystique/media-cleanup-0x14-attempt.json";

static bool sendOneTimeCleanup(QString& error, bool& attempted)
{
    error.clear();
    attempted = false;
    libusb_context* context = nullptr;
    libusb_device_handle* handle = nullptr;
    bool claimed = false;
    auto release = [&]() {
        if (claimed) libusb_release_interface(handle, 0);
        if (handle) libusb_close(handle);
        if (context) libusb_exit(context);
    };

    const int initResult = libusb_init(&context);
    if (initResult != LIBUSB_SUCCESS) {
        error = QString("libusb initialization failed (%1).").arg(initResult);
        if (context) libusb_exit(context);
        return false;
    }
    handle = libusb_open_device_with_vid_pid(context, 0x3633, 0x0009);
    if (!handle) {
        error = "DeepCool MYSTIQUE (3633:0009) is not connected or accessible.";
        release();
        return false;
    }
    const int kernel = libusb_kernel_driver_active(handle, 0);
    if (kernel != 0) {
        error = "USB interface 0 is occupied or cannot be checked. No detach attempted.";
        release();
        return false;
    }
    const int claim = libusb_claim_interface(handle, 0);
    if (claim != LIBUSB_SUCCESS) {
        error = QString("Cannot claim USB interface 0 (%1).").arg(claim);
        release();
        return false;
    }
    claimed = true;

    // Guard against two concurrently started applications. The lock is held
    // through USB transfer, and the QSettings attempt marker survives a crash.
    QSettings settings("LionheartTim", "DeepCoolDigitalGui");
    const QString settingsDir = QFileInfo(settings.fileName()).absolutePath();
    if (!QDir().mkpath(settingsDir)) {
        error = "Cannot create first-launch state directory. Nothing sent.";
        release();
        return false;
    }
    QLockFile onceLock(settings.fileName() + ".media-cleanup.lock");
    if (!onceLock.tryLock(0)) {
        error = "Another First Launch cleanup is running. Nothing sent.";
        release();
        return false;
    }
    settings.sync();
    if (settings.status() != QSettings::NoError ||
        !settings.value(stateKey).toString().isEmpty()) {
        error = "A prior cleanup status is already recorded. Nothing sent.";
        release();
        return false;
    }
    // Persist irreversible attempt BEFORE any USB bytes are sent.
    settings.setValue(stateKey, "attempted-unknown");
    settings.sync();
    if (settings.status() != QSettings::NoError) {
        error = "Cannot save first-launch attempt marker. No USB command sent.";
        release();
        return false;
    }

    QByteArray packet(48, '\0');
    packet[0] = char(0xAA);
    packet[1] = char(0x2E);
    packet[2] = char(0x14);
    packet.replace(42, 4, "HIDC");
    quint16 sum = 0;
    for (int i = 0; i < 46; ++i) sum += quint8(packet.at(i));
    packet[46] = char(sum & 0xFF);
    packet[47] = char((sum >> 8) & 0xFF);
    if (quint8(packet.at(46)) != 0x04 || quint8(packet.at(47)) != 0x02) {
        error = "Internal HIDC packet checksum mismatch. No USB command sent.";
        release();
        return false;
    }

    attempted = true;
    qWarning() << "[FIRST-LAUNCH] One-time destructive HIDC 0x14 send attempt";
    int sent = 0;
    const int outResult = libusb_bulk_transfer(
        handle, 0x01, reinterpret_cast<unsigned char*>(packet.data()),
        48, &sent, 5000);
    if (outResult != LIBUSB_SUCCESS || sent != 48) {
        error = QString("Cleanup send not confirmed (USB %1, %2/48 bytes). "
                        "Do not retry automatically.").arg(outResult).arg(sent);
        release();
        return false;
    }

    QByteArray ack(48, '\0');
    int got = 0;
    const int inResult = libusb_bulk_transfer(
        handle, 0x81, reinterpret_cast<unsigned char*>(ack.data()),
        48, &got, 5000);
    release();

    if (inResult != LIBUSB_SUCCESS || got != 48 ||
        quint8(ack.at(0)) != 0x55 || quint8(ack.at(1)) != 0x2E ||
        quint8(ack.at(2)) != 0x14 || quint8(ack.at(3)) != 0x00 ||
        ack.mid(42, 4) != QByteArray("HIDC")) {
        error = "Cleanup result uncertain (missing or invalid ACK). "
                "Do not retry automatically.";
        return false;
    }
    quint16 expected = 0;
    for (int i = 0; i < 46; ++i) expected += quint8(ack.at(i));
    if (quint8(ack.at(46)) != (expected & 0xFF) ||
        quint8(ack.at(47)) != ((expected >> 8) & 0xFF)) {
        error = "Cleanup ACK checksum invalid. Do not retry automatically.";
        return false;
    }
    qInfo() << "[FIRST-LAUNCH] HIDC 0x14 ACK accepted; SD completion unknown";
    return true;
}
}

class MainWindow : public QMainWindow {
public:
    MainWindow()
    {
        setWindowTitle("DeepCool MYSTIQUE Control Hub - Qt6");
        resize(1120, 760);
        setAcceptDrops(true);
        buildUi();
        // MYSTIQUE STEP 6D LIVE EVENT LOG v1 — no USB/sensor calls.
        MystiqueLiveLog::install();
        connect(&m_diagnosticsLogTimer, &QTimer::timeout, this, [this]() {
            const QStringList events = MystiqueLiveLog::takePending();
            for (const QString& event : events) {
                if (m_diagLiveLog) m_diagLiveLog->appendPlainText(event);
                if (m_diagPopupLog) m_diagPopupLog->appendPlainText(event);
            }
        });
        m_diagnosticsLogTimer.start(250);
        // Send only after a short quiet period; no USB while GIF is busy.
        m_visualConfigTimer.setSingleShot(true);
        m_visualConfigTimer.setInterval(200);
        connect(&m_visualConfigTimer, &QTimer::timeout,
                this, [this]() {
            if (!m_rgbSwitchGroup || !m_brightnessSlider ||
                !globalDevice || !globalDevice->isOpen()) return;
            if (m_gifPreparationActive || m_uploadRunning) {
                m_visualConfigTimer.start(1200);
                return;
            }
            if (gifDeleteJournalPending()) return;
            for (int i = 0; i < GIF_SLOT_COUNT; ++i) {
                if (QFile::exists(uploadUncertainFlagPath(i)) ||
                    QFile::exists(deleteUncertainFlagPath(i))) {
                    qWarning() << "[VISUAL-CONFIG] Pending uncertain GIF state;"
                                  " hardware config not sent.";
                    return;
                }
            }
            const int rgb = m_rgbSwitchGroup->checkedId();
            const int brightness = m_brightnessSlider->value();
            if (rgb < 0 || rgb > 2 || brightness < 0 || brightness > 100)
                return;
            if (!globalDevice->setVisualSettings(rgb, brightness)) {
                qWarning() << "[VISUAL-CONFIG] Hardware setting not confirmed.";
                setStatus("RGB / brightness: device did not confirm setting.");
            }
        });
        loadSettingsAndSlots();
        // STEP 5B: Cache the vendor decision before choosing sensor readers.
        m_hardwareProfile = MystiqueMetrics::loadHardwareProfile();
        qInfo().noquote() << "[METRICS-PROFILE]"
                          << (m_hardwareProfile.cached ? "cache" : "new detection")
                          << "CPU=" << m_hardwareProfile.cpuVendor
                          << "GPU=" << m_hardwareProfile.gpuVendor;
        scanSensors();
        // First launch is handled after the window is shown, BEFORE normal USB
        // initialization, tray setup, and every hardware/preview timer.

        m_timer.setInterval(40);
        connect(&m_timer, &QTimer::timeout, this, &MainWindow::tickFast);

        m_slowTimer.setInterval(1000);
        connect(&m_slowTimer, &QTimer::timeout, this, &MainWindow::tickSlow);
        // STEP 6E: visual-only 500 ms temperature warning blink.
        m_thermalBlinkTimer.setInterval(500);
        connect(&m_thermalBlinkTimer, &QTimer::timeout, this, [this]() {
            m_thermalBlinkRed = !m_thermalBlinkRed;
            refreshThermalSourceColors();
        });
        // Running these timers during the destructive 0x14 operation would
        // introduce conflicting USB commands. Start only after setup exits.
        QTimer::singleShot(0, this, [this]() {
            if (!runFirstLaunchMediaSetup()) {
                QCoreApplication::quit();
                return;
            }
            connectHardware();
            createTrayIcon();
            m_timer.start();
            m_slowTimer.start();
            m_thermalBlinkTimer.start();
        });
    }

    ~MainWindow() override
    {
        m_diagnosticsLogTimer.stop();
        MystiqueLiveLog::uninstall();
        if (m_uploadThread.joinable()) {
            m_uploadThread.join();
        }

        if (globalDevice) {
            globalDevice->close();
            delete globalDevice;
            globalDevice = nullptr;
        }
    }

protected:
    void dragEnterEvent(QDragEnterEvent* e) override
    {
        if (e->mimeData()->hasUrls()) {
            for (const QUrl& url : e->mimeData()->urls()) {
                if (url.isLocalFile() && url.toLocalFile().endsWith(".gif", Qt::CaseInsensitive)) {
                    e->acceptProposedAction(); return;
                }
            }
        }
        e->ignore();
    }

    void dropEvent(QDropEvent* e) override
    {
        for (const QUrl& url : e->mimeData()->urls()) {
            const QString path = url.toLocalFile();
            if (path.endsWith(".gif", Qt::CaseInsensitive)) {
                importGif(m_selectedSlot, path);
                e->acceptProposedAction(); return;
            }
        }
    }

    // 🚀 SYSTEEMVAK: Wijziging F — HIER PLAKKEN!
    void closeEvent(QCloseEvent* e) override
    {
        if (m_trayIcon && m_trayIcon->isVisible()) {
            hide();

            // 🆕 Animaties pauzeren (CPU sparen)
            m_timer.stop();

            // m_slowTimer blijft draaien → TFT-metrics blijven live updaten

            // 🆕 Cache vrijgeven (GIF's worden toch niet getoond)
            for (int i = 0; i < GIF_SLOT_COUNT; ++i) {
                dropFramesFromCache(i);
            }

            m_trayIcon->showMessage(
                "DeepCool Mystique",
                "Programma draait op de achtergrond. Klik op het pictogram om te heropenen.",
                QSystemTrayIcon::Information,
                2500
            );
            e->ignore();
        } else {
            e->accept();
        }
    }


private:
    MystiqueMetrics::HardwareProfile m_hardwareProfile;
    // MYSTIQUE STEP 6B TWO-COLUMN DIAGNOSTICS v1
    // These labels display the already-collected Step 6A snapshot only.
    QWidget* m_diagnosticsTab = nullptr;
    QLabel* m_diagCpuVendor = nullptr;
    QLabel* m_diagCpuModel = nullptr;
    QLabel* m_diagGpuVendor = nullptr;
    QLabel* m_diagGpuPci = nullptr;
    QLabel* m_diagProfileCache = nullptr;
    // MYSTIQUE STEP 6C EIGHT METRICS SOURCES v1
    // Status presentation ONLY: the actual Metrics readers are untouched.
    QLabel* m_diagCpuSensor = nullptr;
    QLabel* m_diagCpuLoadSource = nullptr;
    QLabel* m_diagCpuClockSource = nullptr;
    QLabel* m_diagRamSource = nullptr;
    QLabel* m_diagGpuSensor = nullptr;
    QLabel* m_diagGpuLoadSensor = nullptr;
    QLabel* m_diagGpuClockSource = nullptr;
    QLabel* m_diagVramSource = nullptr;
    QLabel* m_diagUsbConnection = nullptr;
    QLabel* m_diagUsbDevice = nullptr;
    QLabel* m_diagUsbTarget = nullptr;
    QLabel* m_diagRecordedGifs = nullptr;
    QLabel* m_diagUncertainUploads = nullptr;
    QLabel* m_diagUncertainDeletes = nullptr;
    QLabel* m_diagDeleteJournal = nullptr;
    QLabel* m_diagGuiStatus = nullptr;
    QLabel* m_diagUpdated = nullptr;
    QPlainTextEdit* m_diagLiveLog = nullptr;
    QPointer<QDialog> m_diagPopupDialog;
    QPointer<QPlainTextEdit> m_diagPopupLog;
    QTimer m_diagnosticsLogTimer;
    // MYSTIQUE STEP 6E THERMAL ALERTS v1
    QTimer m_thermalBlinkTimer;
    MystiqueThermal::Monitor m_cpuThermalAlarm;
    MystiqueThermal::Monitor m_gpuThermalAlarm;
    bool m_thermalBlinkRed = false;
    QTimer m_timer;
    QTimer m_visualConfigTimer;
    QTimer m_slowTimer;
    QElapsedTimer m_secondTimer;
    QSystemTrayIcon* m_trayIcon = nullptr;
    qint64 m_lastHardwareUpdate = 0;
    QTabWidget* m_tabs = nullptr;
    QWidget* m_gifTab = nullptr;
    QWidget* m_metricsTab = nullptr;
    QLabel* m_status = nullptr;
    MetricCard* m_cpuTemp  = nullptr;
    MetricCard* m_cpuLoad  = nullptr;
    MetricCard* m_cpuClock = nullptr;
    MetricCard* m_ram      = nullptr;
    MetricCard* m_vram     = nullptr;
    MetricCard* m_gpuTemp  = nullptr;
    MetricCard* m_gpuLoad  = nullptr;
    MetricCard* m_gpuClock = nullptr;
    QWidget* m_previewContainer = nullptr;
    QLabel* m_pumpShell = nullptr;
    // MYSTIQUE STEP 4C - GUI RGB ZONES V1
    QLabel* m_rgbPreviewOverlay = nullptr; // Visual only, never USB
    MysticPreviewBrightnessShade* m_previewBrightnessShade = nullptr; // TFT only
    // The motherboard rainbow is a GUI-only simulation (no USB readback).
    QElapsedTimer m_motherboardRainbowClock;
    QLabel* m_preview = nullptr;
    QComboBox* m_mode = nullptr;
    QComboBox* m_rotation = nullptr;
    QCheckBox* m_gifSwitch = nullptr;
    QSlider* m_brightnessSlider = nullptr;
    QLabel* m_brightnessPercent = nullptr;
    QButtonGroup* m_rgbSwitchGroup = nullptr;
    QVector<GifDropWidget*> m_slotWidgets;
    QVector<QCheckBox*> m_slotChecks;

    QLabel* m_cropProgressLabel = nullptr;
    QProgressBar* m_cropProgress = nullptr;
    QPushButton* m_deleteButton = nullptr;
    QPushButton* m_cropCancelButton = nullptr;
    bool m_gifPreparationActive = false;
    bool m_uploadRunning = false;
    std::thread m_uploadThread;
    int m_selectedSlot = 0;
    bool m_updatingUi = false;
    // GUI STEP 3 - TFT PREVIEW MESSAGES V1
    // Waiting for the existing hardware selection ACK (not SD playback proof).
    bool m_previewWaitingForGifAck = false;

    void buildUi()
    {
        QWidget* central = new QWidget(this);
        auto* root = new QVBoxLayout(central);
        m_tabs = new QTabWidget;
        root->addWidget(m_tabs);
        m_status = new QLabel("Status: Stand-by");
        root->addWidget(m_status);
        setCentralWidget(central);

        buildGifTab();
        buildMetricsTab();
        buildDiagnosticsTab(); // MYSTIQUE STEP 6A READ-ONLY DIAGNOSTICS v1
        buildAboutTab();

        setStyleSheet(R"(
            QWidget { background:#1b1b1b; color:#e6e6e6; } /* GUI BACKGROUND MATCHES PUMP IMAGE */
            QGroupBox { border:1px solid #3d4148; border-radius:6px; margin-top:10px; padding:12px; }
            QGroupBox::title { subcontrol-origin:margin; left:10px; padding:0 5px; color:#00ab99; }
            QPushButton { background:#3d659f; border:none; border-radius:4px; padding:8px 14px; }
            QPushButton:hover { background:#4d79b8; }
            QComboBox, QDoubleSpinBox { background:#33373e; border:1px solid #4a4f57; padding:6px; }
            QTabBar::tab { background:#2c3035; padding:9px 18px; }
            QTabBar::tab:selected { background:#3d659f; }
            QProgressBar { border:1px solid #41464e; border-radius:4px; text-align:center; }
            QProgressBar::chunk { background:#00ab99; }
        )");
    }

    void buildGifTab()
    {
        m_gifTab = new QWidget;
        auto* layout = new QHBoxLayout(m_gifTab);

        // ============================================================
        // LINKERKANT: GIF SLOTS + KNOPPEN
        // ============================================================
        auto* left = new QVBoxLayout;

        auto* grid = new QGridLayout;
        grid->setHorizontalSpacing(12);
        grid->setVerticalSpacing(12);
        for (int i=0;i<GIF_SLOT_COUNT;i++) {
            auto* slot = new GifDropWidget(i);
            slot->dropped = [this](int s, const QString& p){ importGif(s,p); };
            auto* box = new QVBoxLayout;
            box->addWidget(slot);
            auto* select = new QCheckBox(QString("Actief"));
            connect(select, &QCheckBox::toggled, this, [this,i](bool checked){ if (checked) selectSlot(i); });
            m_slotChecks.append(select);
            box->addWidget(select);
            auto* container = new QWidget;
            container->setLayout(box);
            grid->addWidget(container, 0, i);
            m_slotWidgets.append(slot);
        }
        left->addLayout(grid);

        // Knoppen onder de slots
        auto* actions = new QHBoxLayout;

        m_deleteButton = new QPushButton("Delete Selected GIF");
        m_deleteButton->setStyleSheet("background:#a33b3b;");

        connect(
            m_deleteButton,
            &QPushButton::clicked,
            this,
            [this]{ deleteSelectedGif(); }
        );

        actions->addWidget(m_deleteButton);
        actions->addStretch();
        left->addLayout(actions);

        // Step 4A: place exclusive RGB mode switches below Delete.
        auto* rgbBox = new QWidget(m_gifTab); // GUI STEP 4A RGB SWITCH FIX / CLEAN PANELS
        auto* rgbLayout = new QVBoxLayout(rgbBox);
        rgbLayout->setContentsMargins(12, 6, 12, 10);
        rgbLayout->setSpacing(10);

        m_rgbSwitchGroup = new QButtonGroup(m_gifTab);
        // Custom QCheckBox switches: exclusivity is enforced explicitly below.
        m_rgbSwitchGroup->setExclusive(false);
        const QStringList rgbNames = {
            "Motherboard RGB", "Temperature RGB", "GIF Motion RGB"
        };
        for (int i = 0; i < rgbNames.size(); ++i) {
            auto* row = new QHBoxLayout;
            auto* text = new QLabel(rgbNames[i], rgbBox);
            auto* toggle = new MysticRgbSwitch(rgbBox);
            toggle->setAccessibleName(rgbNames[i]);
            if (i == 0) {
                // Only the motherboard mode uses a simulated preview.
                auto* labelColumn = new QWidget(rgbBox);
                auto* labelLayout = new QVBoxLayout(labelColumn);
                labelLayout->setContentsMargins(0, 0, 0, 0);
                labelLayout->setSpacing(1);
                labelLayout->addWidget(text);
                auto* simulation = new QLabel("(rgb simulation)", labelColumn);
                simulation->setStyleSheet(
                    "color:#99a1aa;font-size:10px;font-weight:300;");
                labelLayout->addWidget(simulation);
                row->addWidget(labelColumn);
            } else {
                row->addWidget(text);
            }
            row->addStretch();
            row->addWidget(toggle);
            rgbLayout->addLayout(row);
            m_rgbSwitchGroup->addButton(toggle, i);
            connect(toggle, &QAbstractButton::clicked,
                    this, [this, i](bool) {
                if (!m_rgbSwitchGroup) return;
                // Never leave multiple switches active, even if a previous
                // Qt checkbox group interaction left a stale visual state.
                for (int mode = 0; mode < 3; ++mode) {
                    if (!m_rgbSwitchGroup->button(mode)) return;
                }
                for (int mode = 0; mode < 3; ++mode) {
                    auto* button = m_rgbSwitchGroup->button(mode);
                    QSignalBlocker blocker(button);
                    button->setChecked(mode == i);
                    button->update();
                }

                QSettings settings("LionheartTim", "DeepCoolDigitalGui");
                settings.setValue("rgbEffectMode", i);
                settings.sync();
                if (settings.status() != QSettings::NoError) {
                    qWarning() << "[RGB-UI] Cannot save selected RGB mode:" << i;
                }
                // Update the preview immediately; hardware still uses debounce.
                updatePreview();
                m_visualConfigTimer.start();
            });
        }
        // One RGB mode is always selected; no combination is possible.
        const int initialRgb = qBound(0, QSettings(
            "LionheartTim", "DeepCoolDigitalGui"
        ).value("rgbEffectMode", 0).toInt(), 2);
        m_rgbSwitchGroup->button(initialRgb)->setChecked(true);
        left->addWidget(rgbBox);



            // Duwt de slots naar boven zodat er geen lege ruimte tussen zit
            left->addStretch();

            layout->addLayout(left, 2);

            // ============================================================
            // RECHTERKANT: INTERFACE CONFIGURATIE (zonder titel)
            // ============================================================
            auto* rightBox = new QWidget;
            rightBox->setFixedWidth(440);

            // Buitenste verticale layout voor de hele rechterbox
            auto* rightLayout = new QVBoxLayout(rightBox);
            rightLayout->setContentsMargins(12, 12, 12, 12);
            rightLayout->setSpacing(8);

            // ============================================================
            // BOVENSTE DEEL: formulier (mode, rotation, GIF)
            // ============================================================
            auto* form = new QFormLayout;
            form->setContentsMargins(0, 0, 0, 0);
            form->setLabelAlignment(Qt::AlignLeft);
            form->setFormAlignment(Qt::AlignHCenter | Qt::AlignTop);
            form->setFieldGrowthPolicy(QFormLayout::ExpandingFieldsGrow);

            m_mode = new QComboBox;
            m_mode->addItems({"CPU Focus (Default)","GPU Info Mode","Custom GIF Stream"});
            connect(m_mode, qOverload<int>(&QComboBox::currentIndexChanged), this, [this](int v){

                // STEP 3.3D-2C — Protect manual GIF mode selection.
                // Keep CPU/GPU Metrics available during recovery.

                if (v == 2 && gifDeleteJournalPending()) {
                    const int safeMode = currentModeIndex == 1 ? 1 : 0;
                    { QSignalBlocker blocker(m_mode);
                      m_mode->setCurrentIndex(safeMode); }
                    currentModeIndex = safeMode;
                    QSettings("LionheartTim", "DeepCoolDigitalGui")
                        .setValue("displayMode", safeMode);
                    if (m_gifSwitch) {
                        QSignalBlocker blocker(m_gifSwitch);
                        m_gifSwitch->setChecked(false);
                    }
                    QMessageBox::warning(this, "GIF Mode Blocked",
                        "An unfinished local GIF delete transaction must be "
                        "recovered before GIF mode can be activated.");
                    return;
                }
                if (v == 2) {
                    // STEP 4C-14C-4
                    // Block manual GIF activation while a hardware
                    // delete has an unresolved completion state.

                    int uncertainDeleteSlot = -1;

                    for (int i = 0; i < GIF_SLOT_COUNT; ++i) {
                        if (QFile::exists(deleteUncertainFlagPath(i))) {
                            uncertainDeleteSlot = i;
                            break;
                        }
                    }

                    if (uncertainDeleteSlot >= 0) {
                        const int safeMode =
                            (currentModeIndex == 1) ? 1 : 0;

                        {
                            QSignalBlocker blocker(m_mode);
                            m_mode->setCurrentIndex(safeMode);
                        }

                        currentModeIndex = safeMode;

                        QSettings settings(
                            "LionheartTim",
                            "DeepCoolDigitalGui"
                        );
                        settings.setValue("displayMode", safeMode);

                        if (m_gifSwitch) {
                            QSignalBlocker blocker(m_gifSwitch);
                            m_gifSwitch->setChecked(false);
                        }

                        qWarning()
                        << "[DELETE-SAFETY] Manual GIF mode blocked."
                        << "Unresolved delete slot:"
                        << uncertainDeleteSlot;

                        setStatus(
                            QString(
                                "GIF mode blocked: unresolved delete in slot %1."
                            ).arg(uncertainDeleteSlot + 1)
                        );

                        updatePreview();

                        QMessageBox::warning(
                            this,
                            "GIF Mode Blocked",
                            QString(
                                "A hardware GIF deletion in slot %1 "
                                "has not been verified.\n\n"
                                "GIF mode activation is temporarily blocked.\n"
                                "CPU and GPU Metrics remain available.\n"
                                "Existing GIF files are preserved."
                            ).arg(uncertainDeleteSlot + 1)
                        );

                        return;
                    }

                    int uncertainSlot = -1;

                    for (int i = 0; i < GIF_SLOT_COUNT; ++i) {
                        if (QFile::exists(uploadUncertainFlagPath(i))) {
                            uncertainSlot = i;
                            break;
                        }
                    }

                    if (uncertainSlot >= 0) {
                        const int safeMode =
                        (currentModeIndex == 1) ? 1 : 0;

                        {
                            QSignalBlocker blocker(m_mode);
                            m_mode->setCurrentIndex(safeMode);
                        }

                        currentModeIndex = safeMode;

                        QSettings settings(
                            "LionheartTim",
                            "DeepCoolDigitalGui"
                        );
                        settings.setValue("displayMode", safeMode);

                        if (m_gifSwitch) {
                            QSignalBlocker blocker(m_gifSwitch);
                            m_gifSwitch->setChecked(false);
                        }

                        qWarning()
                        << "[GIF-SAFETY] Manual GIF mode blocked."
                        << "Uncertain local slot:"
                        << uncertainSlot;

                        setStatus(
                            QString(
                                "GIF mode blocked: unresolved upload in slot %1."
                            ).arg(uncertainSlot + 1)
                        );

                        QMessageBox::warning(
                            this,
                            "GIF Mode Blocked",
                            "A previous GIF upload has an unresolved "
                            "hardware state.\n\n"
                            "GIF mode activation is temporarily blocked.\n"
                            "CPU and GPU Metrics remain available.\n\n"
                            "The existing GIF files have been preserved."
                        );

                        return;
                    }
                }

                currentModeIndex = v;
                QSettings s("LionheartTim","DeepCoolDigitalGui");
                s.setValue("displayMode", v);

                // 🆕 Mode naar Custom GIF → toggle automatisch aan
                if (v == 2) {
                    // Alleen als er een GIF geselecteerd is
                    if (lastSelectedGifSlot >= 0 &&
                        lastSelectedGifSlot < GIF_SLOT_COUNT &&
                        !gifSlots[lastSelectedGifSlot].path.isEmpty()) {

                        m_updatingUi = true;
                    m_gifSwitch->setChecked(true);
                    m_updatingUi = false;

                    // Show Loading until the normal hardware select returns ACK.
                    m_previewWaitingForGifAck = true;
                    // Cache laden voor de geselecteerde slot
                    loadFramesToCache(lastSelectedGifSlot);
                        }
                }

                // GUI STEP 1: Metrics schakelt GIF-preview uit.
                if (v == 0 || v == 1) {
                    m_previewWaitingForGifAck = false;
                    if (m_gifSwitch) {
                        QSignalBlocker blocker(m_gifSwitch);
                        m_gifSwitch->setChecked(false);
                    }
                }

                // Direct preview updaten
                updatePreview();
            });

                form->addRow("Set Display Mode:",m_mode);

                m_rotation = new QComboBox;
                m_rotation->addItems({"0 Degrees Normal","90 Degrees Clockwise","180 Degrees Inverted","270 Degrees Counter-Clockwise"});
                connect(m_rotation, qOverload<int>(&QComboBox::currentIndexChanged), this, [this](int v){
                    currentRotationIndex = v;
                    QSettings("LionheartTim","DeepCoolDigitalGui").setValue("rotation", v);
                    updatePreviewSize();
                    updatePreview();
                });
                form->addRow("Screen Rotation:",m_rotation);

                m_gifSwitch = new QCheckBox("GIF");
                connect(m_gifSwitch, &QCheckBox::toggled, this, [this](bool on){
                    if (m_updatingUi) return;

                    // 🆕 Toggle bepaalt ALLEEN de grote preview, niet de mode
                    // (mode wordt alleen via de dropdown gewijzigd)

                    // Als toggle aan maar geen GIF geselecteerd → terug naar uit
                    if (on) {
                        if (lastSelectedGifSlot < 0 ||
                            lastSelectedGifSlot >= GIF_SLOT_COUNT ||
                            gifSlots[lastSelectedGifSlot].path.isEmpty()) {

                            m_updatingUi = true;
                        m_gifSwitch->setChecked(false);
                        m_updatingUi = false;
                        return;
                            }

                            // Cache laden voor de geselecteerde slot
                            loadFramesToCache(lastSelectedGifSlot);
                    }

                    // Preview direct updaten
                    updatePreview();
                });
                form->addRow("Preview Mode:",m_gifSwitch);

                rightLayout->addLayout(form);

                // ============================================================
                // ONDERSTE DEEL: preview container GECENTREERD
                // ============================================================
                // PUMP SHELL / LIVE PREVIEW: aligned overlay v1
                m_previewContainer = new QWidget;
                m_previewContainer->setFixedSize(400, 400);
                m_previewContainer->setStyleSheet("background:transparent;");

                // Laag 1: originele pompbehuizing, meedraaiend met de schermrotatie.
                m_pumpShell = new QLabel(m_previewContainer);
                m_pumpShell->setAlignment(Qt::AlignCenter);
                m_pumpShell->setAttribute(Qt::WA_TransparentForMouseEvents);
                m_pumpShell->setStyleSheet("background:transparent;");

                // Laag 2: bestaande dynamische GIF / Metrics pixmap.
                // Het genereren van deze pixmap elders in main_gui.cpp blijft onaangeroerd.
                m_preview = new QLabel(m_previewContainer);
                m_preview->setAlignment(Qt::AlignCenter);
                m_preview->setStyleSheet("background:#000000; border:1px solid #22282d; border-radius:3px;");
                m_preview->raise();
                // Child overlay only darkens the TFT content, never the pump shell
                // or the 14 external RGB LEDs. It does not modify any source image.
                m_previewBrightnessShade = new MysticPreviewBrightnessShade(m_preview);
                m_previewBrightnessShade->setGeometry(
                    m_preview->rect().adjusted(1, 1, -1, -1));
                m_previewBrightnessShade->raise();

                // 14 visual RGB zones are drawn OUTSIDE the TFT image.
                // The transparent layer never receives mouse input.
                m_rgbPreviewOverlay = new QLabel(m_previewContainer);
                m_rgbPreviewOverlay->setGeometry(0, 0, 400, 400);
                m_rgbPreviewOverlay->setAttribute(Qt::WA_TransparentForMouseEvents);
                m_rgbPreviewOverlay->setAttribute(Qt::WA_TranslucentBackground);
                m_rgbPreviewOverlay->setStyleSheet("background:transparent;");
                m_rgbPreviewOverlay->raise();

                // Centreer de container horizontaal in de rightBox
                rightLayout->addWidget(m_previewContainer, 0, Qt::AlignHCenter);

                // Step 4A: TFT brightness directly below the pump preview.
                auto* brightnessBlock = new QVBoxLayout;
                brightnessBlock->setContentsMargins(16, 0, 16, 0);
                brightnessBlock->setSpacing(5);
                auto* brightnessHeader = new QHBoxLayout;
                brightnessHeader->addWidget(new QLabel("Brightness:", rightBox));
                brightnessHeader->addStretch();
                m_brightnessPercent = new QLabel(rightBox);
                brightnessHeader->addWidget(m_brightnessPercent);
                brightnessBlock->addLayout(brightnessHeader);

                m_brightnessSlider = new QSlider(Qt::Horizontal, rightBox);
                m_brightnessSlider->setRange(0, 100);
                m_brightnessSlider->setSingleStep(1);
                m_brightnessSlider->setPageStep(5);
                m_brightnessSlider->setValue(qBound(0, QSettings(
                    "LionheartTim", "DeepCoolDigitalGui"
                ).value("screenBrightness", 70).toInt(), 100));
                m_brightnessPercent->setText(
                    QString::number(m_brightnessSlider->value()) + "%");
                m_previewBrightnessShade->setBrightness(m_brightnessSlider->value());
                connect(m_brightnessSlider, &QSlider::valueChanged,
                        this, [this](int value) {
                    m_brightnessPercent->setText(
                        QString::number(value) + "%");
                    if (m_previewBrightnessShade)
                        m_previewBrightnessShade->setBrightness(value);
                    QSettings settings("LionheartTim", "DeepCoolDigitalGui");
                    settings.setValue("screenBrightness", value);
                    settings.sync();
                    if (settings.status() != QSettings::NoError) {
                        qWarning() << "[BRIGHTNESS-UI] Cannot save brightness:" << value;
                    }
                    // Apply on a short debounce; slider remains responsive.
                    m_visualConfigTimer.start();
                });
                brightnessBlock->addWidget(m_brightnessSlider);
                rightLayout->addLayout(brightnessBlock);


                // Duwt alles naar boven, en laat de lege ruimte ONDER de container
                rightLayout->addStretch();

                layout->addWidget(rightBox, 1);

                m_tabs->addTab(m_gifTab,"Schermbeheer & GIF");
    }

    MetricCard* metricCard(const QString& title,
                           const QString& unit,
                           float yMax,
                           QColor color,
                           const float* history)
    {
        return new MetricCard(title, unit, yMax, color,
                              history, HISTORY_POINTS);
    }

    void buildMetricsTab()
    {
        m_metricsTab = new QWidget;
        auto* grid = new QGridLayout(m_metricsTab);
        grid->setSpacing(10);

        m_cpuTemp  = metricCard("CPU Temperature", "°C",  100.0f, QColor(231,  76,  60), cpuTempHistory);
        m_cpuLoad  = metricCard("CPU Load",        "%",   100.0f, QColor(255, 152,   0), cpuLoadHistory);
        m_cpuClock = metricCard("CPU Clock",       "GHz",   6.0f, QColor(241, 196,  15), cpuClockHistory);
        m_ram      = metricCard("RAM Usage",       "%",   100.0f, QColor( 46, 204, 113), ramUsageHistory);
        m_vram = metricCard(
            "VRAM Usage", "%", 100.0f,
            QColor(0, 171, 153), vramUsageHistory
        );
        m_vram->setValueText("N/A");
        m_gpuTemp  = metricCard("GPU Temperature", "°C",  100.0f, QColor( 52, 152, 219), gpuTempHistory);
        m_gpuLoad  = metricCard("GPU Load",        "%",   100.0f, QColor(155,  89, 182), gpuLoadHistory);
        m_gpuClock = metricCard("GPU Clock",       "GHz",   3.0f, QColor(231,  76, 160), gpuClockHistory);

        grid->addWidget(m_cpuTemp,  0, 0);
        grid->addWidget(m_cpuLoad,  1, 0);
        grid->addWidget(m_cpuClock, 2, 0);
        grid->addWidget(m_ram,      3, 0);
        grid->addWidget(m_vram,     3, 1);
        grid->addWidget(m_gpuTemp,  0, 1);
        grid->addWidget(m_gpuLoad,  1, 1);
        grid->addWidget(m_gpuClock, 2, 1);

        m_tabs->addTab(m_metricsTab,"Systeem Metrics");
    }

    // STEP 6E: alerting is separated from the existing Metrics readers.
    // Re-read ONLY the already-selected temperature sensor, read-only, once/sec.
    void refreshThermalSourceColors()
    {
        const auto apply = [this](QLabel* label, bool alarm, const std::string& source) {
            if (!label) return;
            const bool exists = !source.empty() &&
                QFileInfo::exists(QString::fromStdString(source));
            const QString color = alarm && m_thermalBlinkRed
                ? QStringLiteral("#ff4141")
                : (exists ? QStringLiteral("#9bd9c8") : QStringLiteral("#ecc184"));
            label->setStyleSheet(QStringLiteral("color:%1;%2").arg(
                color, alarm ? QStringLiteral("font-weight:700;")
                             : QStringLiteral("font-weight:normal;")));
        };
        apply(m_diagCpuSensor, m_cpuThermalAlarm.alarming(), globalCpuTempPath);
        apply(m_diagGpuSensor, m_gpuThermalAlarm.alarming(), globalGpuTempPath);
    }

    void thermalNotification(const QString& component,
                             MystiqueThermal::Transition event)
    {
        if (!event.newAlert && !event.recovered) return;
        const QString value = QString::number(event.celsius, 'f', 1);
        if (event.recovered) {
            qInfo().noquote() << "[THERMAL]" << component
                              << "temperature recovered:" << value << "C";
            return;
        }
        const QString tier = event.level == MystiqueThermal::Level::Emergency
            ? QStringLiteral("EMERGENCY") :
            event.level == MystiqueThermal::Level::Critical
            ? QStringLiteral("CRITICAL") : QStringLiteral("WARNING");
        const QString title = QStringLiteral("DeepCool MYSTIQUE - %1 %2").arg(
            component, tier);
        const QString detail = QStringLiteral(
            "%1 temperature: %2 C. Check cooling immediately. "
            "This is a temperature warning, not proof of throttling.").arg(
            component, value);
        if (event.level == MystiqueThermal::Level::Warning)
            qWarning().noquote() << "[THERMAL]" << tier << detail;
        else
            qCritical().noquote() << "[THERMAL]" << tier << detail;

        // Plasma can keep CRITICAL notifications above fullscreen windows
        // when the user enables this option in Notifications settings.
        // Launch with an argument list: NEVER via shell expansion.
        const QString notifySend = QStandardPaths::findExecutable(
            QStringLiteral("notify-send"));
        bool notified = false;
        if (!notifySend.isEmpty()) {
            const QStringList args = {
                QStringLiteral("-u"), QStringLiteral("critical"),
                QStringLiteral("-a"), QStringLiteral("DeepCool MYSTIQUE"),
                QStringLiteral("-i"), QStringLiteral("io.github.lionhearttim.deepcool-gui"),
                title, detail
            };
            notified = QProcess::startDetached(notifySend, args);
        }
        // Fallback to existing tray icon; visibility over games is not assured.
        if (!notified && m_trayIcon && m_trayIcon->isVisible())
            m_trayIcon->showMessage(title, detail, QSystemTrayIcon::Critical, 15000);
    }

    void evaluateThermalAlarms()
    {
        const auto cpu = MystiqueThermal::readSensor(globalCpuTempPath);
        const auto gpu = MystiqueThermal::readSensor(globalGpuTempPath);
        thermalNotification(QStringLiteral("CPU"), m_cpuThermalAlarm.tick(cpu, true));
        thermalNotification(QStringLiteral("GPU"), m_gpuThermalAlarm.tick(gpu, false));
        // No auto-shutdown. Until explicit opt-in + source validation is proven,
        // silently powering off a user's machine would risk data loss.
        refreshThermalSourceColors();
    }

    // MYSTIQUE STEP 6B TWO-COLUMN DIAGNOSTICS v1
    // Existing Step 6A snapshot only. No additional USB or sensor requests.
    void refreshDiagnostics()
    {
        if (!m_diagCpuVendor || !m_diagUsbConnection) return;

        MystiqueDiagnostics::Snapshot snapshot;
        snapshot.usbOpen = globalDevice && globalDevice->isOpen();
        snapshot.usbName = snapshot.usbOpen
            ? globalDevice->getDeviceName() : QStringLiteral("Not connected");
        snapshot.cpuVendor = m_hardwareProfile.cpuVendor;
        snapshot.cpuModel = m_hardwareProfile.cpuModel;
        snapshot.gpuVendor = m_hardwareProfile.gpuVendor;
        snapshot.gpuIdentifiers = m_hardwareProfile.pciGpus;
        snapshot.profileFromCache = m_hardwareProfile.cached;
        snapshot.cpuTemperatureSource = QString::fromStdString(globalCpuTempPath);
        snapshot.gpuTemperatureSource = QString::fromStdString(globalGpuTempPath);
        snapshot.gpuLoadSource = QString::fromStdString(globalGpuLoadPath);
        snapshot.lastGuiStatus = m_status ? m_status->text() : QString();
        snapshot.pendingDeleteJournal = QFile::exists(gifDeleteJournalPath());

        for (int slot = 0; slot < GIF_SLOT_COUNT; ++slot) {
            if (gifSlots[slot].uploadedToHardware)
                ++snapshot.locallyRecordedGifs;
            if (QFile::exists(uploadUncertainFlagPath(slot)))
                ++snapshot.uncertainUploads;
            if (QFile::exists(deleteUncertainFlagPath(slot)))
                ++snapshot.uncertainDeletes;
        }

        m_diagCpuVendor->setText(MystiqueDiagnostics::readable(snapshot.cpuVendor));
        m_diagCpuModel->setText(MystiqueDiagnostics::readable(snapshot.cpuModel));
        m_diagGpuVendor->setText(MystiqueDiagnostics::readable(snapshot.gpuVendor));
        m_diagGpuPci->setText(snapshot.gpuIdentifiers.isEmpty()
            ? QStringLiteral("N/A") : snapshot.gpuIdentifiers.join(QStringLiteral(", ")));
        m_diagProfileCache->setText(snapshot.profileFromCache
            ? QStringLiteral("Loaded from cache")
            : QStringLiteral("Detected this run"));

        // MYSTIQUE STEP 6C EIGHT METRICS SOURCES v1
        // Only show configured paths and their existence; never re-read sensors.
        // Short paths fit in eight single-line rows. Tooltip keeps full details.
        const auto showPath = [](QLabel* output, const QString& path) {
            const bool present = !path.isEmpty() && QFileInfo::exists(path);
            QString compact = path;
            if (path.startsWith(QStringLiteral("/sys/"))) {
                const QFileInfo info(path);
                if (path.contains(QStringLiteral("/card")) &&
                    path.contains(QStringLiteral("/device/"))) {
                    compact = path.section(QStringLiteral("/device/"), 0, 0)
                                  .section(QLatin1Char('/'), -1) +
                              QLatin1Char('/') + info.fileName();
                } else {
                    compact = info.dir().dirName() + QLatin1Char('/') + info.fileName();
                }
            }
            output->setText(path.isEmpty()
                ? QStringLiteral("Not configured")
                : (present ? QStringLiteral("Present · ") : QStringLiteral("Missing · ")) + compact);
            output->setToolTip(path.isEmpty()
                ? QStringLiteral("No source was selected by the Metrics module.")
                : path + QStringLiteral("\nPresence does not prove accurate readings."));
            output->setStyleSheet(present
                ? QStringLiteral("color:#9bd9c8;")
                : QStringLiteral("color:#ecc184;"));
        };
        const auto showDescription = [](QLabel* output, const QString& label,
                                        const QString& detail, bool available) {
            output->setText(label);
            output->setToolTip(detail);
            output->setStyleSheet(available
                ? QStringLiteral("color:#9bd9c8;")
                : QStringLiteral("color:#ecc184;"));
        };

        // Four shared/CPU Metrics sources. No extra sampling or polling.
        showPath(m_diagCpuSensor, snapshot.cpuTemperatureSource);
        showPath(m_diagCpuLoadSource, QStringLiteral("/proc/stat"));
        showPath(m_diagCpuClockSource, QStringLiteral("/proc/cpuinfo"));
        showPath(m_diagRamSource, QStringLiteral("/proc/meminfo"));

        // GPU sources reflect the selected reader. NVIDIA exposes query data
        // through nvidia-smi; sysfs sources are reported only where applicable.
        if (snapshot.gpuVendor.compare(QStringLiteral("nvidia"), Qt::CaseInsensitive) == 0
            || hasNvidiaGpu) {
            const QString message = hasNvidiaGpu
                ? QStringLiteral("Configured · nvidia-smi")
                : QStringLiteral("Unavailable · nvidia-smi");
            const auto nvidiaSource = [&](QLabel* output, const QString& fields) {
                showDescription(output, message,
                    QStringLiteral("Command: nvidia-smi\nQuery: ") + fields +
                    QStringLiteral("\nThis diagnostics tab does not execute the command."),
                    hasNvidiaGpu);
            };
            nvidiaSource(m_diagGpuSensor, QStringLiteral("temperature.gpu"));
            nvidiaSource(m_diagGpuLoadSensor, QStringLiteral("utilization.gpu"));
            nvidiaSource(m_diagGpuClockSource, QStringLiteral("clocks.current.graphics"));
            nvidiaSource(m_diagVramSource, QStringLiteral("memory.used,memory.total"));
        } else {
            showPath(m_diagGpuSensor, snapshot.gpuTemperatureSource);
            showPath(m_diagGpuLoadSensor, snapshot.gpuLoadSource);

            // This is the same active card directory derivation used by the
            // Step 5B AMD and Intel GPU readers; no directory scan is needed.
            const QString cardDevice = snapshot.gpuLoadSource.isEmpty()
                ? QStringLiteral("/sys/class/drm/card0/device")
                : QFileInfo(snapshot.gpuLoadSource).absolutePath();
            const QString amdClock = cardDevice + QStringLiteral("/pp_dpm_sclk");
            const QString intelClock = cardDevice + QStringLiteral("/gt_cur_freq_mhz");
            if (snapshot.gpuVendor.compare(QStringLiteral("intel"), Qt::CaseInsensitive) == 0) {
                showPath(m_diagGpuClockSource, intelClock);
                showDescription(m_diagVramSource,
                    QStringLiteral("N/A · Intel GPU module"),
                    QStringLiteral("This Intel reader does not expose a reliable VRAM usage percentage."),
                    false);
            } else if (snapshot.gpuVendor.compare(QStringLiteral("amd"), Qt::CaseInsensitive) == 0) {
                showPath(m_diagGpuClockSource,
                    QFileInfo::exists(amdClock) ? amdClock :
                    (QFileInfo::exists(intelClock) ? intelClock : amdClock));
                // The existing proven AMD VRAM reader dynamically finds a DRM
                // card with BOTH of the following sysfs counters. These two
                // paths are candidate sources, not guaranteed readback proof.
                const QString used = cardDevice + QStringLiteral("/mem_info_vram_used");
                const QString total = cardDevice + QStringLiteral("/mem_info_vram_total");
                const bool both = QFileInfo::exists(used) && QFileInfo::exists(total);
                showDescription(m_diagVramSource,
                    both ? QStringLiteral("Present · VRAM used / total")
                         : QStringLiteral("Not found here · VRAM counters"),
                    QStringLiteral("Expected active GPU sources:\n") + used +
                    QLatin1Char('\n') + total +
                    QStringLiteral("\nAMD Metrics may find another DRM card dynamically."),
                    both);
            } else {
                showDescription(m_diagGpuClockSource,
                    QStringLiteral("N/A · unknown GPU"),
                    QStringLiteral("No vendor-specific GPU clock source is identified."), false);
                showDescription(m_diagVramSource,
                    QStringLiteral("N/A · unknown GPU"),
                    QStringLiteral("No vendor-specific VRAM source is identified."), false);
            }
        }

        m_diagUsbConnection->setText(snapshot.usbOpen
            ? QStringLiteral("Connected") : QStringLiteral("Not connected"));
        m_diagUsbConnection->setStyleSheet(snapshot.usbOpen
            ? QStringLiteral("color:#9bd9c8;font-weight:600;")
            : QStringLiteral("color:#ecc184;font-weight:600;"));
        m_diagUsbDevice->setText(MystiqueDiagnostics::readable(snapshot.usbName));
        m_diagUsbTarget->setText(QStringLiteral("MYSTIQUE 360 ARGB · 3633:0009"));

        m_diagRecordedGifs->setText(QString::number(snapshot.locallyRecordedGifs));
        m_diagUncertainUploads->setText(QString::number(snapshot.uncertainUploads));
        m_diagUncertainDeletes->setText(QString::number(snapshot.uncertainDeletes));
        m_diagDeleteJournal->setText(snapshot.pendingDeleteJournal
            ? QStringLiteral("Present — review required")
            : QStringLiteral("Not present"));
        const auto flagColor = [](QLabel* output, bool warning) {
            output->setStyleSheet(warning
                ? QStringLiteral("color:#efb37e;font-weight:600;")
                : QStringLiteral("color:#dce5ed;"));
        };
        flagColor(m_diagUncertainUploads, snapshot.uncertainUploads > 0);
        flagColor(m_diagUncertainDeletes, snapshot.uncertainDeletes > 0);
        flagColor(m_diagDeleteJournal, snapshot.pendingDeleteJournal);

        m_diagGuiStatus->setText(MystiqueDiagnostics::readable(snapshot.lastGuiStatus));
        m_diagUpdated->setText(QDateTime::currentDateTime().toString(QStringLiteral("HH:mm:ss")));
    }

    // Step 6D: popup stays synchronized with the bottom 50-line log.
    void openDiagnosticsLogWindow()
    {
        if (!m_diagLiveLog) return;
        if (m_diagPopupDialog) {
            m_diagPopupDialog->show();
            m_diagPopupDialog->raise();
            m_diagPopupDialog->activateWindow();
            return;
        }
        auto* dialog = new QDialog(this, Qt::Window);
        m_diagPopupDialog = dialog;
        dialog->setAttribute(Qt::WA_DeleteOnClose, true);
        dialog->setWindowTitle(QStringLiteral("Diagnostics - Live Event Log"));
        dialog->resize(920, 480);
        auto* layout = new QVBoxLayout(dialog);
        auto* note = new QLabel(QStringLiteral(
            "Most recent 50 Qt application events. No USB or SD tests are performed."),
            dialog);
        note->setStyleSheet(QStringLiteral("color:#9faab5;"));
        layout->addWidget(note);
        auto* view = new QPlainTextEdit(dialog);
        m_diagPopupLog = view;
        view->setReadOnly(true);
        view->setMaximumBlockCount(50);
        view->setFont(QFontDatabase::systemFont(QFontDatabase::FixedFont));
        view->setStyleSheet(QStringLiteral(
            "QPlainTextEdit{background:#16191d;color:#dce5ed;"
            "border:1px solid #414750;border-radius:5px;padding:5px;}"));
        view->setPlainText(m_diagLiveLog->toPlainText());
        layout->addWidget(view, 1);
        dialog->show();
    }

    void buildDiagnosticsTab()
    {
        m_diagnosticsTab = new QWidget;

        auto* root = new QVBoxLayout(m_diagnosticsTab);
        root->setContentsMargins(12, 10, 12, 10);
        root->setSpacing(8);

        auto* header = new QHBoxLayout;
        header->setSpacing(8);

        auto* heading = new QVBoxLayout;
        heading->setSpacing(1);

        auto* title = new QLabel(QStringLiteral("System Diagnostics"), m_diagnosticsTab);
        title->setStyleSheet(QStringLiteral(
            "font-size:18px;font-weight:650;color:#00c1af;"));

        auto* subtitle = new QLabel(
            QStringLiteral("Read-only overview · no device or SD tests"),
                                    m_diagnosticsTab);
        subtitle->setStyleSheet(QStringLiteral(
            "color:#9faab5;font-size:11px;"));
        subtitle->setWordWrap(true);

        heading->addWidget(title);
        heading->addWidget(subtitle);

        header->addLayout(heading, 1);

        auto* refresh = new QPushButton(QStringLiteral("Refresh status"), m_diagnosticsTab);
        refresh->setToolTip(QStringLiteral(
            "Refresh existing status without sending USB or SD commands."));
        header->addWidget(refresh, 0, Qt::AlignVCenter);

        connect(refresh, &QPushButton::clicked, this,
                [this]() { refreshDiagnostics(); });

        root->addLayout(header);

        struct Panel { QGroupBox* box; QVBoxLayout* rows; };

        auto makePanel = [this](const QString& caption) -> Panel {
            auto* box = new QGroupBox(caption, m_diagnosticsTab);
            box->setStyleSheet(QStringLiteral(
                "QGroupBox{background:#23262b;border:1px solid #414750;"
                "border-radius:8px;margin-top:10px;padding:3px;}"
                "QGroupBox::title{subcontrol-origin:margin;left:12px;"
                "padding:0 6px;color:#00b6a4;font-weight:600;}"));

            auto* rows = new QVBoxLayout(box);
            rows->setContentsMargins(10, 14, 10, 9);
            rows->setSpacing(6);

            return {box, rows};
        };

        auto addField = [this](QVBoxLayout* rows,
                               const QString& name,
                               QLabel*& output) {
            auto* row = new QHBoxLayout;
            row->setSpacing(8);

            auto* field = new QLabel(name, m_diagnosticsTab);
            field->setFixedWidth(108);
            field->setAlignment(Qt::AlignLeft | Qt::AlignTop);
            field->setStyleSheet(QStringLiteral("color:#aeb8c3;"));

            output = new QLabel(QStringLiteral("—"), m_diagnosticsTab);
            output->setTextFormat(Qt::PlainText);
            output->setWordWrap(true);
            output->setAlignment(Qt::AlignLeft | Qt::AlignTop);
            output->setTextInteractionFlags(Qt::TextSelectableByMouse);
            output->setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Preferred);
            output->setStyleSheet(QStringLiteral("color:#dce5ed;"));

            row->addWidget(field);
            row->addWidget(output, 1);
            rows->addLayout(row);
                               };

                               auto addStaticField = [this](QVBoxLayout* rows,
                                                            const QString& name,
                                                            const QString& value,
                                                            const QString& valueStyle = QStringLiteral("color:#dce5ed;")) {
                                   auto* row = new QHBoxLayout;
                                   row->setSpacing(8);

                                   auto* field = new QLabel(name, m_diagnosticsTab);
                                   field->setFixedWidth(108);
                                   field->setAlignment(Qt::AlignLeft | Qt::AlignTop);
                                   field->setStyleSheet(QStringLiteral("color:#aeb8c3;"));

                                   auto* output = new QLabel(value, m_diagnosticsTab);
                                   output->setTextFormat(Qt::PlainText);
                                   output->setWordWrap(true);
                                   output->setAlignment(Qt::AlignLeft | Qt::AlignTop);
                                   output->setTextInteractionFlags(Qt::TextSelectableByMouse);
                                   output->setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Preferred);
                                   output->setStyleSheet(valueStyle);

                                   row->addWidget(field);
                                   row->addWidget(output, 1);
                                   rows->addLayout(row);
                                                            };

                                                            auto addNote = [this](QVBoxLayout* rows, const QString& message) {
                                                                auto* note = new QLabel(message, m_diagnosticsTab);
                                                                note->setWordWrap(true);
                                                                note->setTextFormat(Qt::PlainText);
                                                                note->setStyleSheet(QStringLiteral(
                                                                    "color:#929da8;font-size:11px;"));
                                                                rows->addWidget(note);
                                                            };

                                                            auto* columns = new QHBoxLayout;
                                                            columns->setSpacing(12);

                                                            auto* left = new QVBoxLayout;
                                                            auto* right = new QVBoxLayout;
                                                            left->setSpacing(8);
                                                            right->setSpacing(8);

                                                            columns->addLayout(left, 1);
                                                            columns->addLayout(right, 1);

                                                            root->addLayout(columns, 1);

                                                            // ============================================================
                                                            // LEFT COLUMN
                                                            // ============================================================

                                                            auto overview = makePanel(QStringLiteral("SYSTEM OVERVIEW"));
                                                            addField(overview.rows, QStringLiteral("CPU vendor"), m_diagCpuVendor);
                                                            addField(overview.rows, QStringLiteral("CPU model"), m_diagCpuModel);
                                                            addField(overview.rows, QStringLiteral("GPU vendor"), m_diagGpuVendor);
                                                            addField(overview.rows, QStringLiteral("GPU PCI IDs"), m_diagGpuPci);
                                                            addField(overview.rows, QStringLiteral("Profile"), m_diagProfileCache);
                                                            addField(overview.rows, QStringLiteral("Connection"), m_diagUsbConnection);
                                                            addField(overview.rows, QStringLiteral("Device"), m_diagUsbDevice);
                                                            addField(overview.rows, QStringLiteral("USB target"), m_diagUsbTarget);
                                                            addField(overview.rows, QStringLiteral("Current status"), m_diagGuiStatus);
                                                            addField(overview.rows, QStringLiteral("Refreshed at"), m_diagUpdated);
                                                            addNote(overview.rows, QStringLiteral(
                                                                "An open USB handle does not confirm SD-card health."));
                                                            left->addWidget(overview.box);

                                                            auto sensors = makePanel(QStringLiteral("ACTIVE SENSOR SOURCES"));
                                                            addField(sensors.rows, QStringLiteral("CPU temperature"), m_diagCpuSensor);
                                                            addField(sensors.rows, QStringLiteral("CPU load"), m_diagCpuLoadSource);
                                                            addField(sensors.rows, QStringLiteral("CPU clock"), m_diagCpuClockSource);
                                                            addField(sensors.rows, QStringLiteral("RAM usage"), m_diagRamSource);
                                                            addField(sensors.rows, QStringLiteral("GPU temperature"), m_diagGpuSensor);
                                                            addField(sensors.rows, QStringLiteral("GPU load"), m_diagGpuLoadSensor);
                                                            addField(sensors.rows, QStringLiteral("GPU clock"), m_diagGpuClockSource);
                                                            addField(sensors.rows, QStringLiteral("VRAM usage"), m_diagVramSource);

                                                            for (auto* output : {m_diagCpuSensor, m_diagCpuLoadSource,
                                                                m_diagCpuClockSource, m_diagRamSource,
                                                                m_diagGpuSensor, m_diagGpuLoadSensor,
                                                                m_diagGpuClockSource, m_diagVramSource}) {
                                                                output->setWordWrap(false);
                                                                output->setMinimumWidth(0);
                                                                output->setSizePolicy(QSizePolicy::Ignored, QSizePolicy::Preferred);
                                                                }

                                                                addNote(sensors.rows, QStringLiteral(
                                                                    "Source presence does not guarantee correct readings. Hover for full paths."));
                                                                left->addWidget(sensors.box);

                                                                left->addStretch();

                                                                // ============================================================
                                                                // RIGHT COLUMN
                                                                // ============================================================

                                                                auto media = makePanel(QStringLiteral("LOCAL MEDIA & STORAGE"));
                                                                addField(media.rows, QStringLiteral("Recorded GIFs"), m_diagRecordedGifs);
                                                                addField(media.rows, QStringLiteral("Upload warnings"), m_diagUncertainUploads);
                                                                addField(media.rows, QStringLiteral("Delete warnings"), m_diagUncertainDeletes);
                                                                addField(media.rows, QStringLiteral("Delete journal"), m_diagDeleteJournal);
                                                                addStaticField(media.rows, QStringLiteral("SD card"), QStringLiteral("Not checked"),
                                                                               QStringLiteral("color:#ecc184;font-weight:600;"));
                                                                addNote(media.rows, QStringLiteral(
                                                                    "Local records do not confirm files stored on the TFT SD card."));
                                                                addNote(media.rows, QStringLiteral(
                                                                    "No validated read-only SD protocol is active. "
                                                                    "No reset, format, delete or write actions are available here."));
                                                                right->addWidget(media.box);

                                                                right->addStretch();

                                                                // ============================================================
                                                                // BOTTOM LOG PANEL
                                                                // ============================================================

                                                                auto* logPanel = new QGroupBox(QStringLiteral("LIVE EVENT LOG"), m_diagnosticsTab);
                                                                logPanel->setStyleSheet(QStringLiteral(
                                                                    "QGroupBox{background:#23262b;border:1px solid #414750;"
                                                                    "border-radius:8px;margin-top:10px;padding:3px;}"
                                                                    "QGroupBox::title{subcontrol-origin:margin;left:12px;"
                                                                    "padding:0 6px;color:#00b6a4;font-weight:600;}"));

                                                                auto* logLayout = new QVBoxLayout(logPanel);
                                                                logLayout->setContentsMargins(10, 14, 10, 8);
                                                                logLayout->setSpacing(4);

                                                                auto* logHeader = new QHBoxLayout;
                                                                auto* logHint = new QLabel(
                                                                    QStringLiteral("Latest 50 events  -  oldest removed automatically"),
                                                                                           logPanel);
                                                                logHint->setStyleSheet(QStringLiteral("color:#9faab5;font-size:11px;"));
                                                                logHeader->addWidget(logHint);
                                                                logHeader->addStretch();

                                                                auto* openLog = new QPushButton(QStringLiteral("Open in Window"), logPanel);
                                                                openLog->setToolTip(QStringLiteral(
                                                                    "Open the same rolling log in a larger window."));
                                                                openLog->setMaximumHeight(26);
                                                                logHeader->addWidget(openLog);

                                                                connect(openLog, &QPushButton::clicked, this,
                                                                        [this]() { openDiagnosticsLogWindow(); });

                                                                logLayout->addLayout(logHeader);

                                                                m_diagLiveLog = new QPlainTextEdit(logPanel);
                                                                m_diagLiveLog->setReadOnly(true);
                                                                m_diagLiveLog->setMaximumBlockCount(50);
                                                                m_diagLiveLog->setPlaceholderText(QStringLiteral("Waiting for events..."));
                                                                m_diagLiveLog->setFont(QFontDatabase::systemFont(QFontDatabase::FixedFont));
                                                                m_diagLiveLog->setStyleSheet(QStringLiteral(
                                                                    "QPlainTextEdit{background:#16191d;color:#dce5ed;"
                                                                    "border:1px solid #414750;border-radius:5px;padding:3px;}"));
                                                                m_diagLiveLog->setFixedHeight(62);

                                                                logLayout->addWidget(m_diagLiveLog);
                                                                root->addWidget(logPanel, 0);

                                                                m_tabs->addTab(m_diagnosticsTab, QStringLiteral("Diagnostics"));

                                                                connect(m_tabs, &QTabWidget::currentChanged, this,
                                                                        [this](int index) {
                                                                            if (!m_tabs || m_tabs->widget(index) != m_diagnosticsTab)
                                                                                return;
                                                                            refreshDiagnostics();
                                                                        });
    }

    void buildAboutTab()
    {
        auto* tab = new QWidget;
        auto* l = new QVBoxLayout(tab);
        auto* title = new QLabel("DEEPCOOL MYSTIQUE CONTROL HUB");
        title->setStyleSheet("font-size:20px;font-weight:bold;color:#00ab99;");
        l->addWidget(title);
        l->addWidget(new QLabel("Version: 1.3"));
        l->addWidget(new QLabel("Developed by: LionheartTim"));
        auto* github = new QPushButton("Open GitHub: LionheartTim");
        connect(github,&QPushButton::clicked,[]{ QDesktopServices::openUrl(QUrl("https://github.com/LionheartTim")); });
        l->addWidget(github);
        l->addWidget(new QLabel("License: Open Source Linux Driver"));
        l->addWidget(new QLabel("Core Engine: Qt6 Widgets & JZFS Hardware Layer"));
        // MYSTIQUE KDE AUTOSTART IN APP v1 — local desktop setting only.
        auto* kdeAutostart = new QCheckBox(
            "Start with KDE Plasma (minimized to system tray)", tab);
        kdeAutostart->setChecked(MystiqueAutoStart::enabled());
        connect(kdeAutostart, &QCheckBox::toggled, this,
                [this, kdeAutostart](bool requested) {
            QString error;
            if (!MystiqueAutoStart::change(requested, error)) {
                const QSignalBlocker block(kdeAutostart);
                kdeAutostart->setChecked(!requested);
                QMessageBox::warning(this, "KDE Autostart", error);
            }
        });
        l->addWidget(kdeAutostart);
        l->addStretch();
        m_tabs->addTab(tab,"About");
    }

    void loadSettingsAndSlots()
    {
        QSettings s("LionheartTim","DeepCoolDigitalGui");
        currentRotationIndex = std::clamp(s.value("rotation",3).toInt(),0,3);

        // GUI STEP 1: Restore the last selected display mode.
        // 0 = CPU Metrics, 1 = GPU Metrics, 2 = Custom GIF.
        currentModeIndex = std::clamp(
            s.value("displayMode", 0).toInt(), 0, 2
        );

        lastSelectedGifSlot = std::clamp(s.value("activeGifSlot",0).toInt(),0,GIF_SLOT_COUNT-1);
        for (int i=0;i<GIF_SLOT_COUNT;i++) {
            const bool hasRaw    = QFile::exists(rawGifPath(i));
            const bool hasCrop   = QFile::exists(cropFlagPath(i));
            const bool hasUpload = QFile::exists(uploadFlagPath(i));
            const bool hasUncertain =
            QFile::exists(uploadUncertainFlagPath(i));


            // STEP 3.3D-3B — Never infer the TFT hardware index
            // from the local GUI slot number.

            const QString indexKey =
            QStringLiteral("gifHardwareIndex/%1").arg(i);

            bool indexIsInteger = false;

            const int savedHardwareIndex =
            s.value(indexKey).toInt(&indexIsInteger);

            if (s.contains(indexKey) &&
                indexIsInteger &&
                savedHardwareIndex >= 0 &&
                savedHardwareIndex < GIF_SLOT_COUNT) {

                gifSlots[i].hardwareListIndex =
                savedHardwareIndex;

                } else {
                    gifSlots[i].hardwareListIndex = -1;

                    if (hasRaw && hasCrop && hasUpload) {
                        qWarning()
                        << "[GIF-SAFETY] Uploaded GIF has no valid"
                        << "saved hardware index. Local slot:"
                        << i;
                    }
                }

            // Restore the local GIF preview even when an
            // earlier hardware upload has an uncertain result.
            // Never classify an uncertain upload as confirmed.

            if (hasRaw && hasCrop &&
                (hasUpload || hasUncertain)) {

                gifSlots[i].path = rawGifPath(i);


            // STEP 4C-8B
            // Restore a locally confirmed upload only when
            // the persisted metadata matches QSettings.

            gifSlots[i].uploadedToHardware =
            hasUpload &&
            !hasUncertain &&
            uploadedGifMetadataMatches(
                i,
                gifSlots[i].hardwareListIndex
            );


                gifSlots[i].isSelected = (i == lastSelectedGifSlot);
                loadPreview(i);

                // 🆕 Cache alleen laden voor de geselecteerde slot
                if (i == lastSelectedGifSlot) {
                    loadFramesToCache(i);
                }
            }
        }

        if (gifDeleteJournalPending() && currentModeIndex == 2) {
            currentModeIndex = 0;
            s.setValue("displayMode", 0);
        }
        // An empty selected slot may be shown in the GUI without trying
        // to activate an invalid physical GIF index.

        // GUI STEP 1 - RESTORE LAST GIF SELECTION
        // Herstel de actieve GUI-slotkeuze zonder USB-commando.
        m_selectedSlot = lastSelectedGifSlot;
        refreshSlotWidgets();

        m_previewWaitingForGifAck =
            currentModeIndex == 2 &&
            !gifSlots[lastSelectedGifSlot].path.isEmpty();
        m_mode->setCurrentIndex(currentModeIndex);
        m_rotation->setCurrentIndex(currentRotationIndex);
        m_gifSwitch->setChecked(currentModeIndex==2);

        updatePreviewSize();   // ← formaat goed zetten NA het laden van rotatie
    }

    void scanSensors()
    {
        // MYSTIQUE STEP 5B 5-VENDOR MODULES v1
        globalCpuTempPath.clear();
        globalGpuTempPath.clear();
        globalGpuLoadPath.clear();
        hasNvidiaGpu = false;
        const auto cpuRoute = MystiqueMetrics::routeCpu(
            m_hardwareProfile.cpuVendor.toStdString());
        const auto gpuRoute = MystiqueMetrics::routeGpu(
            m_hardwareProfile.gpuVendor.toStdString());
        // Mixed/unknown hardware: keep the complete original detection path.
        if (cpuRoute == MystiqueMetrics::CpuRoute::Legacy ||
            gpuRoute == MystiqueMetrics::GpuRoute::Legacy) {

        for (int i=0;i<15;i++) {
            const QString namePath=QString("/sys/class/hwmon/hwmon%1/name").arg(i);
            QFile f(namePath); if(!f.open(QIODevice::ReadOnly)) continue;
            const QString drv=QString::fromUtf8(f.readAll()).trimmed();
            if (drv=="coretemp" || drv=="k10temp" || drv=="zenpower") { globalCpuTempPath=QString("/sys/class/hwmon/hwmon%1/temp1_input").arg(i).toStdString(); break; }
        }
        if (globalCpuTempPath.empty()) globalCpuTempPath="/sys/class/thermal/thermal_zone0/temp";
        FILE* nv=popen("which nvidia-smi >/dev/null 2>&1 && nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>/dev/null","r");
        if(nv){ int v=0; hasNvidiaGpu=(fscanf(nv,"%d",&v)==1); pclose(nv); }
        if(!hasNvidiaGpu){
            for(int i=0;i<15;i++){
                QFile f(QString("/sys/class/hwmon/hwmon%1/name").arg(i)); if(!f.open(QIODevice::ReadOnly)) continue;
                const QString drv=QString::fromUtf8(f.readAll()).trimmed();
                if(drv=="amdgpu" || drv=="i915"){ globalGpuTempPath=QString("/sys/class/hwmon/hwmon%1/temp1_input").arg(i).toStdString(); break; }
            }
            for(int i=0;i<5;i++){
                const QString p=QString("/sys/class/drm/card%1/device/gpu_busy_percent").arg(i);
                if(QFile::exists(p)){ globalGpuLoadPath=p.toStdString(); break; }
            }
        }
            return;
        }
        if (cpuRoute == MystiqueMetrics::CpuRoute::Intel)
            globalCpuTempPath = MystiqueMetrics::IntelCpu::findTemperatureSensor();
        else
            globalCpuTempPath = MystiqueMetrics::AmdCpu::findTemperatureSensor();

        switch (gpuRoute) {
        case MystiqueMetrics::GpuRoute::Amd:
            globalGpuTempPath = MystiqueMetrics::AmdGpu::findTemperatureSensor();
            globalGpuLoadPath = MystiqueMetrics::AmdGpu::findLoadSensor();
            break;
        case MystiqueMetrics::GpuRoute::Intel:
            globalGpuTempPath = MystiqueMetrics::IntelGpu::findTemperatureSensor();
            globalGpuLoadPath = MystiqueMetrics::IntelGpu::findLoadSensor();
            break;
        case MystiqueMetrics::GpuRoute::Nvidia:
            hasNvidiaGpu = MystiqueMetrics::NvidiaGpu::available();
            if (!hasNvidiaGpu)
                qWarning() << "[METRICS-ROUTER] NVIDIA identified, but nvidia-smi unavailable.";
            break;
        case MystiqueMetrics::GpuRoute::Legacy:
            break;
        }
        qInfo().noquote() << "[METRICS-ROUTER] CPU="
                          << m_hardwareProfile.cpuVendor
                          << "GPU=" << m_hardwareProfile.gpuVendor;
    }

    // MYSTIQUE FIRST LAUNCH HIDC 0x14 v1
    bool runFirstLaunchMediaSetup()
    {
        QSettings settings("LionheartTim", "DeepCoolDigitalGui");
        const QString status = settings.value(
            MystiqueFirstLaunch::stateKey).toString();
        if (status == "completed" || status == "previously-tested") return true;
        if (!status.isEmpty()) {
            QMessageBox::critical(this, "First Launch Setup",
                "An earlier cleanup attempt has an uncertain outcome.\n"
                "For safety, HIDC 0x14 will NOT be sent again automatically.\n"
                "Review the previous attempt before proceeding.");
            return false;
        }

        // Migration guard for the independently hardware-tested Python tool.
        // Its ACK alone does not prove SD completion; but re-sending would be unsafe.
        const QString oldMarker = QDir::homePath() +
            QString::fromLatin1(MystiqueFirstLaunch::oldMarkerRelative);
        if (QFile::exists(oldMarker)) {
            QFile recordFile(oldMarker);
            QString previousStatus;
            if (recordFile.open(QIODevice::ReadOnly)) {
                const QJsonDocument doc = QJsonDocument::fromJson(recordFile.readAll());
                if (doc.isObject()) previousStatus =
                    doc.object().value("status").toString();
            }
            if (previousStatus == "accepted-not-confirmed-on-sd") {
                const auto verified = QMessageBox::question(this,
                    "Previous Media Cleanup Found",
                    "A previous HIDC 0x14 cleanup attempt was recorded.\n"
                    "The destructive command will NOT be repeated.\n"
                    "Have you already verified that cleanup completed on your cooler?",
                    QMessageBox::Yes | QMessageBox::No, QMessageBox::No);
                if (verified != QMessageBox::Yes) return false;
                // Explicit user verification is required; ACK alone is insufficient.
                settings.setValue(MystiqueFirstLaunch::stateKey, "previously-tested");
                settings.sync();
                return settings.status() == QSettings::NoError;
            }
            QMessageBox::critical(this, "Previous Media Cleanup Found",
                "A previous cleanup attempt was recorded but not confirmed.\n"
                "For safety, this application will not repeat HIDC 0x14.");
            return false;
        }

        QDialog consent(this);
        consent.setWindowTitle("First-Time Device Setup");
        consent.setModal(true);
        consent.setMinimumWidth(530);
        auto* layout = new QVBoxLayout(&consent);
        auto* message = new QLabel(
            "Before using DeepCool MYSTIQUE Control Hub, the cooler's media "
            "storage must be initialized for reliable GIF management.\n\n"
            "This one-time operation permanently deletes ALL stored GIFs "
            "and images from the cooler's internal SD card (SD:GIF and SD:IMG). "
            "Firmware and general settings are not formatted.\n\n"
            "If you cancel, GIFs and images from the original Windows software "
            "may remain on the cooler, which could prevent the GIF section "
            "from working correctly.\n\n"
            "After confirmation, keep the device connected and do not close "
            "the application during the 120-second waiting period.", &consent);
        message->setWordWrap(true);
        layout->addWidget(message);
        auto* buttonRow = new QHBoxLayout;
        buttonRow->addStretch();
        auto* ok = new QPushButton("OK — Clear Stored Media", &consent);
        buttonRow->addWidget(ok);
        layout->addLayout(buttonRow);
        connect(ok, &QPushButton::clicked, &consent, &QDialog::accept);
        if (consent.exec() != QDialog::Accepted) return false;

        // No normal DeepCool driver has opened yet; normal timers start later.
        bool attempted = false;
        QString problem;
        const bool ack = MystiqueFirstLaunch::sendOneTimeCleanup(problem, attempted);
        if (attempted) {
            GifDeleteWaitingDialog wait(this);
            wait.setWindowTitle("First Launch Setup — Do Not Disconnect");
            auto* waitLayout = new QVBoxLayout(&wait);
            auto* description = new QLabel(
                "Media cleanup request sent. Keep your cooler connected.\n"
                "USB acknowledgement does not prove SD cleanup is complete.", &wait);
            description->setWordWrap(true);
            auto* progress = new QProgressBar(&wait);
            progress->setRange(0, 120);
            auto* remaining = new QLabel("120 seconds remaining", &wait);
            waitLayout->addWidget(description);
            waitLayout->addWidget(progress);
            waitLayout->addWidget(remaining);
            QElapsedTimer elapsed;
            QTimer timer(&wait);
            connect(&timer, &QTimer::timeout, &wait, [&]() {
                const int seconds = qMin(120, int(elapsed.elapsed() / 1000));
                progress->setValue(seconds);
                remaining->setText(QString("%1 seconds remaining").arg(120 - seconds));
                if (seconds >= 120) {
                    timer.stop();
                    wait.finishWaiting();
                }
            });
            elapsed.start();
            timer.start(100);
            wait.exec();
        }

        if (!ack) {
            QMessageBox::critical(this, "First Launch Setup Incomplete",
                problem + "\nThe cleanup will not be retried automatically.");
            return false;
        }
        settings.setValue(MystiqueFirstLaunch::stateKey, "completed");
        settings.sync();
        if (settings.status() != QSettings::NoError) {
            QMessageBox::critical(this, "First Launch Setup",
                "Could not persist the cleanup result.\n"
                "Do not send HIDC 0x14 again automatically.");
            return false;
        }
        QMessageBox::information(this, "First Launch Setup",
            "The 120-second waiting period has ended.\n"
            "Your cooler accepted the cleanup request. This does not "
            "independently verify SD contents.\n"
            "If needed, power-cycle the cooler before using GIF management.");
        return true;
    }

    void connectHardware()
    {
        globalDevice=new DeepCoolDevice;
        QVector<DeviceInfo> devices=Device::detectDevices();
        for(const auto& d:devices){
            if(d.vendorId==0x3633 && d.productId==0x0009){
                if(globalDevice->open(d)){
                    globalDevice->initMachineInfoMode();
                    globalDevice->setDisplayMode(MODE_CPU_INFO);
                    m_isRunning=true;
                    setStatus("Status: Connected to "+globalDevice->getDeviceName());
                } else setStatus("Status: Found device but USB connection failed.");
                return;
            }
        }
        setStatus("Status: No DeepCool MYSTIQUE detected.");
    }

    void setStatus(const QString& s){
        if (m_status) m_status->setText(s);
        MystiqueLiveLog::add(QStringLiteral("STATUS"), s);
    }

    void setGifProgress(
        int value,
        const QString& message,
        bool indeterminate = false
    )
    {
        const auto updateBar = [value, indeterminate](QProgressBar* bar) {
            if (!bar) return;

            if (indeterminate) {
                bar->setRange(0, 0);
                bar->setFormat("Bezig...");
            } else {
                bar->setRange(0, 100);
                bar->setValue(std::clamp(value, 0, 100));
                bar->setFormat("%p%");
            }
        };

        if (m_cropProgressLabel)
            m_cropProgressLabel->setText(message);

        updateBar(m_cropProgress);
    }

    void setGifControlsBusy(bool busy)
    {
        if (m_mode) m_mode->setEnabled(!busy);
        if (m_rotation) m_rotation->setEnabled(!busy);
        if (m_gifSwitch) m_gifSwitch->setEnabled(!busy);
        if (m_deleteButton) m_deleteButton->setEnabled(!busy);

        for (QCheckBox* check : m_slotChecks) {
            if (check) check->setEnabled(!busy);
        }
    }

    // ============================================================
    // Voert een shell-commando uit en vangt stdout + stderr op
    // ============================================================
    QString runCommandCaptureOutput(const QString& command, int& exitCode)
    {
        QString output;
        exitCode = -1;

        FILE* pipe = popen((command + " 2>&1").toLocal8Bit().constData(), "r");
        if (!pipe) {
            output = "Kon commando niet uitvoeren.";
            return output;
        }

        char buffer[256];
        while (fgets(buffer, sizeof(buffer), pipe) != nullptr) {
            output += QString::fromLocal8Bit(buffer);
        }

        const int status = pclose(pipe);
        exitCode = WEXITSTATUS(status);

        return output;
    }

    // ============================================================
    // Toont een modal popup met "Crop Failed" + selecteerbare
    // debug-output. Gebruiker klikt OK om te sluiten.
    // ============================================================
    void showCropFailedPopup(const QString& debugOutput)
    {
        QDialog dlg(this);
        dlg.setWindowTitle("Crop Failed");
        dlg.setMinimumSize(600, 400);

        auto* layout = new QVBoxLayout(&dlg);

        auto* title = new QLabel("Crop Failed");
        title->setStyleSheet(
            "font-size: 16px;"
            "font-weight: bold;"
            "color: #e74c3c;"
            "padding: 8px 0;"
        );
        layout->addWidget(title);

        auto* info = new QLabel(
            "The GIF could not be processed. Please share the "
            "information below if you report this issue:");
        info->setWordWrap(true);
        info->setStyleSheet("color: #b0b6bf; padding-bottom: 6px;");
        layout->addWidget(info);

        auto* debugBox = new QPlainTextEdit;
        debugBox->setPlainText(debugOutput);
        debugBox->setReadOnly(true);
        debugBox->setStyleSheet(
            "background: #15171a;"
            "color: #e6e6e6;"
            "font-family: monospace;"
            "font-size: 11px;"
            "border: 1px solid #444;"
            "border-radius: 4px;"
        );
        layout->addWidget(debugBox, 1);

        auto* buttons = new QHBoxLayout;
        buttons->addStretch();
        auto* okButton = new QPushButton("OK");
        okButton->setMinimumWidth(120);
        buttons->addWidget(okButton);
        layout->addLayout(buttons);

        connect(okButton, &QPushButton::clicked, &dlg, &QDialog::accept);

        dlg.exec();
    }

    void updatePreviewSize()
    {
        if (!m_preview || !m_previewContainer || !m_pumpShell) return;

        // Deze afbeelding is liggend met rechtopstaand logo bij 270 graden.
        // Andere rotaties draaien uitsluitend de visuele pompshell mee.
        // Het TFT en de Metrics-/GIF-protocollen veranderen NIET.
        const int shellAngle = (currentRotationIndex + 1) % 4 * 90;
        const QPixmap source(QApplication::applicationDirPath() + "/aio-preview");
        if (!source.isNull()) {
            QPixmap oriented = source;
            if (shellAngle != 0) {
                oriented = source.transformed(QTransform().rotate(shellAngle),
                                              Qt::SmoothTransformation);
            }
            const QSize shellSize = oriented.size().scaled(
                QSize(374, 374), Qt::KeepAspectRatio);
            m_pumpShell->setGeometry((400 - shellSize.width()) / 2,
                                     (400 - shellSize.height()) / 2,
                                     shellSize.width(), shellSize.height());
            m_pumpShell->setPixmap(oriented.scaled(
                shellSize, Qt::KeepAspectRatio, Qt::SmoothTransformation));
        } else {
            m_pumpShell->setGeometry(0, 0, 400, 400);
            m_pumpShell->setText("Pump image not found: aio-preview");
            qWarning() << "[PUMP-PREVIEW] aio-preview ontbreekt";
        }

        const bool portrait = (currentRotationIndex == 0 ||
                               currentRotationIndex == 2);
        // Passend binnen de donkere TFT-opening van de 586x592 JPG.
        // Houd de verhouding van het werkelijke 480x640 LCD behouden.
        if (portrait) {
            m_preview->setGeometry(76, 35, 248, 330);
        } else {
            m_preview->setGeometry(35, 76, 330, 248);
        }
        m_preview->raise();
        if (m_previewBrightnessShade) {
            m_previewBrightnessShade->setGeometry(
                m_preview->rect().adjusted(1, 1, -1, -1));
            m_previewBrightnessShade->raise();
        }
        if (m_rgbPreviewOverlay) {
            m_rgbPreviewOverlay->raise();
            updateRgbVisualPreview(nullptr);
        }
    }

    // Step 4C: visual-only depiction of the existing three RGB modes.
    // Firmware RGB565 samples 7 points on each long edge of 480x640.
    // The orientation of those logical positions is rotated with the TFT.
    // This is NOT readback of the actual LEDs, nor a calibrated LED map.
    QColor rgbTemperaturePreviewColor(float temperature) const
    {
        if (!std::isfinite(temperature) || temperature < 0.0f)
            return QColor();
        if (temperature <  5.0f) return QColor("#1502FF");
        if (temperature < 10.0f) return QColor("#1469FF");
        if (temperature < 15.0f) return QColor("#14B9FF");
        if (temperature < 20.0f) return QColor("#14FFC7");
        if (temperature < 31.0f) return QColor("#14FF64");
        if (temperature < 42.0f) return QColor("#A9FF64");
        if (temperature < 53.0f) return QColor("#F3FF64");
        if (temperature < 64.0f) return QColor("#FFD464");
        if (temperature < 75.0f) return QColor("#FF9314");
        if (temperature < 80.0f) return QColor("#FF7714");
        if (temperature < 85.0f) return QColor("#FF4C14");
        if (temperature < 90.0f) return QColor("#FF3014");
        return QColor("#FF1414");
    }

    void updateRgbVisualPreview(const QImage* gifFrame)
    {
        if (!m_rgbPreviewOverlay || !m_rgbSwitchGroup ||
            !m_preview || !m_pumpShell)
            return;

        QImage layer(400, 400, QImage::Format_ARGB32_Premultiplied);
        layer.fill(Qt::transparent);
        const int mode = m_rgbSwitchGroup->checkedId();

        // Motherboard RGB uses a purely visual rainbow simulation.
        // The 14 LED positions and the physical-rotation mapping stay intact.
        // No ASUS USB reports or other motherboard data are used.
        if (mode < 0 || mode > 2) {
            m_rgbPreviewOverlay->setPixmap(QPixmap::fromImage(layer));
            return;
        }


        const float previewTemperature =
        (currentModeIndex == 1) ? currentData.gpuTemp : currentData.cpuTemp;

        const QColor tempColor =
        rgbTemperaturePreviewColor(previewTemperature);

        const bool portrait = currentRotationIndex == 0 ||
                              currentRotationIndex == 2;
        // Position lighting around the OUTER pump shell, NOT the TFT.
        // m_pumpShell moves with all four preview rotations.
        const QRect housing = m_pumpShell->geometry();
        if (housing.width() < 100 || housing.height() < 100) {
            m_rgbPreviewOverlay->setPixmap(QPixmap::fromImage(layer));
            return;
        }
        const bool hasFrame = mode == 2 && gifFrame &&
                              !gifFrame->isNull();
        QPainter painter(&layer);
        painter.setRenderHint(QPainter::Antialiasing);
        painter.setPen(Qt::NoPen);

        // Index order: 7 samples along first physical long edge and
        // 7 along the opposite edge. At 270 degrees these become
        // bottom (right->left) and top (left->right), respectively.
        for (int i = 0; i < 14; ++i) {
            const int group = i / 7;
            const int j = i % 7;
            const int reversed = 6 - j;
            int position = j;
            int side = group;

            if (portrait) {
                if (currentRotationIndex == 2) {
                    side = 1 - group;
                }
                // The first physical edge traverses bottom->top.
                position = group == 0 ? reversed : j;
                if (currentRotationIndex == 2)
                    position = 6 - position;
            } else if (currentRotationIndex == 3) {
                side = 1 - group; // first group is bottom, second top
                position = group == 0 ? reversed : j;
            } else {
                side = group; // first group top, second bottom
                position = group == 0 ? j : reversed;
            }

            QColor color = mode == 1 ? tempColor : QColor();
            if (mode == 0) {
                // Flowing rainbow preview: 7 LEDs on each of the two sides.
                // This is intentionally simulated, not live motherboard data.
                if (!m_motherboardRainbowClock.isValid())
                    m_motherboardRainbowClock.start();
                const qreal travel =
                    static_cast<qreal>(m_motherboardRainbowClock.elapsed() % 6000) /
                    6000.0;
                const qreal base = static_cast<qreal>(position + 7 * side) /
                                   14.0;
                const qreal hue = std::fmod(base - travel + 1.0, 1.0);
                color = QColor::fromHsvF(hue, 0.88, 1.0);
            }
            if (hasFrame) {
                // Exact logical 480x640 sampling positions from SWM341
                // firmware 0x21D5C. Rotate with current preview orientation.
                static constexpr int edgeY[7] = {
                    635, 505, 405, 305, 205, 105, 5
                };
                const int srcX = group == 0 ? 5 : 475;
                const int srcY = group == 0 ? edgeY[j] : edgeY[6 - j];
                int rotatedX = srcX;
                int rotatedY = srcY;
                int logicalW = 480;
                int logicalH = 640;
                if (currentRotationIndex == 1) {
                    rotatedX = 639 - srcY;
                    rotatedY = srcX;
                    logicalW = 640;
                    logicalH = 480;
                } else if (currentRotationIndex == 2) {
                    rotatedX = 479 - srcX;
                    rotatedY = 639 - srcY;
                } else if (currentRotationIndex == 3) {
                    rotatedX = srcY;
                    rotatedY = 479 - srcX;
                    logicalW = 640;
                    logicalH = 480;
                }
                const int sx = qBound(0,
                    qRound(rotatedX * (gifFrame->width() - 1.0) /
                           (logicalW - 1)), gifFrame->width() - 1);
                const int sy = qBound(0,
                    qRound(rotatedY * (gifFrame->height() - 1.0) /
                           (logicalH - 1)), gifFrame->height() - 1);
                const QColor sampled = gifFrame->pixelColor(sx, sy);
                // Approximate the real RGB565 framebuffer quantization.
                color = QColor(sampled.red() & 0xF8,
                               sampled.green() & 0xFC,
                               sampled.blue() & 0xF8);
            }
            if (!color.isValid()) continue;

            // Keep LED bars OUTSIDE the pump-housing bounding box.
            // Seven per long edge; positions rotate with the housing.
            // A small outer gap and subdued glow prevent contact with TFT.
            const qreal thickness = 4.0;
            const qreal outerGap = 5.0;
            const qreal endInset = 16.0;
            const qreal gap = 3.0;
            QRectF led;
            if (portrait) {
                // Portrait: LEDs along the left and right HOUSING edges.
                const qreal length = housing.height() - 2.0 * endInset;
                const qreal size = (length - 6.0 * gap) / 7.0;
                const qreal y = housing.top() + endInset +
                                position * (size + gap);
                const qreal x = side == 0
                    ? housing.left() - outerGap - thickness
                    : housing.right() + outerGap;
                led = QRectF(x, y, thickness, size);
            } else {
                // Landscape: LEDs ABOVE and BELOW the entire housing.
                const qreal length = housing.width() - 2.0 * endInset;
                const qreal size = (length - 6.0 * gap) / 7.0;
                const qreal x = housing.left() + endInset +
                                position * (size + gap);
                const qreal y = side == 0
                    ? housing.top() - outerGap - thickness
                    : housing.bottom() + outerGap;
                led = QRectF(x, y, size, thickness);
            }
            QColor glow = color;
            glow.setAlpha(55);
            painter.setBrush(glow);
            painter.drawRoundedRect(led.adjusted(-2, -2, 2, 2), 3, 3);
            color.setAlpha(225);
            painter.setBrush(color);
            painter.drawRoundedRect(led, 2, 2);
        }
        painter.end();
        m_rgbPreviewOverlay->setPixmap(QPixmap::fromImage(layer));
    }

    void createTrayIcon()
    {
        if (!QSystemTrayIcon::isSystemTrayAvailable()) {
            qWarning() << "⚠️ [Tray] Geen systeemvak beschikbaar op deze desktop.";
            return;
        }

        QMenu* trayMenu = new QMenu(this);

        QAction* showAction = trayMenu->addAction("Venster tonen");
        connect(showAction, &QAction::triggered, this, [this]{
            show();
            raise();
            activateWindow();
        });

        trayMenu->addSeparator();

        QAction* quitAction = trayMenu->addAction("Afsluiten");
        connect(quitAction, &QAction::triggered, qApp, &QApplication::quit);

        m_trayIcon = new QSystemTrayIcon(this);
        m_trayIcon->setIcon(QIcon::fromTheme("io.github.lionhearttim.deepcool-gui",
                                             QIcon(":/deepcool.png")));
        m_trayIcon->setToolTip("DeepCool Mystique Control Hub");
        m_trayIcon->setContextMenu(trayMenu);
        m_trayIcon->show();

        connect(m_trayIcon, &QSystemTrayIcon::activated, this,
                [this](QSystemTrayIcon::ActivationReason reason) {
                    if (reason == QSystemTrayIcon::Trigger ||
                        reason == QSystemTrayIcon::DoubleClick) {
                        if (isVisible()) {
                            hide();

                            // 🆕 Animaties pauzeren
                            m_timer.stop();

                            // Cache vrijgeven
                            for (int i = 0; i < GIF_SLOT_COUNT; ++i) {
                                dropFramesFromCache(i);
                            }
                        } else {
                            show();
                            raise();
                            activateWindow();

                            // 🆕 Cache herladen voor de geselecteerde slot
                            if (lastSelectedGifSlot >= 0 &&
                                lastSelectedGifSlot < GIF_SLOT_COUNT &&
                                !gifSlots[lastSelectedGifSlot].path.isEmpty()) {
                                loadFramesToCache(lastSelectedGifSlot);
                                }

                                // Animaties hervatten
                                m_timer.start();
                        }
                        }
                });

        qDebug() << "✅ [Tray] Systeemvakpictogram actief.";
    }

    void selectSlot(int slot)
    {
        if (slot < 0 || slot >= GIF_SLOT_COUNT) return;

        const int previousSlot = lastSelectedGifSlot;

        m_selectedSlot = slot;
        lastSelectedGifSlot = slot;

        for (int i = 0; i < GIF_SLOT_COUNT; ++i) {
            gifSlots[i].isSelected = (i == slot);
        }

        // Bewaar de laatst geselecteerde GIF ook voor een nieuwe sessie.
        QSettings slotSettings("LionheartTim", "DeepCoolDigitalGui");
        slotSettings.setValue("activeGifSlot", slot);
        slotSettings.sync();

        if (slotSettings.status() != QSettings::NoError) {
            qWarning() << "[GIF-RESTORE] Failed to save selected slot";
        }

        // 🆕 Oude slot-cache vrijgeven (als die niet meer nodig is)
        if (previousSlot != slot && previousSlot >= 0 && previousSlot < GIF_SLOT_COUNT) {
            // Check of de oude slot nog ergens voor nodig is
            const bool stillNeeded = (currentModeIndex == 2) &&
            (previousSlot == slot);
            if (!stillNeeded) {
                dropFramesFromCache(previousSlot);
            }
        }

        // 🆕 Nieuwe slot-cache laden als de GIF een pad heeft
        if (!gifSlots[slot].path.isEmpty()) {
            loadFramesToCache(slot);


            const bool uploadDone =
            QFile::exists(uploadFlagPath(slot));

            // STEP 3.3D-2B
            // Block automatic GIF mode activation while any
            // hardware upload state remains unresolved.

            bool hasUncertainUpload = false;

            for (int i = 0; i < GIF_SLOT_COUNT; ++i) {
                if (QFile::exists(uploadUncertainFlagPath(i))) {
                    hasUncertainUpload = true;
                    break;
                }
            }


            // STEP 4C-14C-5A
            // A pending hardware delete must also block
            // automatic GIF activation through slot selection.

            bool hasUncertainDelete = gifDeleteJournalPending();

            for (int i = 0; i < GIF_SLOT_COUNT; ++i) {
                if (QFile::exists(deleteUncertainFlagPath(i))) {
                    hasUncertainDelete = true;
                    break;
                }
            }

            // STEP 4C-8C
            // Activate only a locally confirmed GIF whose
            // persisted UUID and hardware index are consistent.

            if (uploadDone &&
                !hasUncertainUpload &&
                !hasUncertainDelete &&
                gifSlots[slot].uploadedToHardware &&
                uploadedGifMetadataMatches(
                    slot,
                    gifSlots[slot].hardwareListIndex
                )) {


                logDebug("SELECT", QString("Slot %1 is al geüpload → naar GIF mode")
                .arg(slot));

                const bool needsSelectionAck =
                    previousSlot != slot || currentModeIndex != 2;
                currentModeIndex = 2;
                m_previewWaitingForGifAck =
                    m_previewWaitingForGifAck || needsSelectionAck;
                QSettings s("LionheartTim", "DeepCoolDigitalGui");
                s.setValue("displayMode", 2);

                m_updatingUi = true;
                m_mode->setCurrentIndex(2);
                m_gifSwitch->setChecked(true);
                m_updatingUi = false;
            }
        } else if (!m_gifPreparationActive && !m_uploadRunning &&
                   !gifDeleteJournalPending()) {
            bool unresolved = false;
            for (int i = 0; i < GIF_SLOT_COUNT; ++i) {
                if (QFile::exists(uploadUncertainFlagPath(i)) ||
                    QFile::exists(deleteUncertainFlagPath(i))) {
                    unresolved = true;
                    break;
                }
            }
            if (!unresolved) {
                // Empty GUI slot is a GIF-preview state; it is NOT an
                // unproven hardware index selection command.
                currentModeIndex = 2;
                m_previewWaitingForGifAck = false;
                QSettings("LionheartTim", "DeepCoolDigitalGui")
                    .setValue("displayMode", 2);
                { QSignalBlocker blocker(m_mode);
                  m_mode->setCurrentIndex(2); }
                { QSignalBlocker blocker(m_gifSwitch);
                  m_gifSwitch->setChecked(true); }
            }
        }

        refreshSlotWidgets();
        updatePreview();
    }

    void refreshSlotWidgets()
    {
        for(int i=0;i<m_slotWidgets.size();i++){
            auto* w=m_slotWidgets[i];
            if(gifSlots[i].preview.isNull()) w->setText("Drag\n&\nDrop");
            else w->setPixmap(QPixmap::fromImage(gifSlots[i].preview.scaled(w->size()-QSize(8,8),Qt::KeepAspectRatio,Qt::SmoothTransformation)));
            w->setStyleSheet(gifSlots[i].isSelected
            ? "border: 2px solid #00ab99; border-radius: 8px; background: #1a2422; color: #e6e6e6;"
            : "border: 2px dashed #5a6069; border-radius: 8px; background: #1a1d21; color: #b0b6bf;"
            );
            if (i < m_slotChecks.size()) { QSignalBlocker blocker(m_slotChecks[i]); m_slotChecks[i]->setChecked(gifSlots[i].isSelected); }
        }
    }

    // ============================================================
    // Update alleen de geselecteerde kleine slot-preview
    // (rest blijft statisch)
    // ============================================================
    void updateSmallSlotPreview(int slot)
    {
        if (slot < 0 || slot >= GIF_SLOT_COUNT) return;
        if (slot >= m_slotWidgets.size()) return;
        if (!gifSlots[slot].framesLoaded) return;
        if (gifSlots[slot].cachedFrames.isEmpty()) return;

        auto* w = m_slotWidgets[slot];
        if (!w) return;

        const int frameIdx = gifSlots[slot].currentFrame
        % gifSlots[slot].cachedFrames.size();
        const QImage frame = gifFrameForPreview(
            slot, gifSlots[slot].cachedFrames[frameIdx]);

        w->setPixmap(QPixmap::fromImage(
            frame.scaled(w->size() - QSize(8,8),
                         Qt::KeepAspectRatio,
                         Qt::SmoothTransformation)));
    }

    void loadPreview(int slot)
    {
        const QString path = rawGifPath(slot);

        QImageReader r(path);
        r.setDecideFormatFromContent(true);

        QImage img = r.read();

        if (!img.isNull()) {
            gifSlots[slot].preview = img;

            logDebug(
                "PREVIEW",
                QString("Slot %1: %2x%3 geladen uit %4")
                .arg(slot)
                .arg(img.width())
                .arg(img.height())
                .arg(path)
            );
        } else {
            gifSlots[slot].preview = QImage();

            const QFileInfo fi(path);

            logDebug(
                "PREVIEW",
                QString(
                    "Slot %1: laden mislukt; bestaat=%2, bytes=%3, fout=%4"
                )
                .arg(slot)
                .arg(fi.exists() ? "ja" : "nee")
                .arg(fi.exists() ? fi.size() : qint64(0))
                .arg(r.errorString())
            );
        }

        refreshSlotWidgets();
        updatePreview();
    }

    void importGif(int slot, const QString& source)
    {
        logDebug("DROP", QString("Start: slot=%1, source=%2")
        .arg(slot).arg(source));

        if (slot < 0 || slot >= GIF_SLOT_COUNT) {
            logDebug("DROP", "❌ Ongeldige slot index");
            return;
        }

        QFileInfo info(source);
        if (!info.exists() || info.size() > 25LL * 1024 * 1024) {
            logDebug("DROP", "❌ GIF bestaat niet of is te groot");
            QMessageBox::warning(
                this,
                "GIF",
                "GIF is groter dan 25 MB of bestaat niet."
            );
            return;
        }

        // Voorkom meerdere gelijktijdige GIF-verwerkingen.
        if (m_gifPreparationActive || m_uploadRunning) {
            setStatus(
                "Er wordt al een GIF verwerkt. "
                "Wacht tot de voortgangsbalk klaar is."
            );
            return;
        }

        // STEP 4C-14E-4G
        // Block new GIF imports while a previous local
        // delete transaction is pending or unrecoverable.

        const QString pendingImportDeleteJournal =
        gifDeleteJournalPath();

        if (gifDeleteJournalPending()) {

            qCritical()
            << "[DELETE-RECOVERY] GIF import blocked."
            << "Transaction journal:"
            << pendingImportDeleteJournal
            << "Requested slot:" << slot;

        QMessageBox::warning(
            this,
            "GIF Import Blocked",
            "A previous GIF deletion transaction "
            "has not been completed.\n\n"
            "Importing another GIF is temporarily blocked.\n"
            "Your existing GIF files and recovery data "
            "have been preserved."
        );

        return;
            }

        // STEP 4C-14C-2
        // Block GIF import while any hardware delete is unresolved.
        // This check runs BEFORE local slot files can be cleared.

        for (int i = 0; i < GIF_SLOT_COUNT; ++i) {
            if (!QFile::exists(deleteUncertainFlagPath(i))) {
                continue;
            }

            qWarning()
            << "[DELETE-SAFETY] GIF import blocked."
            << "Unresolved delete slot:" << i
            << "Requested import slot:" << slot;

            QMessageBox::warning(
                this,
                "GIF Import Blocked",
                QString(
                    "A previous GIF deletion in slot %1 "
                    "has not been verified.\n\n"
                    "Your existing GIF files have been preserved."
                ).arg(i + 1)
            );

            return;
        }

        // STEP 3.3B-3 — Protect existing GIF data before import.
        // This guard must run before any slot directory is cleared.

        if (QFile::exists(uploadUncertainFlagPath(slot))) {
            QMessageBox::warning(
                this,
                "GIF Import Blocked",
                "This slot has an unresolved hardware upload state.\n\n"
                "The existing GIF, JPEG frames and recovery information "
                "must be preserved.\n\n"
                "Do not overwrite this slot until its hardware state "
                "has been verified."
            );
            return;
        }

        // V1 supports a new upload or an explicit deletion,
        // never silently overwriting an existing hardware GIF.
        if (gifSlots[slot].uploadedToHardware ||
            gifSlots[slot].hardwareListIndex >= 0 ||
            QFile::exists(uploadFlagPath(slot))) {

            QMessageBox::warning(
                this,
                "GIF Slot Occupied",
                "This slot already contains an uploaded GIF.\n\n"
                "Delete the existing GIF before importing another one."
            );
        return;
            }


        m_gifPreparationActive = true;
        setGifControlsBusy(true);
        setGifProgress(0, "GIF voorbereiden...", true);

        // Nieuwe GIF-drop: eerst de firmware-upload-wachtstand tonen.
        const int previousMode = currentModeIndex;

        currentModeIndex = 2;

        QSettings("LionheartTim", "DeepCoolDigitalGui")
        .setValue("displayMode", 2);

        m_mode->setCurrentIndex(2);

        m_updatingUi = true;
        m_gifSwitch->setChecked(true);
        m_updatingUi = false;

        updatePreview();


        if (globalDevice && globalDevice->isOpen()) {
            // Stop een bestaande GIF-stream indien nodig.
            if (previousMode == 2) {
                globalDevice->stopGifHardwareStream();

                logDebug(
                    "MODE",
                    "Oude GIF-stream gestopt."
                );
            }

            // Houd de verbinding actief tijdens de voorbereiding.
            // GIF-modus wordt pas na upload en commit geactiveerd.
            const bool heartbeatOk =
            globalDevice->updateDisplay(currentData);

            qDebug()
            << "[GIF-PREUPLOAD] EP02 heartbeat (0x10 + 0x01):"
            << (heartbeatOk ? "OK" : "FAIL");
        }

        const QString dir = slotDir(slot);
        QDir().mkpath(dir);

        // ============================================================
        // STAP 1: als de slot-map niet leeg is, alles wissen
        // ============================================================
        QDir slotDirObj(dir);
        if (slotDirObj.exists() &&
            !slotDirObj.entryList(QDir::NoDotAndDotDot | QDir::AllEntries).isEmpty()) {
            logDebug("DROP", "Map niet leeg → leegmaken: " + dir);
        clearDirectory(dir);
            }

            // ============================================================
            // STAP 2: metadata strippen via ImageMagick
            // ============================================================
            QString magickOutput;
            logDebug("STRIP", "Start: source=" + source);
            logDebug("STRIP", "Doel: " + rawGifPath(slot));

            if (!runImageMagickWithOutput(
                source,
                rawGifPath(slot),
                                          magickOutput)) {

                logDebug("STRIP", "❌ Gefaald");
            logDebug("STRIP", "Output: " + magickOutput);

            clearSlotFiles(slot);
            refreshSlotWidgets();

            m_gifPreparationActive = false;
            setGifControlsBusy(false);
            setGifProgress(0, "GIF voorbereiden mislukt");

            setStatus("Status: GIF processing failed.");
            showCropFailedPopup(magickOutput);
            return;
                                          }

                                          logDebug("STRIP", "✅ Succesvol");
                                          setGifProgress(5, "GIF voorbereid; cropvenster openen...");

                                          // ============================================================
                                          // STAP 3: oude flags verwijderen, slot resetten
            // ============================================================
            QFile::remove(uploadFlagPath(slot));
            QFile::remove(cropFlagPath(slot));

            gifSlots[slot] = GifSlot{};
            gifSlots[slot].path = rawGifPath(slot);

            selectSlot(slot);
            loadPreview(slot);

            logDebug("DROP", QString("✅ Klaar, crop-dialog openen voor slot %1")
            .arg(slot));

            // ============================================================
            // STAP 4: crop-dialog openen
            // ============================================================
            showCropDialog(slot);

            m_gifPreparationActive = false;

            if (gifSlots[slot].uploadedToHardware ||
                QFile::exists(uploadFlagPath(slot))) {

                // Upload is al voltooid in de selector.
                // Behoud de voltooiingsstatus.

                } else if (m_uploadRunning) {

                    // De upload loopt nog; de worker beheert de voortgang.

                } else if (QFile::exists(cropFlagPath(slot)) &&
                    !QFile::exists(uploadFlagPath(slot))) {

                    // Terugval als er nog geen upload gestart is.
                    updateHardware();

                    } else {
                        setGifControlsBusy(false);

                        // Behoud de foutmelding als een upload is mislukt.
                        if (currentModeIndex != 0) {
                            setGifProgress(
                                0,
                                "GIF-verwerking geannuleerd"
                            );
                        }
                    }
    }

    void showCropDialog(int slot)
    {
        logDebug("DIALOG", QString("Crop dialog openen voor slot %1").arg(slot));

        // 🆕 Animatie pauzeren tijdens crop-dialog
        m_timer.stop();

        QDialog dlg(this);
        dlg.setWindowTitle("GIF Uitsnede Aanpassen");
        dlg.resize(620, 760);
        // ...

        auto* layout = new QVBoxLayout(&dlg);

        auto* crop = new GifCropWidget;
        crop->setImage(gifSlots[slot].preview);
        crop->setRotation(currentRotationIndex);
        layout->addWidget(crop, 1);

        auto* buttons = new QHBoxLayout;
        auto* apply = new QPushButton("Apply Crop");
        auto* cancel = new QPushButton("Cancel");
        m_cropCancelButton = cancel;
        buttons->addWidget(apply);
        buttons->addWidget(cancel);
        layout->addLayout(buttons);

        auto* hintLabel = new QLabel(
            "Scroll mouse wheel to zoom\n"
            "Drag with left mouse button to pan");
        hintLabel->setAlignment(Qt::AlignCenter);
        hintLabel->setStyleSheet(
            "color: #8a9099;"
            "font-size: 11px;"
            "padding: 6px 0 8px 0;"
        );
        layout->addWidget(hintLabel);

        m_cropProgressLabel = new QLabel(
            "Kies de uitsnede en klik Apply Crop",
            &dlg
        );

        m_cropProgress = new QProgressBar(&dlg);
        m_cropProgress->setRange(0, 100);
        m_cropProgress->setValue(5);
        m_cropProgress->setFormat("%p%");

        layout->addWidget(m_cropProgressLabel);
        layout->addWidget(m_cropProgress);

        connect(cancel, &QPushButton::clicked, &dlg, &QDialog::reject);
        connect(apply, &QPushButton::clicked, &dlg,
                [this, &dlg, slot, crop, apply, cancel] {
                    logDebug("DIALOG", "Apply Crop geklikt");

                    apply->setEnabled(false);
                    cancel->setEnabled(false);

                    const bool cropOk =
                    applyCrop(slot, crop->cropRectInImage());

                    apply->setEnabled(true);
                    cancel->setEnabled(true);

                    if (cropOk) {
                        logDebug(
                            "DIALOG",
                            "Crop succesvol; upload starten in selector"
                        );

                        crop->setEnabled(false);
                        apply->setEnabled(false);
                        cancel->setEnabled(false);

                        m_gifPreparationActive = false;

                        if (!globalDevice ||
                            !globalDevice->isOpen() ||
                            gifSlots[slot].path.isEmpty()) {

                            setGifProgress(
                                0,
                                "Upload niet gestart: apparaat niet beschikbaar"
                            );

                        setGifControlsBusy(false);
                        crop->setEnabled(true);
                        apply->setEnabled(true);
                        cancel->setEnabled(true);
                        return;
                            }

                            // Selector blijft open tijdens de asynchrone upload.
                            startGifUploadAsync(slot);

                    } else {
                        logDebug(
                            "DIALOG",
                            "Crop mislukt; dialog blijft open"
                        );
                    }
                });

        const int result = dlg.exec();

        if (result == QDialog::Accepted) {
            logDebug("DIALOG", "Dialog accepted");
        } else if (gifSlots[slot].uploadedToHardware) {
            logDebug(
                "DIALOG",
                "Selector gesloten na upload; GIF behouden."
            );


        } else if (QFile::exists(uploadUncertainFlagPath(slot))) {
            logDebug(
                "UPLOAD-SAFETY",
                QString(
                    "Slot %1: hardwarestatus onzeker; "
                    "cropvenster gesloten zonder lokale bestanden te verwijderen."
                ).arg(slot)
            );


        } else if (gifSlots[slot].preview.isNull()) {
            logDebug(
                "DIALOG",
                "Cropvenster gesloten met lege preview; "
                "bronbestanden behouden voor diagnose."
            );

        } else {
            logDebug("DIALOG", "Dialog rejected → slot leegmaken");
            clearSlotFiles(slot);
            refreshSlotWidgets();
        }

        m_cropProgress = nullptr;
        m_cropProgressLabel = nullptr;
        m_cropCancelButton = nullptr;

        // 🆕 Animatie hervatten
        m_timer.start();
    }

    bool applyCrop(int slot, const QRect& cropRect)
    {
        logDebug(
            "CROP",
            QString("Start: slot=%1, crop=%2x%3+%4+%5")
            .arg(slot)
            .arg(cropRect.width())
            .arg(cropRect.height())
            .arg(cropRect.x())
            .arg(cropRect.y())
        );

        const QString source = rawGifPath(slot);
        const QString dir = slotDir(slot);

        QImage first = gifSlots[slot].preview;
        if (first.isNull()) {
            logDebug("CROP", "❌ Preview is leeg (gifSlots[slot].preview.isNull())");
            return false;
        }

        logDebug("CROP", QString("Preview: %1x%2")
        .arg(first.width()).arg(first.height()));

        // Output-resolutie op basis van rotatie
        const bool portrait = (currentRotationIndex == 0 ||
        currentRotationIndex == 2);
        const int targetWidth  = portrait ? 480 : 640;
        const int targetHeight = portrait ? 640 : 480;

        logDebug("CROP", QString("Rotatie=%1 → target=%2x%3")
        .arg(currentRotationIndex)
        .arg(targetWidth).arg(targetHeight));

        // Crop-coördinaten zijn al berekend in bronpixels.
        const QRect safeCrop = cropRect.intersected(first.rect());

        if (safeCrop.isEmpty()) {
            logDebug("CROP", "❌ Ongeldige of lege uitsnede");
            setStatus("Status: Crop failed.");
            return false;
        }

        const int cropX = safeCrop.x();
        const int cropY = safeCrop.y();
        const int cropW = safeCrop.width();
        const int cropH = safeCrop.height();

        logDebug(
            "CROP",
            QString("Bronuitsnede: %1x%2+%3+%4")
            .arg(cropW)
            .arg(cropH)
            .arg(cropX)
            .arg(cropY)
        );

        // Oude gegenereerde frames en oude successtatus opruimen.
        QDir outputDir(dir);

        const QStringList oldFrames = outputDir.entryList(
            QStringList() << "frame_*.jpg",
                                                          QDir::Files
        );

        for (const QString& frame : oldFrames) {
            outputDir.remove(frame);
        }

        QFile::remove(cropFlagPath(slot));

        // ImageMagick starten met afzonderlijke argumenten.
        const QString executable =
        commandExists("magick") ? "magick" : "convert";

        const QString pattern = dir + "/frame_%d.jpg";

        const QString targetSize = QString("%1x%2")
        .arg(targetWidth)
        .arg(targetHeight);

        const QString cropGeometry = QString("%1x%2+%3+%4")
        .arg(cropW)
        .arg(cropH)
        .arg(cropX)
        .arg(cropY);

                setGifProgress(5, "GIF uitsnede verwerken...", true);

        QProcess process;
        process.setProgram(executable);

        QStringList arguments = {
            source,
            "-coalesce",
            "-crop", cropGeometry,
            "+repage",
            "-resize", targetSize + "!"
        };

        // Windows MYSTIQUE: schermstand 3
        // gebruikt een laatste rotatie van 90 graden rechtsom.
        if (currentRotationIndex == 3) {
            arguments << "-rotate" << "90";
        }

        arguments << pattern;
        process.setArguments(arguments);

        logDebug(
            "CROP",
            QString("ImageMagick starten: %1, crop=%2, target=%3")
            .arg(executable, cropGeometry, targetSize)
        );

        process.start(QIODevice::ReadOnly);

        const bool started = process.waitForStarted(5000);
        bool finished = false;
        bool timedOut = false;

        if (started) {
            QElapsedTimer cropTimer;
            cropTimer.start();

            while (process.state() != QProcess::NotRunning) {
                process.waitForFinished(100);
                QApplication::processEvents();

                if (process.state() == QProcess::NotRunning) {
                    finished = true;
                    break;
                }

                if (cropTimer.elapsed() > 120000) {
                    timedOut = true;
                    process.kill();
                    process.waitForFinished();
                    break;
                }
            }
        }

        QString processOutput = QString::fromLocal8Bit(
            process.readAllStandardOutput()
        );

        processOutput += QString::fromLocal8Bit(
            process.readAllStandardError()
        );

        const bool processOk =
        started &&
        finished &&
        !timedOut &&
        process.exitStatus() == QProcess::NormalExit &&
        process.exitCode() == 0;

        QDir frameDir(dir);

        const QStringList generatedFrames = frameDir.entryList(
            QStringList() << "frame_*.jpg",
                                                               QDir::Files
        );

        logDebug(
            "CROP",
            QString("Exitcode=%1, frames=%2")
            .arg(process.exitCode())
            .arg(generatedFrames.size())
        );

        // Bij een fout mogen gedeeltelijke frames niet blijven liggen.
        if (!processOk || generatedFrames.isEmpty()) {
            for (const QString& frame : generatedFrames)
                frameDir.remove(frame);

            QFile::remove(cropFlagPath(slot));

            if (!started)
                processOutput += "\n" + process.errorString();

            logDebug("CROP", "❌ Crop mislukt: " + processOutput);
            setStatus("Status: Crop failed.");
            showCropFailedPopup(processOutput);
            return false;
        }


        // STEP 4C-1 — Persistent GIF identity and metadata.
        // This must finish before crop_complete.flag exists.

        const int pages = generatedFrames.size();

        if (pages < 1 || pages > 255) {
            const QString error =
            QString("Invalid JPEG frame count: %1 (allowed: 1-255)")
            .arg(pages);

            logDebug("GIF-METADATA", error);
            setStatus("Status: GIF preparation failed.");
            showCropFailedPopup(error);
            return false;
        }

        // Require every JPEG index from 0 through pages-1.
        // Empty or missing frames must never trigger an upload.

        for (int i = 0; i < pages; ++i) {
            const QFileInfo jpegInfo(
                frameDir.filePath(
                    QString("frame_%1.jpg").arg(i)
                )
            );

            if (!jpegInfo.isFile() || jpegInfo.size() <= 0) {
                const QString error =
                QString("Missing or empty JPEG frame: %1").arg(i);

                logDebug("GIF-METADATA", error);
                setStatus("Status: GIF preparation failed.");
                showCropFailedPopup(error);
                return false;
            }
        }

        const QString gifId =
        QUuid::createUuid()
        .toString(QUuid::WithoutBraces)
        .remove('-');

        if (gifId.size() != 32) {
            logDebug("GIF-METADATA", "Invalid generated UUID");
            return false;
        }

        QJsonObject metadata;

        metadata["gifId"] = gifId;
        metadata["pages"] = pages;
        metadata["fps"] = 25;
        metadata["duration"] = pages * 40;
        metadata["frameTimeMs"] = 40;

        metadata["localSlot"] = slot;
        metadata["hardwareListIndex"] = -1;

        metadata["x"] = cropX;
        metadata["y"] = cropY;
        metadata["width"] = cropW;
        metadata["height"] = cropH;
        metadata["deviceRotate"] = currentRotationIndex;

        const QByteArray metadataBytes =
        QJsonDocument(metadata).toJson(QJsonDocument::Indented);

        QSaveFile metadataFile(dir + "/metadata.json");

        const bool metadataSaved =
        metadataFile.open(QIODevice::WriteOnly) &&
        metadataFile.write(metadataBytes) == metadataBytes.size() &&
        metadataFile.commit();

        if (!metadataSaved) {
            const QString error =
            QString("Cannot save metadata.json: %1")
            .arg(metadataFile.errorString());

            logDebug("GIF-METADATA", error);
            setStatus("Status: GIF metadata save failed.");
            showCropFailedPopup(error);
            return false;
        }

        logDebug(
            "GIF-METADATA",
            QString("Saved UUID=%1, frames=%2, FPS=25, duration=%3 ms")
            .arg(gifId)
            .arg(pages)
            .arg(pages * 40)
        );


        // De succesvlag pas aanmaken nadat ImageMagick geslaagd is.
        QFile flag(cropFlagPath(slot));

        const QByteArray flagContents("crop_complete\n");

        if (!flag.open(QIODevice::WriteOnly | QIODevice::Truncate) ||
            flag.write(flagContents) != flagContents.size() ||
            !flag.flush()) {

            const QString error = flag.errorString();

        flag.close();
        QFile::remove(cropFlagPath(slot));
        for (const QString& frame : generatedFrames) {
            frameDir.remove(frame);
        }

        logDebug("CROP", "❌ Cropvlag kon niet worden opgeslagen: " + error);
        setStatus("Status: Crop failed.");
        showCropFailedPopup(error);
        return false;
            }

            flag.close();

            logDebug(
                "CROP",
                QString("✅ Crop voltooid: %1 frames")
                .arg(generatedFrames.size())
            );

            loadPreview(slot);
            setStatus(QString("GIF slot %1 crop complete.").arg(slot));
                        setGifProgress(10, "Uitsnede klaar; upload voorbereiden");

            return true;
    }

    void clearSlotFiles(int slot)
    {

        // STEP 4C-14E-4I-6
        // Never clear local GIF files while a folder
        // compaction transaction remains unresolved.

        const QString cleanupJournalPath =
        gifDeleteJournalPath();

        const QFileInfo cleanupJournalInfo(cleanupJournalPath);

        if (cleanupJournalPath.isEmpty() ||
            cleanupJournalInfo.exists() ||
            cleanupJournalInfo.isSymLink()) {

            qCritical()
            << "[DELETE-RECOVERY] Local cleanup blocked."
            << "Requested slot:" << slot
            << "Transaction journal:" << cleanupJournalPath;

        return;
            }

        // STEP 4C-14D-1
        // Preserve local GIF files while any hardware delete
        // remains unresolved, regardless of the calling path.

        for (int i = 0; i < GIF_SLOT_COUNT; ++i) {
            if (QFile::exists(deleteUncertainFlagPath(i))) {
                qWarning()
                << "[DELETE-SAFETY] Local GIF cleanup blocked."
                << "Pending delete slot:" << i
                << "Requested cleanup slot:" << slot;
                return;
            }
        }

        clearDirectory(slotDir(slot));
        gifSlots[slot]=GifSlot{};
    }

    // Restart-safe local-only continuation. Never sends another USB delete.
    // Destination metadata may have either the original or compacted slot index.
    bool finishPendingLocalGifDelete(
        const GifDeleteTransaction& transaction, QString& error)
    {
        error.clear();
        if (transaction.phase != "acknowledged" ||
            !gifDeleteJournalPending()) {
            error = "Delete is not in an acknowledged recovery state.";
            return false;
        }
        const QString& recoveryPath = transaction.recoveryPath;
        const QFileInfo recoveryInfo(recoveryPath);
        QString foundUuid;
        if (recoveryInfo.exists() || recoveryInfo.isSymLink()) {
            if (!gifDeleteDirectoryUuid(recoveryPath, foundUuid, error) ||
                foundUuid != transaction.removedUuid) {
                if (error.isEmpty()) error = "Wrong GIF UUID in recovery folder.";
                return false;
            }
        } else {
            const QString sourcePath = slotDir(transaction.removedSlot);
            if (!gifDeleteDirectoryUuid(sourcePath, foundUuid, error) ||
                foundUuid != transaction.removedUuid) {
                if (error.isEmpty()) error = "Deleted GIF UUID mismatch.";
                return false;
            }
            const QString rootPath = QFileInfo(recoveryPath).absolutePath();
            const QFileInfo rootInfo(rootPath);
            if (rootInfo.isSymLink() ||
                (rootInfo.exists() && !rootInfo.isDir()) ||
                !QDir().mkpath(rootPath) ||
                !QDir().rename(sourcePath, recoveryPath)) {
                error = "Cannot move deleted GIF to its recovery directory.";
                return false;
            }
        }

        // A single empty position propagates to the right.
        for (int destination = 0;
             destination < transaction.remainingCount; ++destination) {
            const QString expectedUuid = transaction.destinationUuid[destination];
            const QString target = slotDir(destination);
            const QFileInfo targetInfo(target);
            if (targetInfo.exists() || targetInfo.isSymLink()) {
                if (!gifDeleteDirectoryUuid(target, foundUuid, error) ||
                    foundUuid != expectedUuid) {
                    if (error.isEmpty())
                        error = QString("Wrong GIF at destination %1.").arg(destination);
                    return false;
                }
                continue;  // Previous run already moved this GIF.
            }
            if (destination < transaction.removedSlot) {
                error = QString("Missing unaffected GIF %1.").arg(destination);
                return false;
            }
            const QString source = slotDir(destination + 1);
            if (!gifDeleteDirectoryUuid(source, foundUuid, error) ||
                foundUuid != expectedUuid) {
                if (error.isEmpty())
                    error = QString("Wrong source GIF for destination %1.").arg(destination);
                return false;
            }
            if (!QDir().rename(source, target)) {
                error = QString("Folder rename %1 to %2 failed.")
                    .arg(destination + 1).arg(destination);
                return false;
            }
        }

        // The final slots must be vacant, or already empty.
        for (int slot = transaction.remainingCount;
             slot < GIF_SLOT_COUNT; ++slot) {
            const QFileInfo info(slotDir(slot));
            if (info.isSymLink() || (info.exists() && !info.isDir())) {
                error = QString("Unsafe empty slot %1.").arg(slot);
                return false;
            }
            if (info.isDir() && !QDir(slotDir(slot)).entryList(
                    QDir::AllEntries | QDir::NoDotAndDotDot |
                    QDir::Hidden | QDir::System).isEmpty()) {
                error = QString("Slot %1 contains unexpected files.").arg(slot);
                return false;
            }
        }

        // Rewrite metadata atomically, accepting a partially completed run.
        for (int destination = 0;
             destination < transaction.remainingCount; ++destination) {
            const QString path = slotDir(destination) + "/metadata.json";
            QFile file(path);
            if (!file.open(QIODevice::ReadOnly)) {
                error = "Cannot read metadata: " + path;
                return false;
            }
            QJsonParseError parseError;
            const QJsonDocument doc = QJsonDocument::fromJson(
                file.readAll(), &parseError);
            file.close();
            if (parseError.error != QJsonParseError::NoError ||
                !doc.isObject() || QFileInfo(path).isSymLink()) {
                error = "Invalid metadata during recovery: " + path;
                return false;
            }
            QJsonObject meta = doc.object();
            const int sourceSlot = destination < transaction.removedSlot ?
                destination : destination + 1;
            const int local = meta.value("localSlot").toInt(-1);
            const int hardware = meta.value("hardwareListIndex").toInt(-1);
            if (meta.value("gifId").toString() !=
                    transaction.destinationUuid[destination] ||
                (local != sourceSlot && local != destination) ||
                (hardware != sourceSlot && hardware != destination) ||
                !QFile::exists(rawGifPath(destination)) ||
                !QFile::exists(uploadFlagPath(destination)) ||
                !QFile::exists(cropFlagPath(destination))) {
                error = QString("Recovery metadata mismatch in slot %1.")
                    .arg(destination);
                return false;
            }
            if (local != destination || hardware != destination) {
                meta["localSlot"] = destination;
                meta["hardwareListIndex"] = destination;
                const QByteArray bytes = QJsonDocument(meta).toJson(
                    QJsonDocument::Indented);
                QSaveFile output(path);
                if (!output.open(QIODevice::WriteOnly) ||
                    output.write(bytes) != bytes.size() || !output.commit()) {
                    error = "Cannot update metadata: " + path;
                    return false;
                }
            }
            if (!uploadedGifMetadataMatches(destination, destination)) {
                error = QString("Updated GIF metadata invalid in slot %1.")
                    .arg(destination);
                return false;
            }
        }
        for (int slot = transaction.remainingCount;
             slot < GIF_SLOT_COUNT; ++slot) {
            if (!QDir().mkpath(slotDir(slot))) {
                error = QString("Cannot create empty slot %1.").arg(slot);
                return false;
            }
        }

        const int selected = transaction.remainingCount > 0 ?
            qMin(transaction.removedSlot, transaction.remainingCount - 1) : 0;
        QSettings settings("LionheartTim", "DeepCoolDigitalGui");
        for (int slot = 0; slot < GIF_SLOT_COUNT; ++slot) {
            settings.setValue(QString("gifHardwareIndex/%1").arg(slot),
                slot < transaction.remainingCount ? slot : -1);
        }
        settings.setValue("activeGifSlot", selected);
        // GUI STEP 2 - RESTORE GIF AFTER DELETE
        // This value is read only after local compaction and journal
        // cleanup; uncertain deletes remain blocked by the journal.
        settings.setValue("displayMode", 2);
        settings.sync();
        if (settings.status() != QSettings::NoError) {
            error = "Cannot commit GIF QSettings.";
            return false;
        }

        // Keep the central journal until *all* local changes are committed.
        const QString movedMarker = QDir(recoveryPath).filePath(
            "delete_state_unknown.flag");
        if (QFileInfo(movedMarker).exists() && !QFile::remove(movedMarker)) {
            error = "Cannot clear acknowledged delete marker in recovery.";
            return false;
        }
        if (!QFile::remove(gifDeleteJournalPath())) {
            error = "Cannot clear completed central delete journal.";
            return false;
        }

        // Reload only GIF slot bookkeeping; Metrics code remains untouched.
        for (auto& item : gifSlots) item = GifSlot{};
        m_selectedSlot = selected;
        lastSelectedGifSlot = selected;
        currentModeIndex = 2;
        // After a completed delete, existing updateHardware() will
        // safely select the compacted index on its next timer tick.
        loadSettingsAndSlots();
        refreshSlotWidgets();
        updatePreview();
        setStatus(QString("GIF removed; %1 stored GIF(s) remain.")
            .arg(transaction.remainingCount));
        qWarning() << "[DELETE] Local transaction committed; recovery copy:"
                   << recoveryPath;
        return true;
    }


    // STEP 3.3D-1 — Protect the hardware GIF list.
    //
    // Never delete or compact hardware GIF indices while
    // another upload is active or its result is uncertain.

    // Single entry point: hardware delete is still disabled until reviewed.
    // If an ACK was durably recorded, the same button can resume local work
    // without sending any further hardware command.
    void deleteSelectedGif()
    {
        if (m_uploadRunning || m_gifPreparationActive) {
            QMessageBox::warning(this, "GIF Delete Blocked",
                "Wait for the active GIF preparation or upload to finish.");
            return;
        }
        if (gifDeleteJournalPending()) {
            GifDeleteTransaction transaction;
            QString error;
            if (!readGifDeleteTransaction(transaction, error)) {
                QMessageBox::critical(this, "GIF Delete Recovery Required",
                    "Cannot safely read the local delete journal.\n\n" + error +
                    "\n\nNo USB command was sent. Keep all files intact.");
                return;
            }
            if (transaction.phase != "acknowledged") {
                QMessageBox::critical(this, "GIF Delete State Unknown",
                    "A previous USB deletion has no durably recorded ACK.\n\n"
                    "Do not repeat the hardware delete. The local files "
                    "and journal remain preserved for diagnosis.");
                return;
            }
            if (QMessageBox::question(this, "Resume Local GIF Recovery",
                    "A previous delete was acknowledged, but local "
                    "folder updates remain unfinished.\n\n"
                    "Continue local recovery only? No USB delete will be sent.\n"
                    "The wait timer does not prove SD deletion completed.")
                != QMessageBox::Yes) return;
            showGifDeleteProgress(this, transaction.waitMilliseconds);
            if (!finishPendingLocalGifDelete(transaction, error)) {
                QMessageBox::critical(this, "GIF Delete Recovery Required",
                    "Local recovery could not finish:\n\n" + error +
                    "\n\nThe central journal is preserved. Do not retry USB delete.");
            }
            return;
        }
        for (int i = 0; i < GIF_SLOT_COUNT; ++i) {
            if (QFile::exists(uploadUncertainFlagPath(i)) ||
                QFile::exists(deleteUncertainFlagPath(i))) {
                QMessageBox::warning(this, "GIF Delete Blocked",
                    "A previous GIF operation has an unresolved state.\n"
                    "No delete command was sent.");
                return;
            }
        }
        const int slot = m_selectedSlot;
        if (slot < 0 || slot >= GIF_SLOT_COUNT ||
            gifSlots[slot].path.isEmpty()) return;
        const bool uploaded = gifSlots[slot].uploadedToHardware ||
            gifSlots[slot].hardwareListIndex >= 0 ||
            QFile::exists(uploadFlagPath(slot));
        if (!uploaded) {
            if (QMessageBox::question(this, "Delete Local GIF",
                    "Remove the selected local GIF and its prepared frames?\n"
                    "No TFT delete command will be sent.") != QMessageBox::Yes)
                return;
            clearSlotFiles(slot);
            QSettings settings("LionheartTim", "DeepCoolDigitalGui");
            settings.setValue(QString("gifHardwareIndex/%1").arg(slot), -1);
            settings.sync();
            refreshSlotWidgets();
            updatePreview();
            return;
        }

        GifDeleteTransaction transaction;
        QString error;
        if (!prepareGifDeleteTransaction(slot, transaction, error)) {
            QMessageBox::warning(this, "GIF Delete Blocked",
                "The local GIF order or recovery preparation is invalid:\n\n"
                + error + "\n\nNo USB delete was sent.");
            return;
        }
        if (!globalDevice || !globalDevice->isOpen()) {
            QMessageBox::warning(this, "GIF Delete Blocked",
                "The DeepCool MYSTIQUE is not connected.");
            return;
        }
        if (QMessageBox::question(this, "Delete GIF",
                QString("Delete hardware GIF index %1?\n\n"
                        "An ACK means request acceptance, not confirmed SD "
                        "completion. A UUID recovery copy will be retained.")
                    .arg(slot)) != QMessageBox::Yes) return;
        if (!globalDevice->setDisplayMode(MODE_CPU_INFO)) {
            QMessageBox::warning(this, "GIF Delete Blocked",
                "Could not switch the TFT into CPU Metrics mode.\n"
                "No hardware delete was sent.");
            return;
        }
        currentModeIndex = 0;
        QSettings modeSettings("LionheartTim", "DeepCoolDigitalGui");
        modeSettings.setValue("displayMode", 0);
        modeSettings.sync();
        if (modeSettings.status() != QSettings::NoError) {
            QMessageBox::warning(this, "GIF Delete Blocked",
                "Cannot save the CPU Metrics display state.");
            return;
        }
        if (m_mode) {
            QSignalBlocker blocker(m_mode);
            m_mode->setCurrentIndex(0);
        }
        if (m_gifSwitch) {
            QSignalBlocker blocker(m_gifSwitch);
            m_gifSwitch->setChecked(false);
        }
        updatePreview();

        // A per-slot marker and a central UUID journal are both durable
        // before any USB 0x09 request is attempted.
        const QString markerPath = deleteUncertainFlagPath(slot);
        QSaveFile marker(markerPath);
        const QByteArray markerBytes = "delete_state_unknown\n";
        if (!marker.open(QIODevice::WriteOnly) ||
            marker.write(markerBytes) != markerBytes.size() ||
            !marker.commit()) {
            QMessageBox::critical(this, "GIF Delete Blocked",
                "Cannot persist the per-slot recovery marker.\n"
                "No hardware delete was sent.");
            return;
        }
        if (!writeGifDeleteTransaction(transaction, error)) {
            const bool removed = QFile::remove(markerPath);
            QMessageBox::critical(this, "GIF Delete Blocked",
                "Cannot persist the central recovery journal:\n\n" + error +
                (removed ? QString() :
                 QString("\n\nPer-slot marker cleanup failed.")) +
                "\n\nNo hardware delete was sent.");
            return;
        }
        if (!globalDevice->deleteGifHardwareSlot(slot)) {
            QMessageBox::critical(this, "GIF Delete State Unknown",
                "The USB delete did not return a valid ACK. The request "
                "may still have reached the device.\n\n"
                "Local GIF files and both recovery markers were preserved.\n"
                "Never retry this USB delete automatically.");
            return;
        }
        transaction.phase = "acknowledged";
        if (!writeGifDeleteTransaction(transaction, error)) {
            QMessageBox::critical(this, "GIF Delete Recovery Required",
                "USB deletion was acknowledged, but saving its ACK state failed:\n\n"
                + error + "\n\nNo local GIF files were changed.");
            return;
        }
        showGifDeleteProgress(this, transaction.waitMilliseconds);
        if (!finishPendingLocalGifDelete(transaction, error)) {
            QMessageBox::critical(this, "GIF Delete Recovery Required",
                "The delete was acknowledged, but local cleanup stopped:\n\n"
                + error + "\n\nThe journal and recovery files are preserved.\n"
                "Use Delete again to resume LOCAL changes only; no USB retry.");
        }
    }

    // ============================================================
    // Laadt alle frames van een slot in RAM (cache)
    // Wordt alleen aangeroepen als de GIF daadwerkelijk getoond wordt
    // ============================================================
    void loadFramesToCache(int slot)
    {
        if (slot < 0 || slot >= GIF_SLOT_COUNT) return;

        // Al geladen? Niks doen
        if (gifSlots[slot].framesLoaded) return;

        const int n = frameCount(slot);
        if (n <= 0) return;

        logDebug("CACHE", QString("Slot %1: %2 frames laden...").arg(slot).arg(n));

        gifSlots[slot].cachedFrames.clear();
        gifSlots[slot].cachedFrames.reserve(n);

        // GUI PREVIEW ROTATION
        // The uploaded JPEG frames already contain the physical
        // 90-degree rotation for deviceRotate == 3.
        // Undo this rotation in RAM for GUI display only.
        int frameRotation = -1;

        QFile metadataFile(slotDir(slot) + "/metadata.json");
        if (metadataFile.open(QIODevice::ReadOnly)) {
            const QJsonDocument metadata =
                QJsonDocument::fromJson(metadataFile.readAll());

            if (metadata.isObject()) {
                frameRotation =
                    metadata.object().value("deviceRotate").toInt(-1);
            }
        }

        gifSlots[slot].previewBaseRotation = frameRotation;

        for (int i = 0; i < n; ++i) {
            const QString path =
                slotDir(slot) + "/frame_" + QString::number(i) + ".jpg";

            QImage img(path);

            if (!img.isNull()) {
                if (frameRotation == 3 &&
                    img.height() > img.width()) {
                    img = img.transformed(
                        QTransform().rotate(-90),
                        Qt::SmoothTransformation
                    );
                }

                gifSlots[slot].cachedFrames.append(img);
            }
        }

        gifSlots[slot].totalFrames = gifSlots[slot].cachedFrames.size();
        gifSlots[slot].currentFrame = 0;
        gifSlots[slot].framesLoaded = true;

        logDebug("CACHE", QString("Slot %1: %2 frames in cache")
        .arg(slot).arg(gifSlots[slot].cachedFrames.size()));
    }

    // ============================================================
    // Geeft de frames van een slot vrij uit RAM
    // Wordt aangeroepen als de GIF niet meer getoond hoeft te worden
    // ============================================================
    void dropFramesFromCache(int slot)
    {
        if (slot < 0 || slot >= GIF_SLOT_COUNT) return;
        if (!gifSlots[slot].framesLoaded) return;

        logDebug("CACHE", QString("Slot %1: cache vrijgeven").arg(slot));

        gifSlots[slot].cachedFrames.clear();
        gifSlots[slot].cachedFrames.squeeze();
        gifSlots[slot].framesLoaded = false;
        gifSlots[slot].currentFrame = 0;
    }

    QImage currentFrameImage(int slot)
    {
        const int count=frameCount(slot);
        if(count<=0) return gifSlots[slot].preview;
        const int f=gifSlots[slot].currentFrame%count;
        return QImage(slotDir(slot)+"/frame_"+QString::number(f)+".jpg");
    }

    void tickFast()
    {
        animatePreviews();
        // Animate only the GUI rainbow while Motherboard RGB is selected.
        // No additional USB traffic or hardware mode changes.
        if (m_rgbSwitchGroup && m_rgbSwitchGroup->checkedId() == 0 &&
            m_rgbPreviewOverlay && m_rgbPreviewOverlay->isVisible()) {
            updateRgbVisualPreview(nullptr);
        }
    }

    void tickSlow()
    {
        updateMetrics();
        evaluateThermalAlarms();
        updateHardware();
        updatePreview();
    }

    void animatePreviews()
    {
        static qint64 last = 0;
        const qint64 now = QDateTime::currentMSecsSinceEpoch();
        if (now - last < 40) return;
        last = now;

        const int slot = lastSelectedGifSlot;
        if (slot < 0 || slot >= GIF_SLOT_COUNT) return;

        // Alleen animeren als de frames in cache zitten
        if (!gifSlots[slot].framesLoaded) return;
        if (gifSlots[slot].cachedFrames.isEmpty()) return;

        // Volgende frame
        gifSlots[slot].currentFrame =
        (gifSlots[slot].currentFrame + 1) % gifSlots[slot].cachedFrames.size();

        // Kleine preview van de geselecteerde slot updaten
        updateSmallSlotPreview(slot);

        // Grote preview updaten als de GIF daar zichtbaar is
        const bool showGifInPreview = m_gifSwitch->isChecked() ||
        (currentModeIndex == 2);
        if (showGifInPreview) {
            updatePreview();
        }
    }

    float readFloatFile(const std::string& path)
    {
        std::ifstream f(path); float v=0; if(f) f>>v; return v;
    }

    void updateMetrics()
    {
        // Original shared CPU load / frequency / RAM calculations below:
        static long long prevTotal=0,prevIdle=0;
        std::ifstream stat("/proc/stat");
        if(stat){ std::string label; long long user,nice,system,idle,iowait,irq,softirq; stat>>label>>user>>nice>>system>>idle>>iowait>>irq>>softirq; long long totalIdle=idle+iowait,totalNonIdle=user+nice+system+irq+softirq,total=totalIdle+totalNonIdle; if(prevTotal){auto td=total-prevTotal,id=totalIdle-prevIdle;
            if(td>0) currentData.cpuUsage=100.0f*(td-id)/td;} prevTotal=total;prevIdle=totalIdle; }
        std::ifstream mem("/proc/meminfo"); long long total=0,avail=0; std::string key;
        while(mem>>key){if(key=="MemTotal:")mem>>total;
            else if(key=="MemAvailable:"){mem>>avail;break;}}
        if(total) currentData.ramUsage=100.0f*(total-avail)/total;
        std::ifstream cpu("/proc/cpuinfo"); std::string line;
        while(std::getline(cpu,line)){
            if(line.rfind("cpu MHz",0)==0){auto p=line.find(':');
            if(p!=std::string::npos){
                try{liveCpuMHz=std::stof(line.substr(p+1));}catch(...){}}break;}}
        const auto cpuRoute = MystiqueMetrics::routeCpu(
            m_hardwareProfile.cpuVendor.toStdString());
        if (cpuRoute == MystiqueMetrics::CpuRoute::Intel) {
            MystiqueMetrics::IntelCpu::updateTemperature(
                currentData.cpuTemp, globalCpuTempPath);
        } else {
            // Also preserve the AMD reader on mixed/unknown profiles.
            MystiqueMetrics::AmdCpu::updateTemperature(
                currentData.cpuTemp, globalCpuTempPath);
        }
        const auto gpuRoute = MystiqueMetrics::routeGpu(
            m_hardwareProfile.gpuVendor.toStdString());
        if (gpuRoute == MystiqueMetrics::GpuRoute::Amd) {
            // Do NOT touch the original, RX 9070 XT-proven VRAM routine.
            currentData.vramUsage = readVramUsagePercent();
            MystiqueMetrics::AmdGpu::update(
                currentData, globalGpuTempPath, globalGpuLoadPath);
        } else if (gpuRoute == MystiqueMetrics::GpuRoute::Nvidia) {
            MystiqueMetrics::NvidiaGpu::update(currentData);
        } else if (gpuRoute == MystiqueMetrics::GpuRoute::Intel) {
            MystiqueMetrics::IntelGpu::update(
                currentData, globalGpuTempPath, globalGpuLoadPath);
        } else {
            // Mixed / unknown GPU: keep original behavior exactly.
            currentData.vramUsage = readVramUsagePercent();
        if(hasNvidiaGpu){ FILE* p=popen("nvidia-smi --query-gpu=temperature.gpu,utilization.gpu,clocks.current.graphics --format=csv,noheader,nounits 2>/dev/null","r");
            if(p){int a,b,c;
                if(fscanf(p,"%d, %d, %d",&a,&b,&c)==3){currentData.gpuTemp=a;currentData.gpuUsage=b;currentData.gpuFrequency=c;}pclose(p);} }
                else {
                    if(!globalGpuTempPath.empty()) {
                        float v = readFloatFile(globalGpuTempPath);
                        currentData.gpuTemp = v / 1000.0f;
                        if(currentData.gpuTemp < 1.0f)
                            currentData.gpuTemp = v;
                    }

                    if(!globalGpuLoadPath.empty())
                        currentData.gpuUsage = readFloatFile(globalGpuLoadPath);

                    // Gebruik het actieve GPU-device dat al tijdens scanSensors()
                    // aan globalGpuLoadPath gekoppeld is.
                    std::string activeCardDir = "/sys/class/drm/card0/device";

                    if(!globalGpuLoadPath.empty()) {
                        const size_t slash = globalGpuLoadPath.rfind('/');
                        if(slash != std::string::npos)
                            activeCardDir = globalGpuLoadPath.substr(0, slash);
                    }

                    currentData.gpuFrequency = 0;

                    // AMD GPU clock
                    std::ifstream s(activeCardDir + "/pp_dpm_sclk");

                    while(std::getline(s, line)) {
                        if(line.find('*') == std::string::npos)
                            continue;

                        auto p = line.find("MHz");
                        if(p == std::string::npos) p = line.find("Mhz");
                        if(p == std::string::npos) p = line.find("mhz");

                        if(p != std::string::npos) {
                            auto q = line.rfind(' ', p);

                            if(q != std::string::npos) {
                                try {
                                    currentData.gpuFrequency =
                                    static_cast<quint16>(
                                        std::stoi(line.substr(q + 1, p - q - 1))
                                    );
                                } catch(...) {
                                    currentData.gpuFrequency = 0;
                                }
                            }
                        }

                        break;
                    }

                    // Intel fallback
                    if(currentData.gpuFrequency == 0) {
                        std::ifstream intelFreq(activeCardDir + "/gt_cur_freq_mhz");
                        int mhz = 0;

                        if(intelFreq >> mhz && mhz > 0)
                            currentData.gpuFrequency =
                            static_cast<quint16>(mhz);
                    }
                }
        }
        for(int i=0;i<99;i++){cpuLoadHistory[i]=cpuLoadHistory[i+1];gpuLoadHistory[i]=gpuLoadHistory[i+1];cpuTempHistory[i]=cpuTempHistory[i+1];gpuTempHistory[i]=gpuTempHistory[i+1];ramUsageHistory[i]=ramUsageHistory[i+1];vramUsageHistory[i]=vramUsageHistory[i+1];cpuClockHistory[i]=cpuClockHistory[i+1];gpuClockHistory[i]=gpuClockHistory[i+1];}
        cpuLoadHistory[99]=currentData.cpuUsage;gpuLoadHistory[99]=currentData.gpuUsage;cpuTempHistory[99]=currentData.cpuTemp;gpuTempHistory[99]=currentData.gpuTemp;ramUsageHistory[99]=currentData.ramUsage;vramUsageHistory[99]=(currentData.vramUsage >= 0.0f ? currentData.vramUsage : 0.0f);cpuClockHistory[99]=liveCpuMHz/1000.0f;gpuClockHistory[99]=currentData.gpuFrequency/1000.0f;
        if(m_cpuTemp)  m_cpuTemp->setValue(currentData.cpuTemp);
        if(m_cpuLoad)  m_cpuLoad->setValue(currentData.cpuUsage);
        if(m_cpuClock) m_cpuClock->setValue(liveCpuMHz / 1000.0f);
        if(m_ram)
            m_ram->setValue(currentData.ramUsage);

        if (m_vram) {
            if (currentData.vramUsage >= 0.0f) {
                m_vram->setValueText(QString());
                m_vram->setValue(currentData.vramUsage);
            } else {
                m_vram->setValueText("N/A");
            }
        }

        if(m_gpuTemp)
            m_gpuTemp->setValue(currentData.gpuTemp);
        if(m_gpuLoad)  m_gpuLoad->setValue(currentData.gpuUsage);
        if(m_gpuClock) m_gpuClock->setValue(currentData.gpuFrequency / 1000.0f);
    }

    void startGifUploadAsync(int slot)
    {

        if (m_uploadRunning ||
            slot < 0 ||
            slot >= GIF_SLOT_COUNT) {
            return;
            }

            // STEP 4C-14E-4H
            // Prevent new GIF uploads while a previous
            // local delete transaction remains unfinished.

            const QString pendingUploadDeleteJournal =
            gifDeleteJournalPath();

            if (gifDeleteJournalPending()) {

                qCritical()
                << "[DELETE-RECOVERY] GIF upload blocked."
                << "Transaction journal:"
                << pendingUploadDeleteJournal
                << "Requested slot:" << slot;

            setStatus(
                "Upload blocked: unfinished GIF delete transaction."
            );

            setGifProgress(
                0,
                "Upload blocked - GIF delete recovery required"
            );

            setGifControlsBusy(false);
            return;
                }

            // STEP 4C-14C-1 — Global pending-delete protection.
            // Do not upload while hardware GIF indices may be changing.
            for (int i = 0; i < GIF_SLOT_COUNT; ++i) {
                if (QFile::exists(deleteUncertainFlagPath(i))) {
                    qWarning()
                    << "[DELETE-SAFETY] GIF upload blocked:"
                    << "Unresolved delete in slot" << i;

                    setStatus(
                        QString("Upload blocked: unresolved GIF delete in slot %1.")
                        .arg(i + 1)
                    );

                    setGifProgress(
                        0,
                        "Upload blocked — previous GIF delete requires verification"
                    );

                    setGifControlsBusy(false);
                    return;
                }
            }


            // STEP 3.3E-2 — Global upload recovery protection.
            //
            // Never start another hardware upload while any local
            // slot has an unresolved upload state.

            for (int i = 0; i < GIF_SLOT_COUNT; ++i) {
                if (!QFile::exists(uploadUncertainFlagPath(i))) {
                    continue;
                }

                qWarning()
                << "[UPLOAD-SAFETY] Upload blocked."
                << "Unresolved state in local slot:"
                << i
                << "Requested slot:"
                << slot;

                setStatus(
                    QString(
                        "Upload blocked: unresolved hardware state in slot %1."
                    ).arg(i + 1)
                );

                setGifProgress(
                    0,
                    "Upload blocked — hardware GIF list requires verification"
                );

                return;
            }


            if (!globalDevice || !globalDevice->isOpen()) {
                setStatus("Status: DeepCool-device niet beschikbaar.");
                setGifControlsBusy(false);
                setGifProgress(0, "Upload niet gestart");
                return;
            }

            const QString gifPath = gifSlots[slot].path;
            if (gifPath.isEmpty()) return;


            // STEP 3.3E-3A — Validate local hardware index records.
            // This does NOT prove the actual TFT list contents.

            std::array<int, GIF_SLOT_COUNT> indexOwner;
        indexOwner.fill(-1);

        for (int i = 0; i < GIF_SLOT_COUNT; ++i) {
            const int index = gifSlots[i].hardwareListIndex;

            const bool recordedAsUploaded =
            gifSlots[i].uploadedToHardware ||
            QFile::exists(uploadFlagPath(i));

            const bool invalidIndex =
            index < -1 || index >= GIF_SLOT_COUNT;

            const bool missingIndex =
            recordedAsUploaded && index < 0;

            const bool orphanedIndex =
            index >= 0 && !recordedAsUploaded;

            const bool missingLocalGif =
            recordedAsUploaded && gifSlots[i].path.isEmpty();


            // STEP 4C-9A
            // Validate stored GIF metadata before a new upload.

            const bool invalidSavedMetadata =
            recordedAsUploaded &&
            !uploadedGifMetadataMatches(i, index);

            if (invalidIndex ||
                missingIndex ||
                orphanedIndex ||
                missingLocalGif ||
                invalidSavedMetadata) {


                qCritical()
                << "[UPLOAD-SAFETY] Inconsistent GIF record."
                << "Local slot:" << i
                << "Hardware index:" << index
                << "Uploaded:" << recordedAsUploaded;

            setStatus(
                QString(
                    "Upload blocked: inconsistent GIF record in slot %1."
                ).arg(i + 1)
            );

            return;
                }

                if (index >= 0) {
                    if (indexOwner[index] != -1) {
                        qCritical()
                        << "[UPLOAD-SAFETY] Duplicate hardware index:"
                        << index
                        << "Slots:"
                        << indexOwner[index] << i;

                        setStatus(
                            "Upload blocked: duplicate hardware GIF index."
                        );

                        return;
                    }

                    indexOwner[index] = i;
                }
        }

        // Never upload into a slot already recorded as uploaded.
        if (gifSlots[slot].uploadedToHardware ||
            gifSlots[slot].hardwareListIndex >= 0 ||
            QFile::exists(uploadFlagPath(slot))) {

            qWarning()
            << "[UPLOAD-SAFETY] Destination slot occupied:"
            << slot;

        setStatus(
            "Upload blocked: selected GIF slot is already occupied."
        );

        return;
            }

            // A compacted hardware list must not contain index gaps.
            int recordedCount = 0;

            for (int owner : indexOwner) {
                if (owner >= 0) {
                    ++recordedCount;
                }
            }

            for (int index = 0; index < recordedCount; ++index) {
                if (indexOwner[index] < 0) {
                    qCritical()
                    << "[UPLOAD-SAFETY] Gap in hardware GIF indices:"
                    << index;

                    setStatus(
                        "Upload blocked: GIF index list requires verification."
                    );

                    return;
                }
            }



            // STEP 3.3E-3B — Expected append index.
            //
            // Step 3.3E-3A has already validated that the locally
            // recorded hardware indices form a contiguous list.
            //
            // The next expected list index therefore equals the
            // number of locally recorded hardware GIFs.
            //
            // IMPORTANT:
            // This is a local expectation, not independent proof
            // of the actual SD-card contents.

            const int targetHardwareIndex = recordedCount;

            qWarning()
            << "[UPLOAD-SAFETY] Expected append index:"
            << targetHardwareIndex
            << "Local slot:"
            << slot
            << "Recorded hardware GIF count:"
            << recordedCount;


        if (targetHardwareIndex < 0 || targetHardwareIndex >= GIF_SLOT_COUNT) {
            setStatus("Geen vrije TFT-GIF-index beschikbaar.");
            return;
        }


        // STEP 4C-9B
        // Validate locally prepared metadata before
        // creating the persistent upload recovery marker.

        const bool preparedMetadataValid =
        QFile::exists(rawGifPath(slot)) &&
        QFile::exists(cropFlagPath(slot)) &&
        gifPath == rawGifPath(slot) &&
        uploadedGifMetadataMatches(slot, -1, true);

        if (!preparedMetadataValid) {
            qCritical()
            << "[UPLOAD-SAFETY] Prepared GIF metadata invalid."
            << "Slot:" << slot;

            setStatus(
                "Upload blocked: GIF preparation metadata invalid."
            );

            setGifProgress(
                0,
                "Upload not started — invalid local metadata"
            );

            return;
        }


        // STEP 4C-9C
        // Verify all prepared JPEGs before creating
        // the persistent upload recovery marker.

        const bool preparedJpegsValid = [&]() -> bool {

            QFile metadataFile(slotDir(slot) + "/metadata.json");

            if (!metadataFile.open(QIODevice::ReadOnly)) {
                return false;
            }

            const QJsonDocument document =
            QJsonDocument::fromJson(metadataFile.readAll());

            metadataFile.close();

            if (!document.isObject()) {
                return false;
            }

            const QJsonObject metadata = document.object();

            const int pages =
            metadata.value("pages").toInt(-1);

            const int rotation =
            metadata.value("deviceRotate").toInt(-1);

            if (pages < 1 || pages > 255 ||
                rotation < 0 || rotation > 3) {
                return false;
                }

                const QDir frameDir(slotDir(slot));

            const QStringList frameFiles =
            frameDir.entryList(
                QStringList() << "frame_*.jpg",
                               QDir::Files
            );

            if (frameFiles.size() != pages) {
                return false;
            }

            // Windows MYSTIQUE JPEG output:
            // Rotation 0, 2, 3: 480x640
            // Rotation 1:       640x480
            const QSize expectedSize =
            (rotation == 1)
            ? QSize(640, 480)
            : QSize(480, 640);

            for (int i = 0; i < pages; ++i) {

                const QFileInfo jpegInfo(
                    frameDir.filePath(
                        QString("frame_%1.jpg").arg(i)
                    )
                );

                if (!jpegInfo.isFile() || jpegInfo.size() <= 0) {
                    return false;
                }

                QImageReader reader(
                    jpegInfo.absoluteFilePath(),
                                    QByteArrayLiteral("jpeg")
                );

                const QImage frame = reader.read();

                if (frame.isNull() ||
                    frame.size() != expectedSize) {
                    return false;
                    }
            }

            return true;
        }();

        if (!preparedJpegsValid) {

            qCritical()
            << "[UPLOAD-SAFETY] JPEG preflight failed."
            << "Slot:" << slot;

            setStatus(
                "Upload blocked: prepared JPEG frames invalid."
            );

            setGifProgress(
                0,
                "Upload not started — JPEG validation failed"
            );

            return;
        }


        // ============================================================
        // STEP 3.3B-2 — PERSISTENT UPLOAD SAFETY MARKER
        //
        // Create the marker before the USB worker starts.
        // A previous uncertain upload must never be retried
        // automatically.
        // ============================================================

        const QString uncertainPath =
        uploadUncertainFlagPath(slot);

        if (QFile::exists(uncertainPath)) {
            qCritical()
            << "[UPLOAD-SAFETY] Previous upload state is unknown:"
            << uncertainPath;

            setStatus(
                "Upload blocked: hardware state is unknown."
            );

            setGifProgress(
                0,
                "Upload blocked — previous attempt requires inspection"
            );

            setGifControlsBusy(false);

            if (m_cropCancelButton) {
                m_cropCancelButton->setEnabled(true);
            }

            return;
        }

        QSaveFile stateFile(uncertainPath);

        const QByteArray stateContents =
        QString(
            "upload_state_unknown\n"
            "local_slot=%1\n"
            "requested_hardware_index=%2\n"
        )
        .arg(slot)
        .arg(targetHardwareIndex)
        .toUtf8();

        if (!stateFile.open(QIODevice::WriteOnly) ||
            stateFile.write(stateContents) != stateContents.size() ||
            !stateFile.commit()) {

            qCritical()
            << "[UPLOAD-SAFETY] Cannot persist upload marker:"
            << stateFile.errorString();

        setStatus(
            "Upload aborted: cannot save recovery state."
        );

        setGifProgress(
            0,
            "Upload not started — recovery marker failed"
        );

        setGifControlsBusy(false);

        if (m_cropCancelButton) {
            m_cropCancelButton->setEnabled(true);
        }

        return;
            }

            qWarning()
            << "[UPLOAD-SAFETY] Recovery marker created:"
            << uncertainPath
            << "| requested hardware index:"
            << targetHardwareIndex;


            if (m_uploadThread.joinable()) {
                m_uploadThread.join();
            }

            m_uploadRunning = true;
            setGifControlsBusy(true);

            setGifProgress(
                10,
                QString("Slot %1: upload voorbereiden...")
                .arg(slot + 1)
            );

            setStatus(
                QString("GIF slot %1 uploaden...")
                .arg(slot + 1)
            );

            const auto progressCallback =
            [this](int percent, const QString& message) {
                QMetaObject::invokeMethod(
                    this,
                    [this, percent, message]() {
                        setGifProgress(percent, message);
                    },
                    Qt::QueuedConnection
                );
            };

            m_uploadThread = std::thread(
                    [this, slot, gifPath, targetHardwareIndex, progressCallback]() {
                    qWarning().noquote()
                    << "[UPLOAD-DIAG] Worker gestart:"
                    << "slot=" << slot
                    << "| bestand=" << gifPath;


                    // STEP 3.3E-3C-2C-1
                    // Track the last reported upload phase.
                    // This records where processing reached,
                    // not whether SD storage was completed.

                    QString lastReportedStage =
                    QStringLiteral("Before driver call");

                    const std::function<void(int, const QString&)>
                    trackedProgress =
                    [&lastReportedStage, &progressCallback](
                        int percent,
                        const QString& message
                    ) {
                        lastReportedStage = message;
                        progressCallback(percent, message);
                    };


                    // STEP 3.3E-3C-2C-3H
                    // Collect confirmed upload stages from the driver.
                    // No changes to USB commands or upload decisions.

                    GifUploadOutcome uploadOutcome;


                    // STEP 3K — Validate driver success.
                    //
                    // A successful return must agree with the
                    // confirmed USB stage and selection state.
                    //
                    // Never mark an inconsistent upload as complete.

                    const bool driverSuccess =
                    globalDevice &&
                    globalDevice->startGifHardwareStream(
                        gifPath,
                        targetHardwareIndex,
                        trackedProgress,
                        &uploadOutcome
                    );

                    const bool modeAcknowledged =
                    uploadOutcome.lastCompletedStage ==
                    GifUploadStage::GifModeAcknowledged;

                    const bool selectionConsistent =
                    uploadOutcome.selectionRequired &&
                    uploadOutcome.selectionAcknowledged;

                    const bool success =
                    driverSuccess &&
                    modeAcknowledged &&
                    selectionConsistent;

                    if (driverSuccess && !success) {
                        qCritical()
                        << "[UPLOAD-SAFETY] Inconsistent driver outcome."
                        << "Hardware index:" << targetHardwareIndex
                        << "Mode acknowledged:" << modeAcknowledged
                        << "Selection consistent:" << selectionConsistent;
                    }


                    qWarning().noquote()
                    << "[UPLOAD-OUTCOME]"
                    << "Slot:" << slot
                    << "| Last completed stage:"
                    << static_cast<int>(
                        uploadOutcome.lastCompletedStage
                    )
                    << "| Selection required:"
                    << uploadOutcome.selectionRequired
                    << "| Selection acknowledged:"
                    << uploadOutcome.selectionAcknowledged;


                    qWarning().noquote()
                    << "[UPLOAD-PHASE]"
                    << "Local slot:" << slot
                    << "| Last reported stage:"
                    << lastReportedStage
                    << "| Driver result:"
                    << (success ? "SUCCESS" : "FAILURE");



                    bool uploadFlagWritten = false;

                    if (success) {
                        // STEP 3.3C-1
                        // Write the completion marker atomically.
                        // An incomplete marker must never indicate success.

                        QSaveFile flag(uploadFlagPath(slot));
                        const QByteArray contents("upload_complete\n");

                        if (flag.open(QIODevice::WriteOnly)) {
                            if (flag.write(contents) == contents.size()) {
                                uploadFlagWritten = flag.commit();
                            } else {
                                flag.cancelWriting();
                            }
                        }

                        if (!uploadFlagWritten) {
                            qCritical()
                            << "[UPLOAD-SAFETY] Cannot save upload completion marker:"
                            << flag.errorString();
                        }
                    }


                    qWarning().noquote()
                    << "[UPLOAD-DIAG] Eindresultaat:"
                    << "hardware-upload="
                    << (success ? "SUCCESS" : "FAILURE")
                    << "| uploadflag="
                    << (uploadFlagWritten
                    ? "geschreven"
                    : "niet geschreven")
                    << "| slot=" << slot;



                    QMetaObject::invokeMethod(
                        this,


                        [this, slot, targetHardwareIndex, success, uploadFlagWritten, lastReportedStage, uploadOutcome]() {


                            if (m_uploadThread.joinable()) {
                                m_uploadThread.join();
                            }

                            m_uploadRunning = false;

                            // GUI STEP 3 - auto-close selector after confirmed upload.
                            // Alleen afsluiten wanneer ook de lokale herstelgegevens
                            // compleet zijn. Fouten houden het venster open.
                            bool autoCloseCropSelector = false;

                            if (success) {
                                // STEP 3.3E-3C-2B
                                // Do not mark the local GUI slot as
                                // confirmed before local state is complete.



                                // ============================================================
                                // STEP 3.3C-2 — VERIFY LOCAL UPLOAD STATE
                                // ============================================================

                                QSettings settings(
                                    "LionheartTim",
                                    "DeepCoolDigitalGui"
                                );

                                const QString indexKey =
                                QStringLiteral("gifHardwareIndex/%1").arg(slot);

                                settings.setValue(indexKey, targetHardwareIndex);
                                settings.sync();

                                const bool hardwareIndexSaved =
                                settings.status() == QSettings::NoError &&
                                settings.value(indexKey, -1).toInt() == targetHardwareIndex;


                                const bool completionFlagSaved =
                                uploadFlagWritten &&
                                QFile::exists(uploadFlagPath(slot));

                                // STEP 4C-6
                                // Persist the confirmed hardware index.
                                // Preserve the original UUID and JSON fields.
                                // Never remove the recovery marker unless
                                // metadata has been saved and read back.

                                const bool metadataIndexSaved = [&]() -> bool {

                                    if (!hardwareIndexSaved ||
                                        !completionFlagSaved) {
                                        return false;
                                        }

                                        const QString metadataPath =
                                        slotDir(slot) + "/metadata.json";

                                    QFile input(metadataPath);

                                    if (!input.open(QIODevice::ReadOnly)) {
                                        return false;
                                    }

                                    const QJsonDocument document =
                                    QJsonDocument::fromJson(input.readAll());

                                    input.close();

                                    if (!document.isObject()) {
                                        return false;
                                    }

                                    QJsonObject metadata = document.object();

                                    const QString originalId =
                                    metadata.value("gifId").toString();

                                    if (originalId.size() != 32 ||
                                        metadata.value("localSlot").toInt(-1) != slot ||
                                        metadata.value("hardwareListIndex").toInt(-999) != -1) {
                                        return false;
                                        }

                                        metadata["hardwareListIndex"] =
                                        targetHardwareIndex;

                                    const QByteArray contents =
                                    QJsonDocument(metadata).toJson(
                                        QJsonDocument::Indented
                                    );

                                    QSaveFile output(metadataPath);

                                    if (!output.open(QIODevice::WriteOnly)) {
                                        return false;
                                    }

                                    if (output.write(contents) != contents.size()) {
                                        output.cancelWriting();
                                        return false;
                                    }

                                    if (!output.commit()) {
                                        return false;
                                    }

                                    QFile verification(metadataPath);

                                    if (!verification.open(QIODevice::ReadOnly)) {
                                        return false;
                                    }

                                    const QJsonDocument verifiedDocument =
                                    QJsonDocument::fromJson(
                                        verification.readAll()
                                    );

                                    if (!verifiedDocument.isObject()) {
                                        return false;
                                    }

                                    const QJsonObject verified =
                                    verifiedDocument.object();

                                    return
                                    verified.value("gifId").toString() ==
                                    originalId &&
                                    verified.value("hardwareListIndex").toInt(-1) ==
                                    targetHardwareIndex;
                                }();

                                if (!metadataIndexSaved) {
                                    qCritical()
                                    << "[UPLOAD-SAFETY] Metadata index"
                                    << "could not be persisted and verified."
                                    << "Slot:" << slot;
                                }

                                bool recoveryMarkerRemoved = false;

                                if (hardwareIndexSaved &&
                                    completionFlagSaved &&
                                    metadataIndexSaved) {

                                    recoveryMarkerRemoved =
                                    QFile::remove(
                                        uploadUncertainFlagPath(slot)
                                    );
                                    }

                                    const bool localStateComplete =
                                    hardwareIndexSaved &&
                                    completionFlagSaved &&
                                    metadataIndexSaved &&
                                    recoveryMarkerRemoved;


                                if (!localStateComplete) {

                                    qCritical()
                                    << "[UPLOAD-SAFETY] Local state incomplete:"
                                    << "hardwareIndexSaved =" << hardwareIndexSaved
                                    << "completionFlagSaved =" << completionFlagSaved
                                    << "metadataIndexSaved =" << metadataIndexSaved
                                    << "recoveryMarkerRemoved =" << recoveryMarkerRemoved;



                                    // STEP 3J — Local recovery diagnostics.
                                    // Report exactly which local records
                                    // could not be confirmed.
                                    //
                                    // A USB mode ACK does not prove
                                    // durable SD-card storage.

                                    setGifProgress(
                                        95,
                                        "USB mode acknowledged; local state uncertain"
                                    );

                                    setStatus(
                                        "GIF upload: local recovery state unresolved."
                                    );

                                        QMessageBox::warning(
                                            this,
                                            "GIF Upload - Local State Uncertain",
                                            QString(
                                                "The driver reported a successful GIF "
                                                "mode switch, but the local recovery "
                                                "records could not all be confirmed.\n\n"
                                                "Hardware index saved: %1\n"
                                                "Upload completion flag saved: %2\n"
                                                "Metadata index saved: %3\n"
                                                "Recovery marker removed: %4\n\n"
                                                "This does not prove durable "
                                                "SD-card storage.\n\n"
                                                "Your original GIF and prepared JPEG "
                                                "frames have been preserved.\n"
                                                "Automatic retries remain blocked.\n\n"
                                                "Do not delete or overwrite this slot "
                                                "until its state has been verified."
                                            )
                                            .arg(hardwareIndexSaved ? "YES" : "NO")
                                            .arg(completionFlagSaved ? "YES" : "NO")
                                            .arg(metadataIndexSaved ? "YES" : "NO")
                                            .arg(recoveryMarkerRemoved ? "YES" : "NO")
                                        );



                                } else {
                                    // USB function succeeded and the local
                                    // completion state was persisted.
                                    // This is not an independent SD readback.


                                    gifSlots[slot].uploadedToHardware = true;
                                    gifSlots[slot].hardwareListIndex = targetHardwareIndex;
                                    justUploadedSlot = slot;
                                    m_previewWaitingForGifAck = false;
                                    autoCloseCropSelector = true;

                                    setGifProgress(
                                        100,
                                        QString("Slot %1: USB bevestigd; TFT-weergave controleren")
                                        .arg(slot + 1)
                                    );


                                    setStatus(
                                        QString("GIF slot %1 succesvol geüpload.")
                                        .arg(slot + 1)
                                    );

                                    logDebug(
                                        "UPLOAD",
                                        QString(
                                            "Slot %1: upload, hardware-index en "
                                            "lokale herstelstatus verwerkt."
                                        ).arg(slot)
                                    );
                                }

                            } else {
                                logDebug(
                                    "UPLOAD",
                                    QString("❌ Slot %1 upload mislukt.")
                                    .arg(slot)
                                );

                                setGifProgress(
                                    0,
                                    QString("Slot %1: upload mislukt")
                                    .arg(slot + 1)
                                );


                                // STEP 3I — Confirmed upload stage.
                                // A confirmed USB stage does not
                                // prove durable SD-card storage.

                                QString confirmedStage;

                                switch (uploadOutcome.lastCompletedStage) {
                                    case GifUploadStage::NotStarted:
                                        confirmedStage = "No upload stage confirmed";
                                        break;

                                    case GifUploadStage::PreparationAcknowledged:
                                        confirmedStage = "Preparation acknowledged (0x0F)";
                                        break;

                                    case GifUploadStage::JpegTransferFinished:
                                        confirmedStage = "All JPEG bytes transferred";
                                        break;

                                    case GifUploadStage::FinishPacketSent:
                                        confirmedStage = "Finish packet transferred";
                                        break;

                                    case GifUploadStage::GifSelectionAcknowledged:
                                        confirmedStage = "GIF selection acknowledged (0x08)";
                                        break;

                                    case GifUploadStage::GifModeAcknowledged:
                                        confirmedStage = "GIF mode acknowledged (0x03 02)";
                                        break;
                                }

                                if (!uploadOutcome.selectionRequired) {
                                    confirmedStage +=
                                    "\nGIF selection: not required (first GIF)";
                                } else if (uploadOutcome.selectionAcknowledged) {
                                    confirmedStage +=
                                    "\nGIF selection: acknowledged";
                                } else {
                                    confirmedStage +=
                                    "\nGIF selection: not acknowledged";
                                }



                                QMessageBox::critical(
                                    this,
                                    "GIF Upload Status Unknown",
                                    QString(
                                        "The GIF upload or hardware activation "
                                        "could not be confirmed.\n\n"
                                        "Last confirmed driver stage:\n%1\n\n"
                                        "Last reported progress:\n%2\n\n"
                                        "USB acknowledgements do not prove "
                                        "durable SD-card storage.\n\n"
                                        "Your original GIF and prepared JPEG "
                                        "frames have been preserved.\n"
                                        "The TFT may contain partially or "
                                        "completely uploaded data.\n\n"
                                        "Automatic retries remain blocked "
                                        "until the hardware state is verified."
                                    ).arg(confirmedStage, lastReportedStage)
                                );



                                // IMPORTANT:
                                // Do not call clearSlotFiles(slot) here.
                                // Preserve the original GIF, JPEG frames and recovery marker.
                                refreshSlotWidgets();


                                currentModeIndex = 0;

                                if (m_mode) {
                                    m_mode->setCurrentIndex(0);
                                }

                                if (m_gifSwitch) {
                                    m_gifSwitch->setChecked(false);
                                }


                                setStatus(
                                    QString("GIF upload state uncertain — last stage: %1")
                                    .arg(lastReportedStage)
                                );

                            }
                            setGifControlsBusy(false);

                            if (m_cropCancelButton && !autoCloseCropSelector) {
                                // Onzekere/mislukte upload: foutmelding en Close
                                // blijven beschikbaar; geen automatische sluiting.
                                m_cropCancelButton->setText("Close");
                                m_cropCancelButton->setEnabled(true);
                            }

                            updatePreview();

                            if (autoCloseCropSelector && m_cropCancelButton) {
                                // Sluit uitsluitend de bijbehorende crop-selector;
                                // accept() behoudt de reeds geuploade GIF.
                                if (QDialog* selector = qobject_cast<QDialog*>(
                                        m_cropCancelButton->window())) {
                                    qInfo() << "[GIF-SELECTOR] Upload confirmed; closing selector.";
                                    selector->accept();
                                }
                            }
                        },
                        Qt::QueuedConnection
                    );
                }
            );
    }



    void updateHardware()
    {
        if (m_uploadRunning) {
            return;
        }

        if (!globalDevice || !globalDevice->isOpen()) {
            return;
        }

        // Tijdens crop/voorbereiding moet de GIF-wachtfase
        // het status- en displayverkeer blijven uitvoeren.
        if (m_gifPreparationActive) {
            if (currentModeIndex == 2) {
                const bool heartbeatOk =
                globalDevice->updateDisplay(currentData);

                qDebug()
                << "[GIF-WAIT] EP02 heartbeat (0x10 + 0x01):"
                << (heartbeatOk ? "OK" : "FAIL");
            }

            return;
        }

        static int lastMode = -1;
        static int lastSlot = -1;
        static int lastRot = -1;

        if (lastRot != currentRotationIndex) {
            globalDevice->setRotation(
                static_cast<ScreenRotation>(currentRotationIndex)
            );
            lastRot = currentRotationIndex;
        }

        if (currentModeIndex == 0) {
            if (lastMode != 0) {
                globalDevice->setDisplayMode(MODE_CPU_INFO);
                globalDevice->initMachineInfoMode();
                lastMode = 0;
            }

            globalDevice->updateDisplay(currentData);
        }
        else if (currentModeIndex == 1) {
            if (lastMode != 1) {
                globalDevice->setDisplayMode(MODE_GPU_INFO);
                globalDevice->initMachineInfoMode();
                lastMode = 1;
            }

            SystemData d = currentData;
            d.cpuTemp = currentData.gpuTemp;
            d.cpuUsage = currentData.gpuUsage;

            if (currentData.vramUsage >= 0.0f) {
                d.ramUsage = currentData.vramUsage;
            }

            globalDevice->updateDisplay(d);
        }

        else {
            // STEP 3.3D-2A — Block GIF hardware activation
            // whenever any upload has an unresolved state.
            //
            // Never change the hardware GIF list while its
            // contents or indices may be uncertain.

            for (int i = 0; i < GIF_SLOT_COUNT; ++i) {
                if (!QFile::exists(uploadUncertainFlagPath(i))) {
                    continue;
                }

                qWarning()
                << "[GIF-SAFETY] Hardware GIF mode blocked."
                << "Uncertain upload in local slot:"
                << i;

                // Return to CPU Metrics without sending
                // any GIF selection or activation command.
                currentModeIndex = 0;

                QSettings settings(
                    "LionheartTim",
                    "DeepCoolDigitalGui"
                );
                settings.setValue("displayMode", 0);

                if (m_mode) {
                    QSignalBlocker blocker(m_mode);
                    m_mode->setCurrentIndex(0);
                }

                setStatus(
                    QString(
                        "GIF activation blocked: unresolved upload in slot %1."
                    ).arg(i + 1)
                );

                updatePreview();
                return;
            }


            // STEP 4C-8D — Validate all recorded GIF slots
            // before any GIF hardware activation.
            //
            // Reuse the existing metadata validator.
            // Do not modify local files or send USB commands.

            for (int i = 0; i < GIF_SLOT_COUNT; ++i) {

                const bool hasUploadFlag =
                QFile::exists(uploadFlagPath(i));

                const bool hasRecordedUpload =
                hasUploadFlag ||
                gifSlots[i].uploadedToHardware ||
                gifSlots[i].hardwareListIndex >= 0;

                if (!hasRecordedUpload) {
                    continue;
                }

                const bool recordValid =
                hasUploadFlag &&
                gifSlots[i].uploadedToHardware &&
                !gifSlots[i].path.isEmpty() &&
                uploadedGifMetadataMatches(
                    i,
                    gifSlots[i].hardwareListIndex
                );

                if (recordValid) {
                    continue;
                }

                qCritical()
                << "[GIF-SAFETY] GIF activation blocked."
                << "Inconsistent stored record in slot:" << i;

                // Return the GUI to CPU Metrics.
                // No GIF selection or activation is sent.

                currentModeIndex = 0;

                QSettings settings(
                    "LionheartTim",
                    "DeepCoolDigitalGui"
                );

                settings.setValue("displayMode", 0);

                if (m_mode) {
                    QSignalBlocker blocker(m_mode);
                    m_mode->setCurrentIndex(0);
                }

                if (m_gifSwitch) {
                    QSignalBlocker blocker(m_gifSwitch);
                    m_gifSwitch->setChecked(false);
                }

                setStatus(
                    QString(
                        "GIF activation blocked: inconsistent metadata in slot %1."
                    ).arg(i + 1)
                );

                updatePreview();
                return;
            }


            if (gifDeleteJournalPending()) {
                return; // Never activate a hardware GIF during local recovery.
            }

            // STEP 4C-14C-5B
            // Block automatic GIF timer activity while a hardware
            // delete has an unresolved completion state.
            // This protects both GIF mode activation paths.

            for (int i = 0; i < GIF_SLOT_COUNT; ++i) {
                if (QFile::exists(deleteUncertainFlagPath(i))) {
                    return;
                }
            }

            // Validate the selected local GIF slot.
            const int slot = lastSelectedGifSlot;

            if (slot < 0 || slot >= GIF_SLOT_COUNT) {
                return;
            }



            // Empty GUI slot with other stored GIFs: no proven USB
            // command exists to display the firmware's empty-list screen.
            // Do not send an invalid 0x08 index or mode toggle here.
            if (gifSlots[slot].path.isEmpty()) {
                bool storedGifExists = false;
                for (const auto& item : gifSlots) {
                    if (item.uploadedToHardware) {
                        storedGifExists = true;
                        break;
                    }
                }
                if (storedGifExists) {
                    // Force a fresh proven 0x08 selection when returning
                    // to any filled slot, even the one already on the TFT.
                    lastSlot = -1;
                    return;
                }
                if (lastMode != 2 || lastSlot != slot) {

                    const bool modeOk =
                    globalDevice->setDisplayMode(MODE_GIF_STREAM);

                    qWarning().noquote()
                    << "[GIF-WAIT] Modusaanvraag:"
                    << (modeOk ? "SUCCESS" : "FAILURE")
                    << "| slot=" << slot;

                    // STEP 4C-8E
                    // Never confirm a failed GIF mode switch.
                    // Prevent automatic mode retries.

                    if (!modeOk) {
                        qCritical()
                        << "[GIF-SAFETY] GIF mode activation failed."
                        << "Slot:" << slot;

                        currentModeIndex = 0;


                        QSettings settings(
                            "LionheartTim",
                            "DeepCoolDigitalGui"
                        );

                        settings.setValue("displayMode", 0);

                        if (m_mode) {
                            QSignalBlocker blocker(m_mode);
                            m_mode->setCurrentIndex(0);
                        }

                        if (m_gifSwitch) {
                            QSignalBlocker blocker(m_gifSwitch);
                            m_gifSwitch->setChecked(false);
                        }

                        setStatus(
                            "GIF mode activation failed; returning to CPU Metrics."
                        );

                        updatePreview();
                        return;
                    }


                    // Update only after a validated mode ACK.
                    lastMode = 2;
                    lastSlot = slot;
                }


                // Windows blijft status 0x10 en display 0x01
                // pollen zolang GIF Stream actief is.
                const bool heartbeatOk =
                globalDevice->updateDisplay(currentData);

                qDebug()
                << "[GIF-WAIT] EP02 heartbeat (0x10 + 0x01):"
                << (heartbeatOk ? "OK" : "FAIL");

                return;
            }

            const bool cropDone =
            QFile::exists(cropFlagPath(slot));

            const bool uploadDone =
            QFile::exists(uploadFlagPath(slot));


            const bool pendingUpload =
            cropDone &&
            !uploadDone &&
            !QFile::exists(uploadUncertainFlagPath(slot));


            if (lastMode != 2 ||
                lastSlot != slot ||
                pendingUpload) {

                logDebug(
                    "UPLOAD",
                    QString("Slot %1: cropDone=%2, uploadDone=%3")
                    .arg(slot)
                    .arg(cropDone ? "ja" : "nee")
                    .arg(uploadDone ? "ja" : "nee")
                );

            if (pendingUpload) {
                logDebug(
                    "UPLOAD",
                    QString("Slot %1: crop klaar; upload starten.")
                    .arg(slot)
                );

                startGifUploadAsync(slot);
                return;
            }

            if (cropDone && uploadDone) {
                if (justUploadedSlot == slot) {
                    justUploadedSlot = -1;

                    qWarning().noquote()
                    << "[GIF-WAIT] Upload is al gecommit en geactiveerd;"
                    << "geen tweede modusopdracht."
                    << "| slot=" << slot;

                    lastMode = 2;
                    lastSlot = slot;
                    return;
                }

                // MYSTIQUE-TFT-GIF-ACTIVATION-V2
                // Existing GIF: 0x03 selects mode; 0x08 selects the list
                // index (TEST4). Never substitute a mode switch for a
                // hardware-index selection.
                const int hardwareIndex = gifSlots[slot].hardwareListIndex;
                if (hardwareIndex < 0 || hardwareIndex >= GIF_SLOT_COUNT) {
                    qCritical() << "[GIF-SELECT] Ongeldige hardware-index:"
                                << hardwareIndex << "slot" << slot;
                    setStatus("GIF activation blocked: invalid hardware index.");
                    return;
                }
                qWarning() << "[GIF-SELECT] Bestaande GIF activeren:"
                           << "local slot" << slot
                           << "hardware index" << hardwareIndex;

                // Only change hardware mode when coming from Metrics.
                const bool modeOk = (lastMode == 2) ||
                    globalDevice->setDisplayMode(MODE_GIF_STREAM);
                const bool selectOk = modeOk &&
                    globalDevice->selectGifHardwareSlot(hardwareIndex);

                qWarning() << "[GIF-SELECT] Mode OK:" << modeOk
                           << "Selection ACK OK:" << selectOk
                           << "Index:" << hardwareIndex;

                if (!modeOk || !selectOk) {
                    qCritical()
                    << "[GIF-SAFETY] Existing GIF mode/selection failed."
                    << "Slot:" << slot;

                    currentModeIndex = 0;

                    QSettings settings(
                        "LionheartTim",
                        "DeepCoolDigitalGui"
                    );
                    settings.setValue("displayMode", 0);

                    if (m_mode) {
                        QSignalBlocker blocker(m_mode);
                        m_mode->setCurrentIndex(0);
                    }

                    if (m_gifSwitch) {
                        QSignalBlocker blocker(m_gifSwitch);
                        m_gifSwitch->setChecked(false);
                    }

                    setStatus(
                        "GIF selection or mode activation failed; CPU mode selected."
                    );
                    updatePreview();
                    return;
                }

                lastMode = 2;
                lastSlot = slot;
                m_previewWaitingForGifAck = false;
                updatePreview();
                return;
            }


            logDebug(
                "UPLOAD",
                "crop_complete.flag ontbreekt; wachten."
            );
            return;
                }

                // Buiten de echte upload blijven status en display
                // periodiek actief, overeenkomstig de Windows-capture.
                const bool gifHeartbeatOk =
                globalDevice->updateDisplay(currentData);

                qDebug()
                << "[GIF-WAIT] EP02 heartbeat (0x10 + 0x01):"
                << (gifHeartbeatOk ? "OK" : "FAIL");
        }
    }

    // GUI-only TFT status screen. No USB data is transferred here.
    void drawGifPreviewMessage(const QString& message)
    {
        if (!m_preview) return;
        updateRgbVisualPreview(nullptr);
        const bool portrait = currentRotationIndex == 0 ||
                              currentRotationIndex == 2;
        const int W = portrait ? 480 : 640;
        const int H = portrait ? 640 : 480;
        QImage frame(W, H, QImage::Format_RGB32);
        frame.fill(Qt::black);
        QPainter painter(&frame);
        painter.setRenderHint(QPainter::Antialiasing);
        painter.setRenderHint(QPainter::TextAntialiasing);
        painter.setPen(QColor(245, 248, 250));
        QFont font("Sans");
        font.setPixelSize(portrait ? 40 : 44);
        painter.setFont(font);
        painter.drawText(QRect(28, 30, W - 56, H - 60),
                         Qt::AlignCenter | Qt::TextWordWrap, message);
        painter.end();
        m_preview->setPixmap(QPixmap::fromImage(
            frame.scaled(m_preview->size() - QSize(10, 10),
                         Qt::KeepAspectRatio, Qt::SmoothTransformation)));
    }

    void updatePreview()
    {
        const int slot = lastSelectedGifSlot;
        const bool showGif = m_gifSwitch->isChecked() ||
                             currentModeIndex == 2;

        // GUI STEP 3: render real app phases, not a fake progress timer.
        if (m_gifPreparationActive || m_uploadRunning) {
            if (showGif) drawGifPreviewMessage("Loading");
            return;
        }
        if (showGif && m_previewWaitingForGifAck) {
            drawGifPreviewMessage("Loading");
            return;
        }
        if (showGif && slot >= 0 && slot < GIF_SLOT_COUNT &&
            gifSlots[slot].path.isEmpty()) {
            drawGifPreviewMessage("Please upload GIF");
            return;
        }

        // Existing GIF/CPU/GPU rendering follows unchanged.

        if (showGif &&
            slot >= 0 &&
            slot < GIF_SLOT_COUNT &&
            !gifSlots[slot].path.isEmpty()) {

            // Zorg dat de cache geladen is
            if (!gifSlots[slot].framesLoaded) {
                loadFramesToCache(slot);
            }

            if (gifSlots[slot].cachedFrames.isEmpty()) {
                drawGifPreviewMessage("Loading");
                return;
            }
            if (!gifSlots[slot].cachedFrames.isEmpty()) {
                const int frameIdx = gifSlots[slot].currentFrame
                % gifSlots[slot].cachedFrames.size();
                const QImage frame = gifFrameForPreview(
                    slot, gifSlots[slot].cachedFrames[frameIdx]);
                updateRgbVisualPreview(&frame);

                m_preview->setPixmap(
                    QPixmap::fromImage(
                        frame.scaled(m_preview->size() - QSize(10,10),
                                     Qt::KeepAspectRatio,
                                     Qt::SmoothTransformation)
                    )
                );
            }

            return;
            }

            // ============================================================
            // HARDWARE PREVIEW
            // ============================================================
            const bool gpuMode = (currentModeIndex == 1);

            const bool portrait = (currentRotationIndex == 0 ||
            currentRotationIndex == 2);

            const int W = portrait ? 480 : 640;
            const int H = portrait ? 640 : 480;

            QImage img(W, H, QImage::Format_RGB32);
            img.fill(Qt::black);

            // TFT BACKGROUND / DEEPCOOL TYPOGRAPHY: visual-only v1
            // De originele TFT-achtergrond blijft onder de live Metrics.
            // GIF-beelden blijven volledig ongewijzigd (geen overlay op GIFs).
            static const QImage tftBackground(
                QApplication::applicationDirPath() + "/tft-background.png");
            if (!tftBackground.isNull()) {
                QPainter backgroundPainter(&img);
                if (portrait) {
                    static const QImage portraitBackground =
                        tftBackground.transformed(QTransform().rotate(90),
                                                  Qt::SmoothTransformation);
                    backgroundPainter.drawImage(QRect(0, 0, W, H),
                                                portraitBackground);
                } else {
                    backgroundPainter.drawImage(QRect(0, 0, W, H),
                                                tftBackground);
                }
            }

            QPainter p(&img);
            p.setRenderHint(QPainter::Antialiasing);
            p.setRenderHint(QPainter::TextAntialiasing);

            const float temperature = gpuMode ? currentData.gpuTemp : currentData.cpuTemp;
            const float frequencyGHz = gpuMode
            ? currentData.gpuFrequency / 1000.0f
            : liveCpuMHz / 1000.0f;
            const float usage = gpuMode ? currentData.gpuUsage : currentData.cpuUsage;
            const float ram =
            (gpuMode && currentData.vramUsage >= 0.0f)
            ? currentData.vramUsage
            : currentData.ramUsage;

            const QString title = gpuMode ? "GPU TEMPERATURE" : "CPU TEMPERATURE";
            const QString tempStr = QString::number(temperature, 'f', 0);
            const QString unitStr = "°C";

            // Visuele referentie: originele AIO-preview afbeelding.
            // Zelfde licht-turquoise tint, rustige sans-typografie en positie.
            // Live CPU/GPU-metingen en hun berekening blijven onveranderd.
            const QColor accent(151, 225, 216);
            const QColor white(255, 255, 255);
            const QString screenFont = "Noto Sans";

            if (portrait) {
                p.setPen(accent);
                p.setFont(QFont(screenFont, 23, QFont::DemiBold));
                p.drawText(QRect(18, 65, W - 36, 45),
                           Qt::AlignCenter, title);

                p.setPen(white);
                QFont bigTemp(screenFont, 135, QFont::Normal);
                bigTemp.setLetterSpacing(QFont::AbsoluteSpacing, -3.0);
                p.setFont(bigTemp);
                const int textWidth = p.fontMetrics().horizontalAdvance(tempStr);
                const int startX = (W - textWidth - 60) / 2;
                p.drawText(QRect(startX, 195, textWidth + 10, 195),
                           Qt::AlignLeft | Qt::AlignVCenter, tempStr);
                p.setFont(QFont(screenFont, 22, QFont::Normal));
                p.drawText(QRect(startX + textWidth + 8, 216, 60, 52),
                           Qt::AlignLeft | Qt::AlignVCenter, unitStr);

                const int rowY = 465;
                const int colWidth = W / 3;
                auto drawValue = [&](int col, const QString& value,
                                     const QString& suffix) {
                    const int x = col * colWidth;
                    p.setPen(accent);
                    p.setFont(QFont(screenFont, 26, QFont::Normal));
                    p.drawText(QRect(x, rowY, colWidth, 48),
                               Qt::AlignCenter, value);
                    p.setFont(QFont(screenFont, 14, QFont::Normal));
                    p.drawText(QRect(x, rowY + 47, colWidth, 29),
                               Qt::AlignCenter, suffix);
                };
                drawValue(0, QString::number(frequencyGHz, 'f', 2), "GHz");
                drawValue(1, QString::number(usage, 'f', 0), "%");
                drawValue(2, QString::number(ram, 'f', 0), "%");
            } else {
                // Liggende stand: positie ontleend aan de AIO-foto:
                // titel links, grote witte temperatuur, drie turquoise waarden rechts.
                p.setPen(accent);
                p.setFont(QFont(screenFont, 23, QFont::DemiBold));
                p.drawText(QRect(66, 104, 340, 42),
                           Qt::AlignLeft | Qt::AlignVCenter, title);

                p.setPen(white);
                QFont bigTemp(screenFont, 134, QFont::Normal);
                bigTemp.setLetterSpacing(QFont::AbsoluteSpacing, -3.0);
                p.setFont(bigTemp);
                const int textWidth = p.fontMetrics().horizontalAdvance(tempStr);
                const int startX = 97;
                p.drawText(QRect(startX, 165, textWidth + 10, 185),
                           Qt::AlignLeft | Qt::AlignVCenter, tempStr);
                p.setFont(QFont(screenFont, 22, QFont::Normal));
                p.drawText(QRect(startX + textWidth + 5, 182, 68, 50),
                           Qt::AlignLeft | Qt::AlignVCenter, unitStr);

                auto drawRightValue = [&](int row, const QString& value,
                                          const QString& suffix) {
                    const int y = 56 + row * 122;
                    p.setPen(accent);
                    p.setFont(QFont(screenFont, 46, QFont::Normal));
                    p.drawText(QRect(427, y, 180, 70),
                               Qt::AlignLeft | Qt::AlignVCenter, value);
                    p.setFont(QFont(screenFont, 16, QFont::Normal));
                    p.drawText(QRect(440, y + 67, 166, 30),
                               Qt::AlignLeft | Qt::AlignVCenter, suffix);
                };
                drawRightValue(0, QString::number(frequencyGHz, 'f', 2), "GHz");
                drawRightValue(1, QString::number(usage, 'f', 0), "%");
                drawRightValue(2, QString::number(ram, 'f', 0), "%");
            }

            p.end();
            updateRgbVisualPreview(nullptr);

            m_preview->setPixmap(
                QPixmap::fromImage(
                    img.scaled(m_preview->size() - QSize(10,10),
                               Qt::KeepAspectRatio,
                               Qt::SmoothTransformation)
                )
            );
    }
};


int main(int argc,char** argv)
{
    QApplication app(argc,argv);
    QApplication::setApplicationName("DeepCoolDigitalGui");
    QApplication::setOrganizationName("LionheartTim");

    // MYSTIQUE KDE ICON ALIGNMENT v1
    // Match the app's Wayland desktop ID to its installed .desktop file.
    // Keep QSettings organization / application keys unchanged.
    app.setDesktopFileName("io.github.lionhearttim.deepcool-gui");
    const QIcon deepCoolIcon = QIcon::fromTheme(
        "io.github.lionhearttim.deepcool-gui",
        QIcon(QDir::homePath() +
              "/.local/share/icons/hicolor/256x256/apps/"
              "io.github.lionhearttim.deepcool-gui.png"));
    app.setWindowIcon(deepCoolIcon);

    // 🚀 SYSTEEMVAK: Voorkom dat de app afsluit wanneer het venster wordt gesloten
    app.setQuitOnLastWindowClosed(false);

    MainWindow w;
    w.setWindowIcon(deepCoolIcon); // Use same icon for the visible window.

    // 🚀 SYSTEEMVAK: Verberg het venster direct als --minimized is meegegeven
    if (argc > 1 && QString(argv[1]) == "--minimized") {
        w.hide();
    } else {
        w.show();
    }

    return app.exec();
}
