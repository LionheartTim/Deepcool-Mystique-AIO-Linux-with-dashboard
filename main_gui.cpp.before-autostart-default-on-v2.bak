// MYSTIQUE KDE AUTOSTART IN APP v1
// Manages only this app's per-user KDE autostart .desktop entry.
// Flatpak is started through the HOST's flatpak command, not an /app/bin path.
namespace MystiqueAutoStart {
static const QString appId = QStringLiteral("io.github.lionhearttim.deepcool-gui");

static QString filePath()
{
    return QDir::homePath() + QStringLiteral(
        "/.config/autostart/io.github.lionhearttim.deepcool-gui.desktop");
}

static QString execCommand()
{
    if (QFile::exists(QStringLiteral("/.flatpak-info")) ||
        qEnvironmentVariableIsSet("FLATPAK_ID")) {
        return QStringLiteral(
            "flatpak run io.github.lionhearttim.deepcool-gui --minimized");
    }
    // Desktop Entry Exec quoting, for native (non-Flatpak) Qt6 builds.
    QString path = QCoreApplication::applicationFilePath();
    path.replace(QStringLiteral("\\"), QStringLiteral("\\\\"));
    path.replace(QStringLiteral("\""), QStringLiteral("\\\""));
    path.replace(QStringLiteral("$"), QStringLiteral("\\$"));
    path.replace(QStringLiteral("`"), QStringLiteral("\\`"));
    return QStringLiteral("\"") + path + QStringLiteral("\" --minimized");
}

static QString existingExec(const QByteArray& contents)
{
    for (const QString& line : QString::fromUtf8(contents).split('\n')) {
        if (line.startsWith(QStringLiteral("Exec=")))
            return line.mid(5).trimmed();
    }
    return {};
}

static bool isOurs(const QByteArray& contents)
{
    if (!contents.contains("[Desktop Entry]")) return false;
    const QString command = existingExec(contents);
    // Managed entry, or previously installed DeepCool KDE autostart.
    return contents.contains("X-MystiqueManagedAutostart=1") ||
        command == execCommand() ||
        command == QStringLiteral("flatpak run io.github.lionhearttim.deepcool-gui") ||
        command == QStringLiteral("flatpak run io.github.lionhearttim.deepcool-gui --minimized") ||
        command == QStringLiteral("flatpak run --user io.github.lionhearttim.deepcool-gui --minimized");
}

static bool enabled()
{
    QFile file(filePath());
    if (!file.open(QIODevice::ReadOnly)) return false;
    const QByteArray contents = file.readAll();
    if (!isOurs(contents)) return false;
    const QString text = QString::fromUtf8(contents);
    for (const QString& line : text.split('\n')) {
        const QString trimmed = line.trimmed();
        if (trimmed == QStringLiteral("Hidden=true") ||
            trimmed == QStringLiteral("X-GNOME-Autostart-enabled=false"))
            return false;
    }
    return true;
}

static bool change(bool enable, QString& error)
{
    const QString path = filePath();
    const QFileInfo info(path);
    if (info.isSymLink()) {
        error = QStringLiteral("Autostart entry is a symbolic link. Not modified.");
        return false;
    }
    if (info.exists()) {
        QFile existing(path);
        if (!existing.open(QIODevice::ReadOnly)) {
            error = QStringLiteral("Cannot read existing KDE autostart entry.");
            return false;
        }
        if (!isOurs(existing.readAll())) {
            error = QStringLiteral("Existing autostart entry was not created for this app. Not overwritten.");
            return false;
        }
        existing.close();
    }
    if (!enable) {
        if (!info.exists()) return true;
        if (QFile::remove(path)) return true;
        error = QStringLiteral("Could not remove the autostart entry.");
        return false;
    }

    if (!QDir().mkpath(QFileInfo(path).absolutePath())) {
        error = QStringLiteral("Could not create ~/.config/autostart.");
        return false;
    }
    const QString desktop = QStringLiteral(
        "[Desktop Entry]\n"
        "Type=Application\n"
        "Name=DeepCool MYSTIQUE Control Hub\n"
        "Comment=Start DeepCool MYSTIQUE Control Hub at login\n"
        "Exec=") + execCommand() + QStringLiteral(
        "\nIcon=io.github.lionhearttim.deepcool-gui\n"
        "Terminal=false\n"
        "X-GNOME-Autostart-enabled=true\n"
        "X-KDE-autostart-after=panel\n"
        "X-MystiqueManagedAutostart=1\n");
    QSaveFile output(path);
    if (!output.open(QIODevice::WriteOnly | QIODevice::Text)) {
        error = QStringLiteral("Cannot create the KDE autostart entry.");
        return false;
    }
    if (output.write(desktop.toUtf8()) != desktop.toUtf8().size() ||
        !output.commit()) {
        error = QStringLiteral("Could not save the KDE autostart entry.");
        return false;
    }
    return true;
}
} // namespace MystiqueAutoStart


